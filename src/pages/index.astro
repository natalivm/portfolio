---
import Layout from '../layouts/Layout.astro';
import Tile from '../components/Tile.astro';
import ProtoTile from '../components/ProtoTile.astro';
import BeatSaberLogo from '../components/BeatSaberLogo.astro';
import LawsTile from '../components/LawsTile.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { projects, featured as allFeatured } from '../data/projects';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const showcase = projects.find((p) => p.prototype);
const featured = allFeatured.filter((p) => p !== showcase).slice(0, showcase ? 4 : 6);
const years = projects.map((p) => p.year);
---

<Layout current="home">
  <section class="hero wrap" aria-labelledby="hero-title">
    <h1 id="hero-title" class="display">
      {site.headline[0]}
      <span class="quiet">{site.headline[1]}</span>
    </h1>
    <div class="hero-foot">
      <p class="intro">{site.intro}</p>
      <div class="hero-actions">
        <a class="pill pill-dark" href={`${base}/work/`} data-work-link>
          See all {projects.length} projects
          <span class="arrow"><Icon name="arrow-right" size={14} /></span>
        </a>
        {site.available && (
          <p class="avail"><span class="dot" aria-hidden="true"></span>{site.availability}</p>
        )}
      </div>
    </div>
  </section>

  <section class="featured wrap" aria-labelledby="featured-title">
    <div class="section-head">
      <h2 id="featured-title" class="h2">Selected work</h2>
      <p class="section-note">{featured.length + (showcase ? 1 : 0)} of {projects.length} projects, {Math.min(...years)}–{Math.max(...years)}</p>
    </div>
    <ul class="feat-grid" role="list">
      {featured.slice(0, 2).map((p) => (
        <li class="big">
          <Tile project={p} eager size="large" />
        </li>
      ))}
      {showcase && (
        <li class="proto">
          <ProtoTile project={showcase} />
        </li>
      )}
      {featured.slice(2).map((p) => (
        <li>
          <Tile project={p} />
        </li>
      ))}
      <li class="all">
        <a class="bs-tile" href={`${base}/work/beat-saber/`} aria-label="Beat Saber: the case study" data-neon>
          <BeatSaberLogo class="bs-logo" />
          <span class="bs-go" aria-hidden="true"><Icon name="arrow-right" size={14} /></span>
        </a>
      </li>
      <li class="laws">
        <LawsTile />
      </li>
    </ul>
  </section>

  <section class="about wrap" id="about" aria-labelledby="about-title">
    <h2 id="about-title" class="h2">
      About
      <span class="quiet">{site.name}.</span>
    </h2>
    <div class="about-body">
      <p class="help-lead">I can help you with</p>
      <ul class="help" role="list">
        {site.services.map((s) => (
          <li>
            <h3>{s.name}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="contact wrap" aria-labelledby="contact-title">
    <h2 id="contact-title" class="display">
      Have a project in mind?
      <span class="quiet">Let’s talk.</span>
    </h2>
    <div class="contact-actions">
      <button class="pill pill-dark" type="button" data-mail="open">
        Email me
        <span class="arrow"><Icon name="arrow-right" size={14} /></span>
      </button>
      <button class="pill pill-light" type="button" data-mail="copy">
        <span data-mail-label>Copy email address</span>
      </button>
    </div>
    <noscript><p class="contact-note">These buttons need JavaScript. You can also reach me on LinkedIn, linked below.</p></noscript>
  </section>
</Layout>

<style>
  .hero {
    padding-block: clamp(40px, 6vw, 72px) clamp(40px, 5vw, 64px);
  }
  .hero .display {
    max-width: 21ch;
    font-size: clamp(2.4rem, 5vw, 4.5rem);
  }
  .hero-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px 48px;
    margin-top: clamp(24px, 3vw, 36px);
  }
  .intro {
    max-width: 52ch;
    color: var(--ink-2);
    font-size: clamp(1.0625rem, 1.3vw, 1.1875rem);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
  }
  .avail {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }
  .dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #1f9d55;
  }
  .dot::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 2px solid #1f9d55;
    opacity: 0;
    animation: ping 2.4s var(--ease-out) infinite;
  }
  @keyframes ping {
    0% { transform: scale(0.6); opacity: 0.7; }
    80%, 100% { transform: scale(1.6); opacity: 0; }
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 24px;
    margin-bottom: clamp(20px, 3vw, 32px);
  }
  .section-note {
    color: var(--ink-2);
  }

  .feat-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: clamp(12px, 1.6vw, 20px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .feat-grid > li {
    grid-column: span 4;
  }
  .feat-grid > li.big {
    grid-column: span 6;
  }
  .feat-grid > li.all {
    grid-column: span 8;
  }
  /* UX laws: a full row at every width, so the project rows above stay whole */
  .feat-grid > li.laws {
    grid-column: 1 / -1;
  }
  /* The prototype tile: one column wide, two rows tall */
  .feat-grid > li.proto {
    grid-row: span 2;
  }
  /* Beat Saber: the neon logo on black, a red glow above and a blue one below, as in the game */
  .bs-tile {
    position: relative;
    display: grid;
    place-items: center;
    height: 100%;
    min-height: 260px;
    padding: clamp(20px, 3vw, 36px);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(70% 70% at 50% 8%, rgb(122 6 16 / 0.85), transparent 70%),
      radial-gradient(70% 70% at 50% 100%, rgb(6 42 110 / 0.8), transparent 70%),
      #07070b;
    text-decoration: none;
    overflow: hidden;
    transition: transform var(--t-med) var(--ease-out), box-shadow var(--t-med) var(--ease-out);
  }
  .bs-tile :global(.bs-logo) {
    display: block;
    width: min(62%, 420px); /* room on either side */
    height: auto;
    overflow: visible;
    transition: filter var(--t-med) var(--ease-out);
  }
  .bs-go {
    position: absolute;
    right: 20px;
    bottom: 20px;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: #fff;
    color: #07070b;
    transition: transform var(--t-med) var(--ease-out);
  }
  /* the sign switches on when it comes into view: BEAT first, then SABER, with a neon stutter */
  [data-neon][data-armed]:not(.done) :global(.bs-beat),
  [data-neon][data-armed]:not(.done) :global(.bs-saber) {
    opacity: 0.08;
  }
  [data-neon].lit:not(.done) :global(.bs-beat) {
    animation: neon-on 900ms linear 150ms both;
  }
  [data-neon].lit:not(.done) :global(.bs-saber) {
    animation: neon-on 900ms linear 480ms both;
  }
  @keyframes neon-on {
    0% { opacity: 0.08; }
    10% { opacity: 1; }
    16% { opacity: 0.2; }
    24% { opacity: 0.9; }
    30% { opacity: 0.35; }
    46%, 100% { opacity: 1; }
  }
  @media (hover: hover) {
    .bs-tile:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-lift);
    }
    .bs-tile:hover :global(.bs-logo) {
      filter: brightness(1.18) saturate(1.1);
    }
    /* a little buzz in SABER while pointed at, once the sign is on */
    .bs-tile.done:hover :global(.bs-saber) {
      animation: neon-buzz 2.4s linear infinite;
    }
    .bs-tile:hover .bs-go {
      transform: translateX(3px);
    }
  }
  @keyframes neon-buzz {
    0%, 62%, 66%, 70%, 100% { opacity: 1; }
    64% { opacity: 0.45; }
    68% { opacity: 0.7; }
  }

  .about {
    margin-top: clamp(96px, 11vw, 152px);
  }
  .about {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 32px clamp(32px, 6vw, 96px);
  }
  .about-body {
    display: grid;
    gap: 14px;
  }
  .help-lead {
    color: var(--ink-2);
  }
  /* What I can help with: a name and one sentence each, on hairline rules */
  .help {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .help li {
    display: grid;
    grid-template-columns: minmax(8.5rem, 0.7fr) minmax(0, 2fr);
    align-items: baseline;
    gap: 6px 24px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }
  .help h3 {
    font-size: clamp(1.125rem, 1.6vw, 1.375rem);
    letter-spacing: -0.025em;
    line-height: 1.15;
  }
  .help p {
    max-width: 52ch;
    font-size: 1.0625rem;
  }
  @media (max-width: 560px) {
    .help li {
      grid-template-columns: 1fr;
    }
  }

  .contact {
    margin-top: clamp(112px, 13vw, 176px);
  }
  .contact .display {
    font-size: clamp(2.4rem, 5.6vw, 4.8rem);
  }
  .contact-note {
    margin-top: 16px;
    color: var(--ink-2);
  }
  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  @media (max-width: 960px) {
    .feat-grid > li,
    .feat-grid > li.big {
      grid-column: span 6;
    }
    .feat-grid > li.all {
      grid-column: span 12;
    }
    .about {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .feat-grid > li,
    .feat-grid > li.big {
      grid-column: span 6;
    }
    .feat-grid > li.proto {
      grid-column: span 12;
      grid-row: auto;
    }
    .feat-grid :global(.tile) {
      padding: 5px;
      border-radius: var(--radius-md);
    }
    .feat-grid :global(.frame) {
      border-radius: 15px;
    }
    .feat-grid :global(.text) {
      padding: 10px 6px 6px;
    }
    .feat-grid :global(.title) {
      font-size: 0.9375rem;
    }
    .feat-grid :global(.meta) {
      font-size: 0.75rem;
      flex-direction: column;
      gap: 0;
    }
    .bs-tile {
      min-height: 220px;
    }
    /* leave the arrow its corner */
    .bs-tile :global(.bs-logo) {
      width: 70%;
    }
  }
</style>

<script>
  // The neon sign switches on the first time it comes into view, then stays on
  const sign = document.querySelector<HTMLElement>('[data-neon]');
  if (sign && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    sign.setAttribute('data-armed', '');
    sign.addEventListener('animationend', (e) => {
      if (e.animationName.includes('neon-on') && (e.target as Element).classList.contains('bs-saber')) sign.classList.add('done');
    });
    const io = new IntersectionObserver((es) => {
      if (!es.some((e) => e.isIntersecting)) return;
      io.disconnect();
      sign.classList.add('lit');
    }, { threshold: 0.4 });
    io.observe(sign);
  }
</script>
