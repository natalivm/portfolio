---
import Layout from '../layouts/Layout.astro';
import Tile from '../components/Tile.astro';
import ProtoTile from '../components/ProtoTile.astro';
import Cover from '../components/Cover.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { projects, featured as allFeatured } from '../data/projects';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const showcase = projects.find((p) => p.prototype);
const featured = allFeatured.filter((p) => p !== showcase).slice(0, showcase ? 4 : 6);
const rest = projects.filter((p) => !p.featured);
const years = projects.map((p) => p.year);
---

<Layout current="home">
  <section class="hero wrap" aria-labelledby="hero-title">
    <h1 id="hero-title" class="display">
      {site.headline[0]}
      <span class="quiet">{site.headline[1]}</span>
    </h1>
    <div class="hero-foot">
      <p class="intro">{site.intro}</p>
      <div class="hero-actions">
        <a class="pill pill-dark" href={`${base}/work/`} data-work-link>
          See all {projects.length} projects
          <span class="arrow"><Icon name="arrow-right" size={14} /></span>
        </a>
        {site.available && (
          <p class="avail"><span class="dot" aria-hidden="true"></span>{site.availability}</p>
        )}
      </div>
    </div>
  </section>

  <section class="featured wrap" aria-labelledby="featured-title">
    <div class="section-head">
      <h2 id="featured-title" class="h2">Selected work</h2>
      <p class="section-note">{featured.length + (showcase ? 1 : 0)} of {projects.length} projects, {Math.min(...years)}–{Math.max(...years)}</p>
    </div>
    <ul class="feat-grid" role="list">
      {featured.slice(0, 2).map((p) => (
        <li class="big">
          <Tile project={p} eager size="large" />
        </li>
      ))}
      {showcase && (
        <li class="proto">
          <ProtoTile project={showcase} />
        </li>
      )}
      {featured.slice(2).map((p) => (
        <li>
          <Tile project={p} />
        </li>
      ))}
      <li class="all">
        <a class="all-tile" href={`${base}/work/`} data-work-link>
          <div class="sheet" aria-hidden="true">
            {rest.slice(0, 18).map((p) => (
              <div class="thumb"><Cover project={p} ratio="1/1" /></div>
            ))}
          </div>
          <div class="all-text">
            <p class="all-num">{projects.length}</p>
            <p class="all-label">
              View all projects
              <span class="arrow"><Icon name="arrow-right" size={14} /></span>
            </p>
          </div>
        </a>
      </li>
    </ul>
  </section>

  <section class="about wrap" id="about" aria-labelledby="about-title">
    <h2 id="about-title" class="h2">
      About
      <span class="quiet">{site.name}.</span>
    </h2>
    <div class="about-body">
      <p class="help-lead">I can help you with</p>
      <ul class="help" role="list">
        {site.services.map((s) => (
          <li>
            <h3>{s.name}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="contact wrap" aria-labelledby="contact-title">
    <h2 id="contact-title" class="display">
      Have a project in mind?
      <span class="quiet">Let’s talk.</span>
    </h2>
    <div class="contact-actions">
      <button class="pill pill-dark" type="button" data-mail="open">
        Email me
        <span class="arrow"><Icon name="arrow-right" size={14} /></span>
      </button>
      <button class="pill pill-light" type="button" data-mail="copy">
        <span data-mail-label>Copy email address</span>
      </button>
    </div>
    <noscript><p class="contact-note">These buttons need JavaScript. You can also reach me on LinkedIn, linked below.</p></noscript>
  </section>
</Layout>

<style>
  .hero {
    padding-block: clamp(40px, 6vw, 72px) clamp(40px, 5vw, 64px);
  }
  .hero .display {
    max-width: 21ch;
    font-size: clamp(2.4rem, 5vw, 4.5rem);
  }
  .hero-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px 48px;
    margin-top: clamp(24px, 3vw, 36px);
  }
  .intro {
    max-width: 52ch;
    color: var(--ink-2);
    font-size: clamp(1.0625rem, 1.3vw, 1.1875rem);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
  }
  .avail {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }
  .dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #1f9d55;
  }
  .dot::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 2px solid #1f9d55;
    opacity: 0;
    animation: ping 2.4s var(--ease-out) infinite;
  }
  @keyframes ping {
    0% { transform: scale(0.6); opacity: 0.7; }
    80%, 100% { transform: scale(1.6); opacity: 0; }
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 24px;
    margin-bottom: clamp(20px, 3vw, 32px);
  }
  .section-note {
    color: var(--ink-2);
  }

  .feat-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: clamp(12px, 1.6vw, 20px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .feat-grid > li {
    grid-column: span 4;
  }
  .feat-grid > li.big {
    grid-column: span 6;
  }
  .feat-grid > li.all {
    grid-column: span 8;
  }
  /* The prototype tile: one column wide, two rows tall */
  .feat-grid > li.proto {
    grid-row: span 2;
  }
  .all-tile {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 24px;
    height: 100%;
    min-height: 260px;
    padding: 20px 28px 24px 20px;
    border-radius: var(--radius-lg);
    background: var(--btn-bg);
    color: var(--btn-ink);
    text-decoration: none;
    overflow: hidden;
    transition: transform var(--t-med) var(--ease-out), box-shadow var(--t-med) var(--ease-out);
  }
  .sheet {
    align-self: stretch;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 6px;
    align-content: start;
  }
  .thumb {
    border-radius: 8px;
    overflow: hidden;
    opacity: 0.88;
    transition: opacity var(--t-med) var(--ease-out), transform var(--t-med) var(--ease-out);
  }
  .all-text {
    text-align: right;
  }
  .all-num {
    font-family: var(--font-display);
    font-size: clamp(4rem, 9vw, 7.5rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 0.9;
  }
  .all-label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 10px;
    font-weight: 600;
  }
  .all-label .arrow {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--btn-ink);
    color: var(--btn-bg);
  }
  @media (hover: hover) {
    .all-tile:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-lift);
    }
    .all-tile:hover .thumb {
      opacity: 1;
    }
    .all-tile:hover .thumb:nth-child(3n) {
      transform: translateY(-3px);
    }
  }

  .about {
    margin-top: clamp(96px, 11vw, 152px);
  }
  .about {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 32px clamp(32px, 6vw, 96px);
  }
  .about-body {
    display: grid;
    gap: 14px;
  }
  .help-lead {
    color: var(--ink-2);
  }
  /* What I can help with: a name and one sentence each, on hairline rules */
  .help {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .help li {
    display: grid;
    grid-template-columns: minmax(8.5rem, 0.7fr) minmax(0, 2fr);
    align-items: baseline;
    gap: 6px 24px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }
  .help h3 {
    font-size: clamp(1.125rem, 1.6vw, 1.375rem);
    letter-spacing: -0.025em;
    line-height: 1.15;
  }
  .help p {
    max-width: 52ch;
    font-size: 1.0625rem;
  }
  @media (max-width: 560px) {
    .help li {
      grid-template-columns: 1fr;
    }
  }

  .contact {
    margin-top: clamp(112px, 13vw, 176px);
  }
  .contact .display {
    font-size: clamp(2.4rem, 5.6vw, 4.8rem);
  }
  .contact-note {
    margin-top: 16px;
    color: var(--ink-2);
  }
  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  @media (max-width: 960px) {
    .feat-grid > li,
    .feat-grid > li.big {
      grid-column: span 6;
    }
    .feat-grid > li.all {
      grid-column: span 12;
    }
    .about {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .feat-grid > li,
    .feat-grid > li.big {
      grid-column: span 6;
    }
    .feat-grid > li.proto {
      grid-column: span 12;
      grid-row: auto;
    }
    .feat-grid :global(.tile) {
      padding: 5px;
      border-radius: var(--radius-md);
    }
    .feat-grid :global(.frame) {
      border-radius: 15px;
    }
    .feat-grid :global(.text) {
      padding: 10px 6px 6px;
    }
    .feat-grid :global(.title) {
      font-size: 0.9375rem;
    }
    .feat-grid :global(.meta) {
      font-size: 0.75rem;
      flex-direction: column;
      gap: 0;
    }
    .all-tile {
      min-height: 0;
    }
    .sheet {
      grid-template-columns: repeat(9, 1fr);
      gap: 4px;
    }
    .all-tile {
      grid-template-columns: 1fr;
    }
    .all-text {
      text-align: left;
    }
  }
</style>
