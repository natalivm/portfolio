---
import Layout from '../../layouts/Layout.astro';
import Cover from '../../components/Cover.astro';
import Tile from '../../components/Tile.astro';
import Icon from '../../components/Icon.astro';
import NextGames from '../../components/cases/NextGames.astro';
import SortJourney from '../../components/cases/SortJourney.astro';
import RiverRace from '../../components/cases/RiverRace.astro';
import BalloonSprint from '../../components/cases/BalloonSprint.astro';
import BeatSaberLogo from '../../components/BeatSaberLogo.astro';
import SpaceField from '../../components/SpaceField.astro';
import { caseStudies, related, slugify, type Project } from '../../data/projects';

export function getStaticPaths() {
  return caseStudies.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project: p } = Astro.props as { project: Project };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const i = caseStudies.findIndex((c) => c.slug === p.slug);
const prev = caseStudies[(i - 1 + caseStudies.length) % caseStudies.length];
const next = caseStudies[(i + 1) % caseStudies.length];
const rel = related(p, 3);
const href = (x: Project) => (x.caseStudy ? `${base}/work/${x.slug}/` : `${base}/work/?p=${x.slug}`);
// Beat Saber opens in the game's own space: the neon logo at the top, no picture card
const space = p.theme === 'space';
---

<Layout title={p.title} description={p.summary} current="case" theme={p.theme}>
  <nav class="wrap crumbs" aria-label="Case studies">
    <a class="back" href={`${base}/work/`} data-back-to-work>
      <Icon name="arrow-left" size={16} /> All work
    </a>
    <div class="stepper">
      <span class="pos">Case study {i + 1} of {caseStudies.length}</span>
      <a class="round" href={href(prev)} rel="prev" aria-label={`Previous case study: ${prev.title}`} data-key-prev>
        <Icon name="arrow-left" />
      </a>
      <a class="round" href={href(next)} rel="next" aria-label={`Next case study: ${next.title}`} data-key-next>
        <Icon name="arrow-right" />
      </a>
    </div>
  </nav>

  {space && (
    <>
      <SpaceField />
      <div class="wrap stage" style="view-transition-name: hero-still">
        <BeatSaberLogo class="stage-logo" />
        <button class="reveal-btn" type="button" data-reveal>Reveal</button>
      </div>
      <canvas class="reveal-fx" aria-hidden="true"></canvas>
    </>
  )}

  <header class="wrap intro">
    <h1 class="display">
      {space ? <span class="visually-hidden">{p.title}</span> : p.title}
      <span class="quiet">{p.summary.replace(/^Sample project\.\s*/, '')}</span>
    </h1>
    <dl class="facts">
      <div><dt>Client</dt><dd>{p.client}</dd></div>
      <div><dt>Year</dt><dd>{p.year}</dd></div>
      {p.role && <div><dt>Role</dt><dd>{p.role}</dd></div>}
      <div>
        <dt>Discipline</dt>
        <dd>
          {p.disciplines.map((d, n) => (
            <>
              <a href={`${base}/work/?d=${slugify(d)}`}>{d}</a>{n < p.disciplines.length - 1 && ', '}
            </>
          ))}
        </dd>
      </div>
    </dl>
  </header>

  {p.prototype ? (
    <figure class="wrap hero">
      <div class="proto-frame" style="view-transition-name: hero-still">
        <iframe
          class="proto-desktop"
          src={`${base}${p.prototype}?demo=1`}
          title={`${p.title}: interactive prototype`}
        ></iframe>
        <iframe
          class="proto-mobile"
          src={`${base}${p.prototype}?embed=1&demo=1`}
          title={`${p.title}: interactive prototype`}
          loading="lazy"
        ></iframe>
      </div>
      <figcaption class="proto-cap">
        The walk-through plays on its own. Touch or click the phone to take over; it resumes when you stop.
        <a href={`${base}${p.prototype}`}>Open full screen</a>
      </figcaption>
    </figure>
  ) : space ? null : (
    <div class:list={['hero-row', p.theme === 'sky' && 'clip']}>
    <figure class="wrap hero">
      {p.theme === 'sky' && (
        <div class="hero-clouds" aria-hidden="true">
          <img class="c1" src={`${base}/cases/balloon-sprint/cloud.webp`} width="760" height="409" alt="" decoding="async" />
          <img class="c2" src={`${base}/cases/balloon-sprint/cloud.webp`} width="760" height="409" alt="" decoding="async" />
        </div>
      )}
      <div class="hero-frame" style="view-transition-name: hero-still">
        <Cover project={p} ratio="16/9" eager />
      </div>
    </figure>
    </div>
  )}

  {p.slug === 'next-games' ? (
    <NextGames />
  ) : p.slug === 'sort-journey' ? (
    <SortJourney project={p} />
  ) : p.slug === 'river-race' ? (
    <RiverRace project={p} />
  ) : p.slug === 'balloon-sprint' ? (
    <BalloonSprint project={p} />
  ) : (
  <article class="wrap story">
    <p class="sample">Sample case study. Replace this text with your own write-up.</p>
    <section>
      <h2>The brief</h2>
      <p>
        Two or three sentences on what the client needed and why. Who were they trying to reach, what
        was not working before, and what had to stay the same?
      </p>
    </section>
    <section>
      <h2>Approach</h2>
      <p>
        Explain the one or two decisions that shaped the work. Show the thinking: what you tried, what
        you dropped, and what made the final direction the right one for this client.
      </p>
    </section>
    <div class="gallery">
      {[
        { cls: 'g-wide', ratio: '16 / 9', label: 'Wide image: the work in use' },
        { cls: '', ratio: '1 / 1', label: 'Detail or process image' },
        { cls: '', ratio: '1 / 1', label: 'Detail or process image' },
      ].map((s) => (
        <div class:list={['slot', s.cls]} style={`aspect-ratio:${s.ratio}`}>
          <Icon name="image" size={28} />
          <span class="slot-label">{s.label}</span>
          <span class="slot-hint">Placeholder: add your image</span>
        </div>
      ))}
    </div>
    <section>
      <h2>Outcome</h2>
      <p>
        What happened after launch. Use only real results you can stand behind: a quote from the client,
        what shipped, where it lives now.
      </p>
    </section>
  </article>
  )}

  <nav class="wrap pager" aria-label="More case studies">
    <a class="pager-card" href={href(prev)} rel="prev">
      <span class="pager-dir"><Icon name="arrow-left" size={16} /> Previous</span>
      <span class="pager-title">{prev.title}</span>
    </a>
    <a class="pager-card next" href={href(next)} rel="next">
      <span class="pager-dir">Next <Icon name="arrow-right" size={16} /></span>
      <span class="pager-title">{next.title}</span>
    </a>
  </nav>

  <section class="wrap rel" aria-labelledby="rel-title">
    <div class="rel-head">
      <h2 id="rel-title" class="h2">Related work</h2>
      <a class="pill pill-light" href={`${base}/work/`} data-back-to-work>
        All work <span class="arrow"><Icon name="arrow-right" size={14} /></span>
      </a>
    </div>
    <ul class="rel-grid" role="list">
      {rel.map((r) => <li><Tile project={r} /></li>)}
    </ul>
  </section>
</Layout>

<script>
  // ← / → step through case studies when nothing else wants the keys.
  document.addEventListener('keydown', (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey || document.querySelector('dialog[open]')) return;
    if ((e.target as HTMLElement).closest('input, textarea, [contenteditable]')) return;
    const sel = e.key === 'ArrowLeft' ? '[data-key-prev]' : e.key === 'ArrowRight' ? '[data-key-next]' : '';
    const a = sel && document.querySelector<HTMLAnchorElement>(sel);
    if (a) location.href = a.href;
  });
</script>

<script>
  // Beat Saber opens veiled: the space, the logo and a Reveal button. The page does not scroll until
  // it is revealed. Pressing the button plays a plasma reveal, drawn by a fragment shader over the
  // whole window: a ring of energy charges round the button, bursts into rays, and a cloud of violet
  // smoke shot through with lightning rolls out to the edges, then thins from the middle to leave
  // the page standing there.
  const root = document.documentElement;
  const btn = document.querySelector<HTMLButtonElement>('[data-reveal]');
  const fx = document.querySelector<HTMLCanvasElement>('.reveal-fx');
  if (btn && fx && root.hasAttribute('data-veil')) {
    const FRAG = `
      precision highp float;
      uniform vec2 uRes;
      uniform vec2 uC;
      uniform float uT;
      uniform float uFar;
      float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
      float noise(vec2 p) {
        vec2 i = floor(p), f = fract(p);
        f = f * f * (3.0 - 2.0 * f);
        return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), f.x), mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), f.x), f.y);
      }
      float fbm(vec2 p) {
        float v = 0.0, a = 0.5;
        for (int i = 0; i < 5; i++) { v += a * noise(p); p = p * 2.03 + vec2(1.7, 9.2); a *= 0.5; }
        return v;
      }
      void main() {
        vec2 p = (gl_FragCoord.xy - uC) / uRes.y;
        float d = length(p);
        float ang = atan(p.y, p.x);
        float t = uT;

        // smoke: warped noise, flowing outward
        vec2 q = p * 3.0;
        vec2 w = vec2(fbm(q + vec2(0.0, t * 0.35)), fbm(q + vec2(5.2, -t * 0.3)));
        float n = fbm(q * 1.2 + w * 1.7 - normalize(p + 0.0001) * t * 0.45);
        float edge = (n - 0.5) * 0.4;
        float front = uFar * 1.2 * (1.0 - exp(-max(t - 0.45, 0.0) * 2.4)); // the cloud's leading edge
        float clear = uFar * 1.35 * smoothstep(0.85, 1.9, t);             // the clearing that follows
        float inside = smoothstep(front + 0.02, front - 0.14, d + edge);
        float outside = smoothstep(clear - 0.3, clear + 0.06, d + edge * 1.6);
        float dens = inside * outside * (0.5 + 0.8 * n) * step(0.45, t) * (1.0 - smoothstep(1.6, 2.2, t));

        vec3 col = mix(vec3(0.07, 0.02, 0.24), vec3(0.8, 0.18, 0.92), smoothstep(0.34, 0.8, n));
        col *= 0.55 + 0.75 * smoothstep(0.25, 0.8, fbm(q * 2.2 + w * 3.0)); // folds and billows
        col = mix(col, vec3(0.22, 0.52, 1.0), smoothstep(0.5, 0.9, w.x) * 0.65);
        col = mix(col, vec3(1.0, 0.25, 0.4), smoothstep(0.62, 0.95, w.y) * 0.35); // a little of the logo's red
        // lightning: thin bright veins through the smoke
        float v = abs(fbm(q * 2.6 + w * 2.2 + t * 0.5) - 0.5);
        float arcs = smoothstep(0.012, 0.0, v) * smoothstep(0.45, 0.7, fbm(q * 0.9 - t * 0.3)); // only here and there
        col += vec3(0.7, 0.8, 1.0) * (arcs * 1.3 + smoothstep(0.06, 0.0, v) * 0.12);
        // the hot rim of the front
        float rim = exp(-abs(d + edge - front) * 16.0) * step(0.45, t) * (1.0 - smoothstep(1.2, 1.8, t));
        float a = clamp(dens * 1.15, 0.0, 1.0);
        col = col * a + vec3(0.95, 0.55, 1.0) * rim * 1.1;
        a = clamp(a + rim * 0.7, 0.0, 1.0);

        // the charge: a ring of energy round the button
        float ch = smoothstep(0.0, 0.25, t) * (1.0 - smoothstep(0.45, 0.62, t));
        float rr = 0.05 + 0.035 * smoothstep(0.0, 0.45, t) + (fbm(vec2(ang * 3.0, t * 5.0)) - 0.5) * 0.035;
        float ring = (exp(-abs(d - rr) * 55.0) + 0.35 * exp(-abs(d - rr) * 12.0)) * ch;
        // the burst: rays and a flash
        float bt = clamp((t - 0.4) / 0.7, 0.0, 1.0);
        float rays = pow(abs(cos(ang * 3.0 + 0.6)), 48.0) + 0.7 * pow(abs(cos(ang * 5.0 - 1.1)), 80.0) + 0.5 * pow(abs(cos(ang * 2.0 + 2.0)), 120.0);
        float reach = bt * uFar * 1.3;
        float spike = rays * smoothstep(reach, reach * 0.15, d) * (1.0 - bt) * step(0.4, t) * exp(-d * 1.2) * 3.0;
        float flash = exp(-d * 5.0) * step(0.38, t) * (1.0 - smoothstep(0.4, 1.2, t)) * 2.2;
        col += vec3(1.0, 0.5, 1.0) * ring * 1.8 + mix(vec3(0.5, 0.7, 1.0), vec3(1.0, 0.45, 0.9), 0.5 + 0.5 * sin(ang * 3.0)) * spike + vec3(1.0, 0.82, 1.0) * flash;
        a = clamp(a + ring + spike * 0.6 + flash, 0.0, 1.0);
        gl_FragColor = vec4(col, a);
      }`;
    let done = false;
    const reveal = () => {
      if (done) return;
      done = true;
      const b = btn.getBoundingClientRect();
      const cx = b.left + b.width / 2;
      const cy = b.top + b.height / 2;
      const W = innerWidth, H = innerHeight;
      const END = 2300; // ms
      const COVERED = 820; // by now the smoke hides the window: the page comes in underneath it

      const parts = [...document.querySelectorAll<HTMLElement>('body > :not(main, dialog, script, .skip), main > :not(.space-field, .stage, .reveal-fx, script)')];
      root.setAttribute('data-revealing', '');
      root.removeAttribute('data-veil');
      for (const el of parts) {
        const r = el.getBoundingClientRect();
        if (!r.width || r.bottom < 0 || r.top > H) continue;
        el.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 380, delay: COVERED, easing: 'ease-out', fill: 'backwards' });
      }
      btn.animate([{ opacity: 1, transform: 'scale(1)' }, { opacity: 0, transform: 'scale(0.85)' }], { duration: 380, easing: 'ease-in', fill: 'forwards' })
        .finished.then(() => { btn.hidden = true; });

      const finish = () => {
        fx.width = fx.height = 0;
        root.removeAttribute('data-revealing');
      };
      const gl = fx.getContext('webgl', { premultipliedAlpha: true, alpha: true });
      if (!gl) { setTimeout(finish, COVERED + 500); return; }
      const dpr = Math.min(devicePixelRatio || 1, 1.5) * (W * H > 1.6e6 ? 0.75 : 1); // smoke is soft: fewer pixels are fine
      fx.width = Math.round(W * dpr);
      fx.height = Math.round(H * dpr);
      const sh = (type: number, src: string) => {
        const o = gl.createShader(type)!;
        gl.shaderSource(o, src);
        gl.compileShader(o);
        return o;
      };
      const prog = gl.createProgram()!;
      gl.attachShader(prog, sh(gl.VERTEX_SHADER, 'attribute vec2 a; void main() { gl_Position = vec4(a, 0.0, 1.0); }'));
      gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, FRAG));
      gl.linkProgram(prog);
      if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) { setTimeout(finish, COVERED + 500); return; }
      gl.useProgram(prog);
      gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
      const loc = gl.getAttribLocation(prog, 'a');
      gl.enableVertexAttribArray(loc);
      gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
      gl.viewport(0, 0, fx.width, fx.height);
      gl.uniform2f(gl.getUniformLocation(prog, 'uRes'), fx.width, fx.height);
      gl.uniform2f(gl.getUniformLocation(prog, 'uC'), cx * dpr, (H - cy) * dpr);
      gl.uniform1f(gl.getUniformLocation(prog, 'uFar'), Math.max(...[[0, 0], [W, 0], [0, H], [W, H]].map(([x, y]) => Math.hypot(x - cx, y - cy))) / H);
      const uT = gl.getUniformLocation(prog, 'uT');
      let t0 = 0;
      const frame = (now: number) => {
        if (!t0) t0 = now;
        const t = now - t0;
        if (t >= END) { finish(); return; }
        gl.uniform1f(uT, t / 1000);
        gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
        requestAnimationFrame(frame);
      };
      requestAnimationFrame(frame);
    };
    btn.addEventListener('click', reveal);
  }
</script>

<style>
  .crumbs {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 20px;
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 16px 0 12px;
    border-radius: var(--pill);
    background: var(--surface);
    box-shadow: var(--shadow-tile);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
  }
  .stepper {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .pos {
    margin-right: 8px;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }
  .round {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--surface);
    box-shadow: var(--shadow-tile);
    transition: background-color var(--t-fast) var(--ease-out), color var(--t-fast) var(--ease-out);
  }
  .round:hover {
    background: var(--btn-bg);
    color: var(--btn-ink);
  }

  /* Beat Saber: the logo hangs over the page, and switches on as it opens, BEAT then SABER */
  .stage {
    position: relative;
    display: grid;
    place-items: center;
    padding-block: clamp(32px, 6vw, 72px) 0;
  }
  /* Reveal: a glowing ring button under the logo, there only while the page is veiled */
  .reveal-btn {
    position: absolute;
    top: calc(100% + clamp(28px, 5vw, 56px));
    left: 50%;
    translate: -50% 0;
    min-height: 52px;
    padding: 0 36px;
    border: 1.5px solid rgb(120 220 255 / 0.85);
    border-radius: var(--pill);
    background: rgb(10 40 60 / 0.45);
    color: #e9fbff;
    font-family: var(--font-display);
    font-size: 1rem;
    font-style: italic;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-shadow: 0 0 8px rgb(120 220 255 / 0.9);
    box-shadow: 0 0 18px rgb(60 190 255 / 0.5), inset 0 0 14px rgb(60 190 255 / 0.3);
    cursor: pointer;
    animation: reveal-in 700ms var(--ease-out) 1.5s both, reveal-pulse 2.6s ease-in-out 2.2s infinite;
    transition: background-color var(--t-fast) var(--ease-out);
  }
  .reveal-btn:hover {
    background: rgb(20 80 115 / 0.55);
  }
  .reveal-btn:focus-visible {
    outline: 2px solid #e9fbff;
    outline-offset: 5px;
  }
  .reveal-btn[hidden],
  :global(html:not([data-veil]):not([data-revealing])) .reveal-btn {
    display: none;
  }
  @keyframes reveal-in {
    from { opacity: 0; transform: translateY(10px); }
  }
  @keyframes reveal-pulse {
    50% { box-shadow: 0 0 30px rgb(60 190 255 / 0.8), inset 0 0 18px rgb(60 190 255 / 0.45); }
  }
  /* the plasma the button sets off, drawn over the whole window while the page comes in under it */
  .reveal-fx {
    position: fixed;
    inset: 0;
    z-index: 60;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .stage :global(.stage-logo) {
    display: block;
    width: min(100%, 700px);
    height: auto;
    overflow: visible;
  }
  .stage :global(.bs-beat) {
    animation: stage-on 900ms linear 200ms both;
  }
  .stage :global(.bs-saber) {
    animation: stage-on 900ms linear 520ms both;
  }
  @keyframes stage-on {
    0% { opacity: 0.06; }
    10% { opacity: 1; }
    16% { opacity: 0.2; }
    24% { opacity: 0.9; }
    30% { opacity: 0.35; }
    46%, 100% { opacity: 1; }
  }

  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(16rem, 1fr);
    align-items: end;
    gap: 32px clamp(32px, 6vw, 96px);
    padding-block: clamp(40px, 6vw, 80px) clamp(28px, 4vw, 48px);
  }
  .intro .display {
    font-size: clamp(2.6rem, 5.6vw, 5rem);
  }
  .intro .quiet {
    margin-top: 0.2em;
    font-size: 0.5em;
    letter-spacing: -0.025em;
    line-height: 1.12;
  }
  .facts {
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .facts div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 12px;
    padding: 11px 0;
    border-bottom: 1px solid var(--line);
  }
  .facts dt {
    color: var(--ink-2);
  }
  .facts dd {
    margin: 0;
  }
  .hero {
    position: relative;
    margin-block: 0;
  }
  /* Balloon Sprint: huge clouds behind the cover, each centred on a side of the frame so half shows */
  .hero-clouds {
    position: absolute;
    inset: 0 var(--gutter);
    pointer-events: none;
  }
  .hero-clouds img {
    position: absolute;
    height: auto;
  }
  .hero-clouds .c1 {
    left: 0;
    top: 46%;
    width: 52%;
    translate: -50% -50%;
  }
  .hero-clouds .c2 {
    right: 0;
    top: 12%;
    width: 46%;
    translate: 50% -50%;
    scale: -1 1;
  }
  .hero-clouds ~ .hero-frame {
    position: relative;
  }
  /* the clouds reach past the window's edges: clip them there, sideways only */
  .hero-row.clip {
    overflow-x: clip;
  }
  .proto-frame {
    display: grid;
    place-items: center;
    padding: clamp(24px, 4vw, 48px) 16px;
    border-radius: var(--radius-lg);
    background:
      radial-gradient(80% 60% at 80% 0%, #ffffff 0%, rgb(255 255 255 / 0) 60%),
      linear-gradient(160deg, #eef5ff 0%, #dcebff 100%);
    overflow: hidden;
  }
  .proto-frame iframe {
    display: block;
    border: 0;
    background: transparent;
  }
  /* Never taller than the window: the prototype scales its phone to fit the frame */
  .proto-desktop {
    width: min(100%, 860px);
    height: clamp(600px, calc(100svh - 120px), 940px);
  }
  .proto-mobile {
    display: none !important;
    width: 300px;
    height: 650px;
  }
  .proto-cap {
    margin-top: 14px;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }
  .proto-cap a {
    margin-left: 6px;
    color: var(--ink);
    font-weight: 600;
  }
  @media (max-width: 860px) {
    .proto-desktop {
      display: none !important;
    }
    .proto-mobile {
      display: block !important;
