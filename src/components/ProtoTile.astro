---
/**
 * A project tile whose cover is the live prototype. It is as wide as a normal tile and two
 * rows tall, so the phone has room. The prototype stays interactive; the text links to the case.
 */
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}
const { project: p } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<article class="ptile">
  <div class="pframe">
    <iframe
      src={`${base}${p.prototype}?embed=1&demo=1`}
      title={`${p.title}: animated walk-through of the prototype`}
      loading="lazy"
    ></iframe>
  </div>
  <div class="text">
    <h3 class="title"><a href={`${base}/work/${p.slug}/`}>{p.title}</a></h3>
    <p class="desc">{p.summary}</p>
    <p class="meta">
      <span>{p.disciplines.join(' · ')}</span>
      <span class="year">{p.year}</span>
    </p>
  </div>
</article>

<style>
  .ptile {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 8px;
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-tile);
    transition:
      transform var(--t-med) var(--ease-out),
      box-shadow var(--t-med) var(--ease-out);
  }
  /* The frame takes whatever height the two rows leave; it never sets the rows' height itself */
  .pframe {
    position: relative;
    flex: 1;
    min-height: 420px;
    overflow: hidden;
    border-radius: var(--radius-md);
    background:
      radial-gradient(90% 60% at 85% 0%, #ffffff 0%, rgb(255 255 255 / 0) 60%),
      linear-gradient(160deg, #eef5ff 0%, #dcebff 100%);
  }
  .pframe iframe {
    position: absolute;
    inset: 16px 0;
    width: 100%;
    height: calc(100% - 32px);
    border: 0;
    background: transparent;
  }
  .text {
    position: relative;
    padding: 14px 12px 10px;
  }
  .title {
    font-size: 1.125rem;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .title a {
    text-decoration: none;
  }
  /* The whole text block is the link to the case study */
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-sm);
  }
  .title a:focus-visible {
    outline: none;
  }
  .title a:focus-visible::after {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .desc {
    margin-top: 4px;
    color: var(--ink-2);
    font-size: 0.875rem;
  }
  .meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 8px;
    color: var(--ink-2);
    font-size: 0.875rem;
  }
  .year {
    flex: none;
  }
  @media (hover: hover) {
    .ptile:has(.title a:hover) {
      transform: translateY(-4px);
      box-shadow: var(--shadow-lift);
    }
  }
  @media (max-width: 640px) {
    .ptile {
      padding: 5px;
      border-radius: var(--radius-md);
    }
    .pframe {
      min-height: 540px;
      border-radius: 15px;
    }
    .text {
      padding: 10px 6px 6px;
    }
  }
</style>
