---
import MkIcon from '../MkIcon.astro';
interface Props {
  variant: 'good' | 'bad';
}
const { variant } = Astro.props;
---

{variant === 'good' ? (
  <div class="mk">
    <div class="mk-card mk-col mk-gap-12">
      <p class="mk-h">New contact</p>
      <div class="mk-field">
        <span class="mk-label">First name</span>
        <div class="mk-input"><span class="ph">Jane</span></div>
      </div>
      <div class="mk-field">
        <span class="mk-label">Phone number</span>
        <div class="mk-input">
          <span class="cc">+1 <MkIcon name="chevron-down" size={10} stroke={2.4} /></span>
          <span class="sep"></span>
          <span class="ph">(555) 000-0000</span>
        </div>
      </div>
      <div class="mk-field">
        <span class="mk-label">Email</span>
        <div class="mk-input"><MkIcon name="mail" size={13} class="mk-muted" /><span class="ph">name@example.com</span></div>
      </div>
      <span class="mk-btn mk-btn-pri mk-btn-block mk-btn-lg">Save contact</span>
    </div>
  </div>
) : (
  <div class="mk">
    <div class="mk-card mk-col mk-gap-12">
      <p class="mk-h">New contact</p>
      <div class="bare">
        <span>First name</span>
        <i></i>
      </div>
      <div class="bare">
        <span>Phone number</span>
        <i></i>
      </div>
      <div class="bare">
        <span>Email</span>
        <i></i>
      </div>
      <span class="plain">Save contact</span>
    </div>
  </div>
)}

<style>
  .cc {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-weight: 500;
  }
  .sep {
    width: 1px;
    height: 16px;
    background: var(--mk-line);
  }
  .bare {
    display: flex;
    flex-direction: column;
    gap: 22px;
    font-size: 11px;
  }
  .bare i {
    display: block;
    height: 1px;
    background: var(--mk-line);
  }
  .plain {
    display: grid;
    place-items: center;
    height: 36px;
    font-size: 12px;
  }
</style>
