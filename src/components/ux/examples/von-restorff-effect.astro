---
import MkIcon from '../MkIcon.astro';
interface Props {
  variant: 'good' | 'bad';
}
const { variant } = Astro.props;
const plans = [
  { name: 'Basic', desc: 'For trying it out', price: '19', feats: ['3 projects', '5 GB', 'Email help'] },
  { name: 'Pro', desc: 'For small teams', price: '29', feats: ['20 projects', '100 GB', 'Chat help'], hi: true },
  { name: 'Premium', desc: 'For growing companies', price: '99', feats: ['Unlimited', '1 TB', 'Phone help'] },
];
---

{variant === 'good' ? (
  <div class="mk mk-wide">
    <p class="mk-h mk-center">Choose your plan</p>
    <div class="plans">
      {plans.map((p) => (
        <div class:list={['plan', { 'is-hi': p.hi }]}>
          {p.hi && <span class="pop"><MkIcon name="fire" size={9} stroke={2.4} />Popular</span>}
          <p class="name">{p.name}</p>
          <p class="desc">{p.desc}</p>
          <p class="price"><span class="cur">$</span>{p.price}<span class="per">/mo</span></p>
          <ul class="feats">
            {p.feats.map((f) => (
              <li><MkIcon name="check" size={9} stroke={3} />{f}</li>
            ))}
          </ul>
          <span class:list={['mk-btn mk-btn-xs mk-btn-block', p.hi ? 'mk-btn-pri' : 'mk-btn-sec']}>Choose</span>
        </div>
      ))}
    </div>
  </div>
) : (
  <div class="mk mk-wide">
    <p class="mk-h mk-center">Choose your plan</p>
    <div class="plans">
      {plans.map((p) => (
        <div class="plan">
          <p class="name">{p.name}</p>
          <p class="desc">{p.desc}</p>
          <p class="price"><span class="cur">$</span>{p.price}<span class="per">/mo</span></p>
          <ul class="feats">
            {p.feats.map((f) => (
              <li><MkIcon name="check" size={9} stroke={3} />{f}</li>
            ))}
          </ul>
          <span class="mk-btn mk-btn-xs mk-btn-block mk-btn-sec">Choose</span>
        </div>
      ))}
    </div>
  </div>
)}

<style>
  .plans {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 6px;
    margin-top: 18px;
  }
  .plan {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 12px 8px 8px;
    border: 1px solid var(--mk-line);
    border-radius: 10px;
    background: var(--mk-card);
  }
  .plan.is-hi {
    background: var(--mk-violet-soft);
    border-color: #cdb9fb;
  }
  .pop {
    position: absolute;
    top: -9px;
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 3px;
    height: 17px;
    padding: 0 7px;
    border-radius: 99px;
    background: var(--mk-violet);
    color: #fff;
    font-size: 9.5px;
    font-weight: 600;
    white-space: nowrap;
  }
  .name {
    font-size: 12px;
    font-weight: 600;
  }
  .desc {
    min-height: 26px;
    font-size: 9.5px;
    line-height: 1.3;
    color: var(--mk-2);
  }
  .price {
    font-size: 18px;
    font-weight: 700;
    line-height: 1;
  }
  .cur {
    font-size: 12px;
    font-weight: 600;
    color: var(--mk-3);
    vertical-align: 4px;
  }
  .per {
    margin-left: 1px;
    font-size: 9.5px;
    font-weight: 500;
    color: var(--mk-2);
  }
  .feats {
    display: grid;
    gap: 3px;
    margin: 2px 0 4px;
    padding-top: 6px;
    border-top: 1px solid var(--mk-line);
    font-size: 9.5px;
    color: var(--mk-2);
  }
  .is-hi .feats {
    border-top-color: #d9cafc;
  }
  .feats li {
    display: flex;
    align-items: center;
    gap: 4px;
    white-space: nowrap;
  }
</style>
