---
import MkIcon from '../MkIcon.astro';
interface Props {
  variant: 'good' | 'bad';
}
const { variant } = Astro.props;
const formats = ['SVG', 'JPG', 'PNG'];
---

<div class="mk mk-wide">
  <div class="mk-card mk-col mk-gap-12">
    <div class="mk-spread">
      <p class="mk-h">Add files</p>
      <span class="mk-xs">Brand kit · 0 files</span>
    </div>
    {variant === 'good' ? (
      <div class="drop">
        <span class="mk-ico is-violet is-lg circ"><MkIcon name="upload" size={18} /></span>
        <p class="mk-s ink"><b class="violet">Click to upload</b> or drag any file here</p>
        <p class="mk-xs mk-muted">SVG, JPG or PNG, up to 10 MB each</p>
      </div>
    ) : (
      <div class="drop is-split">
        {formats.map((f) => (
          <div class="mk-col mk-gap-6">
            <span class="mk-btn mk-btn-pri mk-btn-xs">Upload {f}</span>
            <div class="slot">or drag the file here</div>
          </div>
        ))}
      </div>
    )}
  </div>
</div>

<style>
  .drop {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 6px;
    min-height: 132px;
    padding: 14px 12px;
    border: 1.5px dashed #c9ccd3;
    border-radius: 12px;
    text-align: center;
  }
  .drop.is-split {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    justify-items: stretch;
    gap: 6px;
    padding: 10px 8px;
  }
  .mk-ico.circ {
    border-radius: 50%;
  }
  .ink {
    color: var(--mk-ink);
  }
  .violet {
    color: var(--mk-violet);
  }
  .slot {
    display: grid;
    place-items: center;
    min-height: 74px;
    padding: 6px;
    border-radius: 8px;
    background: var(--mk-bg);
    color: var(--mk-2);
    font-size: 9.5px;
    line-height: 1.3;
    text-align: center;
  }
</style>
