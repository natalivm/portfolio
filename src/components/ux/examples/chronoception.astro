---
import MkIcon from '../MkIcon.astro';
interface Props {
  variant: 'good' | 'bad';
}
const { variant } = Astro.props;
const steps = [
  { t: 'Order accepted', s: 'The kitchen has your order', state: 'done' },
  { t: 'Food is ready', s: 'Cooked in 5 minutes', state: 'done' },
  { t: 'Finding a courier', s: 'Usually takes under 2 minutes', state: 'now' },
  { t: 'On the way to you', s: '', state: '' },
  { t: 'Delivered', s: '', state: '' },
];
---

{variant === 'good' ? (
  <div class="mk">
    <div class="mk-card mk-col box">
      <div>
        <p class="eyebrow">Arriving in</p>
        <p class="mk-h-xl">23 min <span class="sec">22 sec</span></p>
      </div>
      <p class="mk-t mk-b">Order progress</p>
      <ol class="vsteps">
        {steps.map((st) => (
          <li class={st.state === 'done' ? 'is-done' : st.state === 'now' ? 'is-now' : ''}>
            <i>{st.state === 'done' && <MkIcon name="check" size={9} stroke={3.5} />}</i>
            <div>
              <p class="mk-t t">{st.t}</p>
              {st.s && <p class="mk-xs">{st.s}</p>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
) : (
  <div class="mk">
    <div class="mk-card box wait">
      <span class="spin"></span>
      <p class="mk-t mk-b">Preparing your order</p>
    </div>
  </div>
)}

<style>
  .box {
    min-height: 262px;
  }
  .eyebrow {
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--mk-2);
  }
  .sec {
    color: var(--mk-3);
  }
  .vsteps {
    display: flex;
    flex-direction: column;
  }
  .vsteps li {
    position: relative;
    display: flex;
    gap: 9px;
    padding-bottom: 8px;
  }
  .vsteps li:last-child {
    padding-bottom: 0;
  }
  .vsteps li::before {
    content: '';
    position: absolute;
    left: 6.5px;
    top: 15px;
    bottom: 0;
    width: 1.5px;
    background: var(--mk-line);
  }
  .vsteps li:last-child::before {
    display: none;
  }
  .vsteps i {
    position: relative;
    z-index: 1;
    flex: none;
    display: grid;
    place-items: center;
    width: 14px;
    height: 14px;
    margin-top: 1px;
    border: 1.5px solid var(--mk-line);
    border-radius: 50%;
    background: #fff;
    color: #fff;
  }
  .vsteps .is-done i {
    border-color: var(--mk-green);
    background: var(--mk-green);
  }
  .vsteps .is-done::before {
    background: var(--mk-green);
  }
  .vsteps .is-now i {
    border-color: var(--mk-green);
    box-shadow: 0 0 0 3px var(--mk-green-soft);
  }
  .vsteps .is-now i::after {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--mk-green);
  }
  .vsteps .t {
    font-weight: 600;
  }
  .vsteps li:not(.is-done):not(.is-now) .t {
    font-weight: 500;
    color: var(--mk-3);
  }
  .wait {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 10px;
  }
  .spin {
    width: 26px;
    height: 26px;
    border: 3px solid var(--mk-line);
    border-top-color: var(--mk-ink);
    border-radius: 50%;
  }
</style>
