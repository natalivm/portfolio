---
import MkIcon from '../MkIcon.astro';
interface Props {
  variant: 'good' | 'bad';
}
const { variant } = Astro.props;
const good = variant === 'good';
const items = [
  { name: 'Scented candle', price: '$18', img: 'is-1' },
  { name: 'Tea sampler', price: '$24', img: 'is-2' },
];
---

<div class="mk">
  <div class="mk-card session">
    {good ? (
      <div class="bar">
        <span class="mk-badge">Task 2 of 4</span>
        <span class="quiet"><i></i>Screen recorded</span>
        <span class="mk-xs skip">Skip</span>
      </div>
    ) : (
      <div class="bar is-loud">
        <span class="mk-badge is-solid"><i class="live"></i>REC</span>
        <span class="mk-badge is-dark"><MkIcon name="eye" size={10} />3 watching</span>
        <span class="cam"><MkIcon name="user" size={14} /><i></i></span>
      </div>
    )}
    <div class="task">
      <p class="mk-b mk-t">Find a birthday gift under $30.</p>
      {good ? (
        <p class="mk-xs">Take your time. We’re testing the app, not you.</p>
      ) : (
        <p class="warn">Say every step out loud. Your face and screen are being recorded.</p>
      )}
    </div>
    <div class="app mk-col mk-gap-8">
      <div class="mk-search"><MkIcon name="search" size={12} />Search gifts</div>
      <div class="mk-grid-2 mk-gap-6">
        {items.map((it) => (
          <div class="mk-col mk-gap-2">
            <div class:list={['mk-img', it.img, 'pic']}><MkIcon name="gift" size={16} /></div>
            <span class="mk-xs name">{it.name}</span>
            <span class="mk-b price">{it.price}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  .session {
    padding: 0;
    overflow: hidden;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    padding: 0 12px;
    background: var(--mk-bg);
    border-bottom: 1px solid var(--mk-line);
  }
  .bar.is-loud {
    background: var(--mk-red-soft);
    border-bottom-color: #f6c5ca;
  }
  .quiet {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 9.5px;
    color: var(--mk-3);
  }
  .quiet i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--mk-3);
  }
  .skip {
    margin-left: auto;
  }
  .live {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #fff;
  }
  .cam {
    position: relative;
    display: grid;
    place-items: center;
    width: 38px;
    height: 28px;
    margin-left: auto;
    border-radius: 6px;
    background: #2a2d33;
    color: #9aa0a9;
  }
  .cam i {
    position: absolute;
    top: 3px;
    right: 3px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--mk-red);
  }
  .task {
    display: grid;
    gap: 3px;
    padding: 10px 12px;
    border-bottom: 1px solid var(--mk-line);
  }
  .warn {
    font-size: 10px;
    font-weight: 600;
    color: var(--mk-red);
  }
  .app {
    padding: 10px 12px 12px;
  }
  .pic {
    aspect-ratio: auto;
    height: 52px;
  }
  .name {
    margin-top: 2px;
    color: var(--mk-ink);
  }
  .price {
    font-size: 11px;
  }
</style>
