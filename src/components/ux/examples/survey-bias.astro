---
interface Props { variant: 'good' | 'bad' }
const { variant } = Astro.props;
// Face mouths, from most negative to most positive
const m = {
  awful: 'M8 17a5 5 0 0 1 8 0',
  poor: 'M9 16c1-.7 2-1 3-1s2 .3 3 1',
  okay: 'M9 15.5h6',
  good: 'M9 14.5c1 .9 2 1.3 3 1.3s2-.4 3-1.3',
  great: 'M8 13.5h8a4 4 0 0 1-8 0z',
};
const balanced = [
  ['Very hard', m.awful],
  ['Hard', m.poor],
  ['Okay', m.okay],
  ['Easy', m.good],
  ['Very easy', m.great],
];
const leading = [
  ['It’s fine', m.okay],
  ['Great', m.good],
  ['Love it', m.great],
];
---

{variant === 'good' ? (
  <div class="mk">
    <div class="mk-card mk-col mk-gap-12">
      <p class="mk-h mk-center">How would you rate this update?</p>
      <div class="scale" style="--n: 5">
        {balanced.map(([label, mouth], i) => (
          <span class={i === 0 ? 'opt is-on' : 'opt'}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><circle cx="9" cy="10" r="0.9" fill="currentColor" /><circle cx="15" cy="10" r="0.9" fill="currentColor" /><path d={mouth} /></svg>
            {label}
          </span>
        ))}
      </div>
      <div class="mk-field">
        <span class="mk-label">What made it hard to use?</span>
        <div class="mk-input is-area"><span class="ph">Optional</span></div>
        <span class="mk-xs count">0/200</span>
      </div>
      <span class="mk-btn mk-btn-pri mk-btn-block">Send</span>
    </div>
  </div>
) : (
  <div class="mk">
    <div class="mk-card mk-col mk-gap-12">
      <p class="mk-h mk-center">How much did you love our new feature?</p>
      <div class="scale" style="--n: 3">
        {leading.map(([label, mouth]) => (
          <span class="opt">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><circle cx="9" cy="10" r="0.9" fill="currentColor" /><circle cx="15" cy="10" r="0.9" fill="currentColor" /><path d={mouth} /></svg>
            {label}
          </span>
        ))}
      </div>
      <div class="mk-field">
        <span class="mk-label">Would you recommend it to a friend?</span>
        <div class="mk-seg"><span class="is-on">Yes</span><span>Definitely</span></div>
      </div>
      <span class="mk-btn mk-btn-pri mk-btn-block">Send</span>
    </div>
  </div>
)}

<style>
  .scale {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    border: 1px solid var(--mk-line);
    border-radius: 10px;
    overflow: hidden;
  }
  .opt {
    display: grid;
    justify-items: center;
    gap: 3px;
    padding: 7px 2px;
    color: var(--mk-2);
    font-size: 9px;
    text-align: center;
    white-space: nowrap;
  }
  .opt + .opt {
    border-left: 1px solid var(--mk-line);
  }
  .opt.is-on {
    background: var(--mk-bg);
    color: var(--mk-ink);
    font-weight: 600;
  }
  .count {
    align-self: flex-end;
    margin-top: 3px;
  }
</style>
