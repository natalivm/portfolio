---
import MkIcon from '../MkIcon.astro';
interface Props {
  variant: 'good' | 'bad';
}
const { variant } = Astro.props;
const days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri'];
const today = ['soup', 'bread', 'salad', 'cake', 'juice', 'pizza', 'tea', 'rice', 'pie', 'bun'];
const all = ['soup', 'bread', 'salad', 'cake', 'juice', 'pizza', 'tea', 'rice', 'pie', 'bun', 'cheese', 'butter', 'pasta', 'honey', 'jam'];
---

{variant === 'good' ? (
  <div class="mk">
    <div class="mk-card mk-col mk-gap-8">
      <div class="mk-spread">
        <div>
          <p class="mk-h">Food and drinks</p>
          <p class="mk-s">50 new words</p>
        </div>
        <span class="mk-badge is-green">5-day plan</span>
      </div>
      <p class="mk-label sub">Your plan</p>
      <div class="days">
        {days.map((d, i) => (
          <span class={`day${i === 0 ? ' is-on' : ''}`}><b>{d}</b>10 words</span>
        ))}
      </div>
      <p class="mk-label sub">Today’s lesson</p>
      <div class="words">
        {today.map((w) => <span class="w">{w}</span>)}
      </div>
      <span class="mk-btn mk-btn-pri mk-btn-block mk-mt-4">Start today’s 10 words <MkIcon name="chevron-right" size={12} /></span>
    </div>
  </div>
) : (
  <div class="mk">
    <div class="mk-card mk-col mk-gap-8">
      <div class="mk-spread">
        <div>
          <p class="mk-h">Food and drinks</p>
          <p class="mk-s">50 new words</p>
        </div>
        <span class="mk-badge is-red">1 lesson</span>
      </div>
      <p class="mk-label sub">Words in this lesson</p>
      <div class="words">
        {all.map((w) => <span class="w">{w}</span>)}
        <span class="w is-more">+35 more</span>
      </div>
      <span class="mk-btn mk-btn-pri mk-btn-block mk-mt-4">Start lesson <MkIcon name="chevron-right" size={12} /></span>
    </div>
  </div>
)}

<style>
  .sub {
    margin: 2px 0 0;
  }
  .days {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 4px;
  }
  .day {
    display: grid;
    justify-items: center;
    gap: 1px;
    padding: 5px 0;
    border-radius: 8px;
    background: var(--mk-bg);
    color: var(--mk-2);
    font-size: 9px;
    white-space: nowrap;
  }
  .day b {
    font-size: 11px;
    color: var(--mk-ink);
  }
  .day.is-on {
    background: var(--mk-green-soft);
    box-shadow: inset 0 0 0 1.5px var(--mk-green);
    color: #0e5a2f;
  }
  .words {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .w {
    display: inline-flex;
    align-items: center;
    height: 22px;
    padding: 0 8px;
    border: 1px solid var(--mk-line);
    border-radius: 7px;
    background: var(--mk-card);
    font-size: 11px;
    font-weight: 500;
  }
  .w.is-more {
    border-style: dashed;
    color: var(--mk-2);
  }
</style>
