---
import MkIcon from '../MkIcon.astro';
interface Props {
  variant: 'good' | 'bad';
}
const { variant } = Astro.props;

// Icons the kit lacks, drawn on the same 24px grid and stroke as MkIcon
const odd = {
  archive: 'M3 4h18v5H3zM5 9v11h14V9M10 13h4',
  megaphone: 'M4 10h3l9-5v14l-9-5H4zM7 14l1.5 5.5h2.5L9.5 14.5M19 9.5c1.3 1.3 1.3 3.7 0 5',
  clipboard: 'M9 3h6v3H9zM8 4.5H5V21h14V4.5h-3M8 12.5h3M9.5 11v3M13 16.5h3',
  inbox: 'M4 14h4l1.5 3h5l1.5-3h4M4 14l2-8h2M20 14l-2-8h-2M4 14v6h16v-6M12 3v8M9 8l3 3 3-3',
};
const good = [
  { k: 'trash', l: 'Delete' },
  { k: 'send', l: 'Send' },
  { k: 'bell', l: 'Notifications' },
  { k: 'edit', l: 'Edit' },
  { k: 'mail', l: 'Mail' },
  { k: 'file', l: 'Document' },
] as const;
const bad = [
  { d: odd.archive, l: 'Delete' },
  { k: 'undo', l: 'Send' },
  { d: odd.megaphone, l: 'Notifications' },
  { d: odd.clipboard, l: 'Edit' },
  { d: odd.inbox, l: 'Mail' },
  { k: 'folder', l: 'Document' },
] as const;
---

{variant === 'good' ? (
  <div class="mk">
    <div class="mk-card mk-col mk-gap-12">
      <div class="mk-spread">
        <p class="mk-h">Quick actions</p>
        <span class="mk-muted"><MkIcon name="more" size={16} /></span>
      </div>
      <div class="mk-grid-3 mk-gap-6">
        {good.map((a) => (
          <div class="tile">
            <span class="mk-ico is-lg"><MkIcon name={a.k} size={18} stroke={1.8} /></span>
            <span class="lbl">{a.l}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
) : (
  <div class="mk">
    <div class="mk-card mk-col mk-gap-12">
      <div class="mk-spread">
        <p class="mk-h">Quick actions</p>
        <span class="mk-muted"><MkIcon name="more" size={16} /></span>
      </div>
      <div class="mk-grid-3 mk-gap-6">
        {bad.map((a) => (
          <div class="tile">
            <span class="mk-ico is-lg">
              {'k' in a ? (
                <MkIcon name={a.k} size={18} stroke={1.8} />
              ) : (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="flex: none"><path d={a.d} /></svg>
              )}
            </span>
            <span class="lbl">{a.l}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
)}

<style>
  .tile {
    display: grid;
    justify-items: center;
    gap: 6px;
    padding: 10px 4px 9px;
    border: 1px solid var(--mk-line);
    border-radius: 10px;
  }
  .lbl {
    font-size: 10.5px;
    font-weight: 500;
    white-space: nowrap;
  }
</style>
