---
import MkIcon from '../MkIcon.astro';
interface Props {
  variant: 'good' | 'bad';
}
const { variant } = Astro.props;
const versions = ['eSIM', 'Nano-SIM', 'Dual SIM'];
const memory = ['128 GB', '256 GB', '512 GB', '1 TB'];
const colours = ['#c9ccd1', '#d9c3a0', '#f7f7f5', '#26282d'];
---

{variant === 'good' ? (
  <div class="mk">
    <div class="mk-card mk-col mk-gap-12">
      <div class="mk-spread">
        <span class="mk-h">Aero 6 Pro</span>
        <span class="mk-h">$899</span>
      </div>
      <div class="mk-col mk-gap-6">
        <span class="mk-s">Version</span>
        <div class="mk-row mk-gap-6 mk-wrap">
          {versions.map((v, i) => <span class={`li-opt${i === 0 ? ' is-sel' : ''}`}>{v}</span>)}
        </div>
      </div>
      <div class="mk-col mk-gap-6">
        <span class="mk-s">Memory</span>
        <div class="mk-row mk-gap-6 mk-wrap">
          {memory.map((m, i) => <span class={`li-opt${i === 0 ? ' is-sel' : ''}`}>{m}</span>)}
        </div>
      </div>
      <div class="mk-col mk-gap-6">
        <span class="mk-s">Colour: <span class="li-ink">Silver</span></span>
        <div class="mk-row mk-gap-8">
          {colours.map((c, i) => <span class={`li-sw${i === 0 ? ' is-sel' : ''}`} style={`--sw:${c}`}></span>)}
        </div>
      </div>
      <span class="mk-btn mk-btn-pri mk-btn-block mk-btn-lg">Add to cart</span>
    </div>
  </div>
) : (
  <div class="mk">
    <div class="mk-card mk-col mk-gap-12">
      <div class="mk-spread">
        <span class="mk-h">Aero 6 Pro</span>
        <span class="mk-h">$899</span>
      </div>
      <div class="mk-col">
        {['Select version', 'Select memory', 'Select colour'].map((p) => (
          <div class="mk-input"><span class="ph">{p}</span><span class="mk-muted li-end"><MkIcon name="chevron-down" size={14} /></span></div>
        ))}
      </div>
      <span class="mk-btn mk-btn-pri mk-btn-block mk-btn-lg">Add to cart</span>
    </div>
  </div>
)}

<style>
  .li-ink {
    color: var(--mk-ink);
    font-weight: 600;
  }
  .li-opt {
    display: inline-grid;
    place-items: center;
    height: 26px;
    padding: 0 10px;
    border: 1px solid var(--mk-line);
    border-radius: 7px;
    font-size: 11px;
    font-weight: 500;
    white-space: nowrap;
  }
  .li-opt.is-sel {
    border-color: var(--mk-ink);
    box-shadow: inset 0 0 0 1px var(--mk-ink);
    font-weight: 600;
  }
  .li-sw {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--sw);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.12);
  }
  .li-sw.is-sel {
    box-shadow:
      inset 0 0 0 1px rgb(0 0 0 / 0.12),
      0 0 0 2px #fff,
      0 0 0 3.5px var(--mk-ink);
  }
  .li-end {
    display: inline-flex;
    margin-left: auto;
  }
</style>
