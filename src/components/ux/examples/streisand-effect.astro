---
import MkIcon from '../MkIcon.astro';
interface Props { variant: 'good' | 'bad' }
const { variant } = Astro.props;
const eyeOff = 'M3 3l18 18M10.6 5.1A10 10 0 0 1 12 5c6 0 10 7 10 7a17 17 0 0 1-3.2 3.9M6.6 6.6C3.9 8.4 2 12 2 12s4 7 10 7c1.9 0 3.6-.6 5-1.5M9.9 9.9a3 3 0 0 0 4.2 4.2';
---

{variant === 'good' ? (
  <div class="mk">
    <div class="mk-card mk-col post">
      <div class="mk-row">
        <span class="mk-avatar is-4">ML</span>
        <div class="mk-grow">
          <p class="mk-b">Mia Lund</p>
          <p class="mk-xs">2 h</p>
        </div>
        <MkIcon name="more" />
      </div>
      <div class="media is-veiled">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={eyeOff} /></svg>
        <p class="mk-b">Sensitive content</p>
        <p class="note">This photo shows a medical procedure that some people may find upsetting.</p>
        <span class="mk-btn mk-btn-xs veil-btn">View anyway</span>
      </div>
      <div class="mk-row mk-gap-12 mk-s">
        <span class="mk-row mk-gap-4"><MkIcon name="heart" size={13} />32</span>
        <span class="mk-row mk-gap-4"><MkIcon name="chat" size={13} />4</span>
      </div>
      <p class="cmt"><b>Leo</b> Thanks for the warning. Fascinating to see.</p>
    </div>
  </div>
) : (
  <div class="mk">
    <div class="mk-card mk-col post">
      <div class="mk-row">
        <span class="mk-avatar is-4">ML</span>
        <div class="mk-grow">
          <p class="mk-b">Mia Lund</p>
          <p class="mk-xs">2 h</p>
        </div>
        <MkIcon name="more" />
      </div>
      <div class="media is-blank">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={eyeOff} /></svg>
        <p class="mk-s">Photo unavailable</p>
      </div>
      <div class="mk-row mk-gap-12 mk-s">
        <span class="mk-row mk-gap-4"><MkIcon name="heart" size={13} />32</span>
        <span class="mk-row mk-gap-4 hot"><MkIcon name="chat" size={13} />148</span>
      </div>
      <p class="cmt"><b>Leo</b> What are they hiding? Did anyone save it?</p>
    </div>
  </div>
)}

<style>
  .post {
    padding: 12px;
  }
  .media {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 4px;
    height: 140px;
    padding: 12px;
    border-radius: 10px;
    text-align: center;
  }
  .media.is-veiled {
    background:
      linear-gradient(rgb(27 29 34 / 0.5), rgb(27 29 34 / 0.5)),
      radial-gradient(circle at 25% 35%, #f6a9b9 0, transparent 50%),
      radial-gradient(circle at 75% 70%, #9fcfe4 0, transparent 55%),
      #b9a7e6;
    color: #fff;
  }
  .media.is-blank {
    background: var(--mk-bg);
    color: var(--mk-3);
  }
  .note {
    max-width: 210px;
    font-size: 10px;
    opacity: 0.9;
  }
  .veil-btn {
    margin-top: 4px;
    border-color: rgb(255 255 255 / 0.55);
    background: rgb(255 255 255 / 0.18);
    color: #fff;
  }
  .hot {
    color: var(--mk-ink);
    font-weight: 600;
  }
  .cmt {
    font-size: 11px;
    color: var(--mk-2);
  }
  .cmt b {
    color: var(--mk-ink);
  }
</style>
