---
interface Props {
  variant: 'good' | 'bad';
}
const { variant } = Astro.props;
const keys = ['7', '8', '9', '÷', '4', '5', '6', '×', '1', '2', '3', '−', '0', '.', '=', '+'];
const ops = ['÷', '×', '−', '+'];
---

<div class="mk">
  <div class={`sk-calc ${variant === 'good' ? 'is-good' : 'is-bad'}`}>
    {variant === 'bad' && (
      <div class="sk-plate">
        <i class="sk-screw"></i><span>DELUXE · CALC</span><i class="sk-screw"></i>
      </div>
    )}
    <div class="sk-lcd">
      <span class="sk-ghost">88888.88</span>
      <span class="sk-val">58.20</span>
    </div>
    <div class="sk-keys">
      {keys.map((k) => (
        <span class={`sk-key${ops.includes(k) ? ' is-op' : ''}${k === '=' ? ' is-eq' : ''}`}>{k}</span>
      ))}
    </div>
  </div>
</div>

<style>
  .sk-calc {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 236px;
    margin-inline: auto;
    padding: 14px;
    border-radius: 20px;
  }
  .sk-lcd {
    position: relative;
    display: flex;
    justify-content: flex-end;
    height: 44px;
    padding: 0 12px;
    border-radius: 10px;
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 24px;
    line-height: 44px;
    letter-spacing: 1px;
  }
  .sk-ghost,
  .sk-val {
    position: absolute;
    right: 12px;
  }
  .sk-keys {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 7px;
  }
  .sk-key {
    display: grid;
    place-items: center;
    height: 30px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
  }

  /* Do: a little depth, where it says "press me", and nothing else */
  .is-good {
    background: linear-gradient(170deg, #f7f8fa, #e6e8ec);
    box-shadow: var(--mk-shadow);
  }
  .is-good .sk-lcd {
    background: #e3ebd2;
    box-shadow: inset 0 2px 4px rgb(40 50 20 / 0.18);
    color: #2c331e;
  }
  .is-good .sk-ghost {
    color: rgb(44 51 30 / 0.07);
  }
  .is-good .sk-key {
    background: linear-gradient(#ffffff, #f2f3f5);
    color: var(--mk-ink);
    box-shadow:
      0 2px 0 #cfd3da,
      0 3px 6px -2px rgb(20 22 28 / 0.2);
  }
  .is-good .sk-key.is-op {
    color: var(--mk-2);
  }
  .is-good .sk-key.is-eq {
    background: linear-gradient(#ffb547, #f08a1c);
    color: #fff;
    box-shadow:
      0 2px 0 #c96a0c,
      0 3px 6px -2px rgb(20 22 28 / 0.25);
  }

  /* Don't: leather, stitching, brushed metal and wood grain, with labels that sink into them */
  .is-bad {
    gap: 8px;
    padding: 10px 14px 14px;
    background:
      radial-gradient(circle at 20% 30%, rgb(255 255 255 / 0.08) 0 1px, transparent 2px) 0 0 / 6px 6px,
      radial-gradient(circle at 70% 60%, rgb(0 0 0 / 0.12) 0 1px, transparent 2px) 0 0 / 5px 5px,
      linear-gradient(160deg, #7a4a2a, #4f2c16);
    outline: 1.5px dashed rgb(255 220 170 / 0.55);
    outline-offset: -6px;
    box-shadow: var(--mk-shadow);
  }
  .sk-plate {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 6px;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 2px;
    color: #a57b52;
    text-shadow: 0 1px 0 rgb(0 0 0 / 0.4);
  }
  .sk-screw {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #f2e6c9, #9c8251);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.25);
  }
  .is-bad .sk-lcd {
    background:
      linear-gradient(rgb(255 255 255 / 0.45), transparent 55%),
      repeating-linear-gradient(90deg, #b7b9bc 0 1px, #c9cbce 1px 3px);
    box-shadow:
      inset 0 2px 5px rgb(0 0 0 / 0.45),
      0 1px 0 rgb(255 255 255 / 0.2);
    color: #a2a5a9;
    text-shadow: 0 1px 0 rgb(255 255 255 / 0.6);
  }
  .is-bad .sk-ghost {
    color: rgb(0 0 0 / 0.06);
  }
  .is-bad .sk-key {
    position: relative;
    overflow: hidden;
    background:
      linear-gradient(rgb(255 255 255 / 0.28), transparent 50%),
      repeating-linear-gradient(100deg, #8a5a32 0 2px, #9e6c3f 2px 5px, #7c4e28 5px 7px);
    color: #6a4220;
    text-shadow: 0 1px 0 rgb(255 255 255 / 0.25);
    box-shadow:
      0 2px 0 #3c200c,
      inset 0 0 0 1px rgb(255 230 190 / 0.25);
  }
  .is-bad .sk-key.is-eq {
    background:
      linear-gradient(rgb(255 255 255 / 0.45), transparent 50%),
      linear-gradient(#d7b56a, #a8853d);
    color: #9c7a34;
  }
</style>
