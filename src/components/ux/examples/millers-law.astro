---
import MkIcon from '../MkIcon.astro';
interface Props {
  variant: 'good' | 'bad';
}
const { variant } = Astro.props;
const dishes = [
  ['Margherita', 11], ['Caesar salad', 9], ['Espresso', 3], ['Tiramisu', 7], ['Pepperoni', 13],
  ['Lemonade', 4], ['Greek salad', 8], ['Cheesecake', 7], ['Hawaiian', 12], ['Latte', 4],
  ['Panna cotta', 6], ['Four cheese', 13], ['Iced tea', 4], ['Garden salad', 8], ['Brownie', 6],
  ['Cappuccino', 4], ['Diavola', 13], ['Tuna salad', 10], ['Ice cream', 5], ['Veggie pizza', 11],
];
---

{variant === 'good' ? (
  <div class="mk">
    <div class="mk-card mk-col mk-gap-12">
      <div>
        <p class="mk-h">Menu</p>
        <p class="mk-s">Choose a category</p>
      </div>
      <div class="mk-grid-2">
        <div class="mk-flat cat">
          <span class="mk-ico is-lg is-amber"><MkIcon name="pizza" size={18} /></span>
          <p class="mk-b">Pizza</p>
          <span class="mk-badge">6 dishes</span>
        </div>
        <div class="mk-flat cat">
          <span class="mk-ico is-lg is-green"><MkIcon name="leaf" size={18} /></span>
          <p class="mk-b">Salads</p>
          <span class="mk-badge">4 dishes</span>
        </div>
        <div class="mk-flat cat">
          <span class="mk-ico is-lg is-red">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none">
              <path d="M4 20h16M5 20v-8h14v8M5 15.5c2.3 1.4 4.7 1.4 7 0s4.7-1.4 7 0M12 12V8.5M12 5.5h.01" />
            </svg>
          </span>
          <p class="mk-b">Desserts</p>
          <span class="mk-badge">5 dishes</span>
        </div>
        <div class="mk-flat cat">
          <span class="mk-ico is-lg is-violet"><MkIcon name="coffee" size={18} /></span>
          <p class="mk-b">Drinks</p>
          <span class="mk-badge">5 dishes</span>
        </div>
      </div>
    </div>
  </div>
) : (
  <div class="mk">
    <div class="mk-card mk-col mk-gap-8">
      <div>
        <p class="mk-h">Menu</p>
        <p class="mk-s">20 dishes</p>
      </div>
      <div class="dishes">
        {dishes.map(([n, p]) => (
          <div class="dish">
            <span class="dn">{n}</span>
            <span class="dp">${p}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
)}

<style>
  .cat {
    display: grid;
    justify-items: center;
    gap: 5px;
    padding: 12px 6px;
  }
  .cat .mk-b {
    font-size: 12px;
  }
  .dishes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-flow: column;
    grid-template-rows: repeat(10, auto);
    gap: 3px 6px;
  }
  .dish {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 4px;
    height: 17px;
    padding: 0 6px;
    border: 1px solid var(--mk-line);
    border-radius: 5px;
    font-size: 9.5px;
  }
  .dn {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .dp {
    flex: none;
    color: var(--mk-2);
  }
</style>
