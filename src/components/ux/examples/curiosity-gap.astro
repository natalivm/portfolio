---
import MkIcon from '../MkIcon.astro';
interface Props {
  variant: 'good' | 'bad';
}
const { variant } = Astro.props;
---

{variant === 'good' ? (
  <div class="mk">
    <div class="mk-card mk-col">
      <div class="mk-img is-3 photo"><MkIcon name="eye" size={28} /></div>
      <p class="mk-xs">Design · 6 min read</p>
      <p class="mk-h">Principles of visual hierarchy</p>
      <p class="mk-s fade">Why do some layouts catch the eye in a split second, while others get scrolled past? The answer starts with what</p>
      <span class="mk-btn mk-btn-pri mk-btn-block">Continue reading</span>
    </div>
  </div>
) : (
  <div class="mk">
    <div class="mk-card mk-col mk-center">
      <div class="mk-img is-3 photo">
        <MkIcon name="eye" size={28} />
        <span class="ring"></span>
      </div>
      <p class="bait">YOU WON’T BELIEVE what 99% of designers never do...</p>
      <p class="bait">SHOCKING SECRET of great design!!!!!</p>
      <span class="mk-btn mk-btn-danger mk-btn-block">READ NOW!!!</span>
    </div>
  </div>
)}

<style>
  .photo {
    aspect-ratio: 2.6 / 1;
  }
  .fade {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, #000 50%, rgb(0 0 0 / 0.2) 100%);
    mask-image: linear-gradient(to bottom, #000 50%, rgb(0 0 0 / 0.2) 100%);
  }
  .bait {
    color: var(--mk-red);
    font-size: 12px;
    font-weight: 700;
    line-height: 1.3;
  }
  .ring {
    position: absolute;
    right: 18%;
    top: 22%;
    width: 46px;
    height: 46px;
    border: 3px solid var(--mk-red);
    border-radius: 50%;
  }
</style>
