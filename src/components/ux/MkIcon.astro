export type MkIconName = keyof typeof paths;

interface Props {
  name: MkIconName;
  size?: number;
  stroke?: number;
  class?: string;
}
const { name, size = 14, stroke = 2, class: cls } = Astro.props;
// Dots are drawn with a heavier pen so they read as dots
const heavy = name === 'more' || name === 'dot';
---

<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={heavy ? 3.5 : stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  style="flex: none"
><path d={paths[name]} /></svg>
