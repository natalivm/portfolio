---
/**
 * The Beat Saber main menu, rebuilt as a live panel that hangs in the page's space: Challenges on
 * the left, the music packs in the middle, Multiplayer on the right, and the bar below. It has no
 * backdrop of its own: every control is glass, a barely-there fill with a hairline edge and thin
 * type, and colour and light arrive on hover. The side panels curve toward the viewer like the
 * game's menu around the player; the whole menu leans a little with the pointer, and a soft
 * laser dot follows the pointer over it.
 *
 * Everything works: challenge timers count down, the pack pages turn, the multiplayer pack and
 * difficulty cycle, and Join looks for a lobby. Picking a pack swaps the panels for the song screen:
 * the pack's songs with a search and an A to Z rail, the chosen song with its modes, difficulty,
 * modifiers and Play, and the high scores. Back (or Escape) returns to the packs. Under it runs the music pack
 * pass, a battle pass: a blue band with the level, the XP and a reward at each milestone. Its tab
 * opens the list of passes, one per music pack, each with its own progress; a reward that has been
 * reached can be claimed.
 *
 * Album art goes in public/cases/beat-saber/albums/, named as `img` on each pack below: square covers
 * for albums, tall ones for banners, cut to the slot's shape (129 : 274) with no transparent edge. A tile whose file is missing shows a placeholder in
 * the pack's colours.
 */
import '@fontsource-variable/teko';
import BorderBeam from './effects/BorderBeam.astro';

interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const albumSrc = (f: string) => `${base}/cases/beat-saber/albums/${f}`;

type Album = { title: string; sub?: string; img?: string; tall?: boolean; look: string; kind?: 'random' | 'all' };
const blank = (n: number): Album => ({ title: `Pack ${n}`, look: 'blank' });
// a page is four columns, three rows: square albums on top, banners two rows tall below,
// in the game's arrangement (two squares stack in the gap between banners)
const pages: Album[][] = [
  [
    { title: 'Daft Punk', img: 'daft-punk.webp', look: 'ost-b' },
    { title: 'Lady Gaga', sub: 'Music Pack', img: 'lady-gaga.webp', look: 'magenta' },
    { title: 'Imagine Dragons', sub: 'Music Pack', img: 'imagine-dragons.webp', look: 'ost-c' },
    { title: 'Britney Spears', img: 'britney-spears.webp', look: 'violet' },
    { title: 'TinyTAN', img: 'tinytan.webp', tall: true, look: 'magenta' },
    { title: 'Skrillex', sub: 'Music Pack', img: 'skrillex.webp', look: 'teal' },
    { title: 'Linkin Park', sub: 'Music Pack', img: 'linkin-park.webp', tall: true, look: 'ash' },
    // two tiles that are not packs: a dice for a random album, and the three dots that open every album
    { title: 'Random album', look: 'special', kind: 'random' },
    { title: 'Rocket League', sub: '× Monstercat', img: 'rocket-league.webp', look: 'cat' },
    { title: 'All albums', look: 'special', kind: 'all' },
  ],
  [
    { title: 'OST', sub: 'Vol. 1', look: 'ost-a' },
    { title: 'OST', sub: 'Vol. 2', look: 'ost-b' },
    { title: 'OST', sub: 'Vol. 3', look: 'ost-c' },
    { title: 'Volume Four', sub: 'Beat Saber', look: 'cube' },
    { title: 'Monstercat', sub: 'Music Pack Vol. 1', img: 'monstercat.webp', tall: true, look: 'cat' },
    { title: 'Camellia', look: 'teal' },
    { title: 'Extras', look: 'violet' },
    ...Array.from({ length: 4 }, (_, i) => blank(16 + i)),
  ],
  Array.from({ length: 12 }, (_, i) => blank(20 + i)),
  Array.from({ length: 12 }, (_, i) => blank(32 + i)),
];

// The song screen: what each pack holds. Song titles are the packs' own; lengths, tempos and note
// counts are made up from the title, so they are stable but not the game's real figures.
const SONGS: Record<string, string[]> = {
  'Daft Punk': ['Around the World', 'Da Funk', 'Get Lucky', 'Harder, Better, Faster, Stronger', 'Instant Crush', 'Lose Yourself to Dance', 'One More Time', 'Technologic', 'The Prime Time of Your Life', 'Veridis Quo'],
  'Lady Gaga': ['Alejandro', 'Bad Romance', 'Born This Way', 'Just Dance', 'Paparazzi', 'Poker Face', 'Rain on Me', 'Stupid Love', 'Telephone', 'The Edge of Glory'],
  'Imagine Dragons': ['Bad Liar', 'Believer', 'Digital', 'It’s Time', 'Machine', 'Natural', 'Radioactive', 'Thunder', 'Warriors', 'Whatever It Takes'],
  'Britney Spears': ['…Baby One More Time', 'Circus', 'Gimme More', 'I’m a Slave 4 U', 'Oops!… I Did It Again', 'Stronger', 'Till the World Ends', 'Toxic', 'Womanizer', '(You Drive Me) Crazy'],
  TinyTAN: ['Blood Sweat & Tears', 'Boy With Luv', 'Burning Up (Fire)', 'Dionysus', 'DNA', 'Dope', 'Dynamite', 'Fake Love', 'Idol', 'Mic Drop', 'Not Today', 'Ugh!'],
  Skrillex: ['Bangarang', 'Butterflies', 'Don’t Go', 'First of the Year (Equinox)', 'Ragga Bomb', 'Rock ’n’ Roll', 'Scary Monsters and Nice Sprites', 'The Devil’s Den'],
  'Linkin Park': ['Bleed It Out', 'Breaking the Habit', 'Faint', 'Given Up', 'In the End', 'New Divide', 'Numb', 'One Step Closer', 'Papercut', 'Somewhere I Belong', 'What I’ve Done'],
  Monstercat: ['Boundless', 'Emoji VIP', 'Epic', 'Feeling Stronger', 'Overkill', 'Rattlesnake', 'Stronger', 'This Time', 'Till It’s Over', 'We Won’t Be Alone'],
  'Rocket League': ['Glide', 'Luv U Need U', 'Play', 'Rock It', 'Shiawase', 'Test Me'],
};
const ARTIST: Record<string, string> = { TinyTAN: 'BTS', Monstercat: 'Monstercat', 'Rocket League': 'Monstercat' };
const seed = (str: string) => {
  let h = 2166136261;
  for (const c of str) h = Math.imul(h ^ c.charCodeAt(0), 16777619);
  return h >>> 0;
};
const albums = pages.flat().filter((a) => !a.kind);
const library = albums.map((a) => {
  const titles = SONGS[a.title] ?? Array.from({ length: 8 }, (_, i) => `Track ${i + 1}`);
  const name = a.title === 'OST' ? `${a.title} ${a.sub}` : a.title;
  const by = ARTIST[a.title] ?? (SONGS[a.title] ? a.title : 'Various artists');
  return {
    name,
    img: a.img ?? '',
    songs: titles.map((t) => {
      const h = seed(t + a.title);
      const secs = 150 + (h % 100);
      return { t, by, len: `${Math.floor(secs / 60)}:${String(secs % 60).padStart(2, '0')}`, bpm: 92 + ((h >>> 8) % 88), notes: 420 + ((h >>> 4) % 640), walls: (h >>> 12) % 48, bombs: (h >>> 17) % 26 };
    }),
  };
});
const modes = [
  { name: 'Standard', icon: 'M5 19L19 5M5 5l14 14' },
  { name: 'One Saber', icon: 'M5 19L19 5' },
  { name: 'No Arrows', icon: 'M12 7.500a4.500 4.500 0 1 0 0 9 4.500 4.500 0 0 0 0-9z' },
  { name: '360°', text: '360' },
  { name: '90°', text: '90' },
];
const mods = [
  { name: 'No Fail', x: -0.5, icon: 'M12 19.500s-7-4.300-7-9.300a3.900 3.900 0 0 1 7-2.400 3.900 3.900 0 0 1 7 2.400c0 5-7 9.300-7 9.300z' },
  { name: 'One Life', x: 0, icon: 'M12 19.500s-7-4.300-7-9.300a3.900 3.900 0 0 1 7-2.400 3.900 3.900 0 0 1 7 2.400c0 5-7 9.300-7 9.300zM12 10v5' },
  { name: 'No Bombs', x: -0.1, icon: 'M12 5a7 7 0 1 0 0 14 7 7 0 0 0 0-14zM7 7l10 10' },
  { name: 'No Walls', x: -0.05, icon: 'M6 6h12v12H6zM6 18L18 6' },
  { name: 'Faster Song', x: 0.08, icon: 'M6 7l5 5-5 5M13 7l5 5-5 5' },
  { name: 'Ghost Notes', x: 0.11, icon: 'M6.500 19V11a5.500 5.500 0 0 1 11 0v8l-2.200-1.800-1.700 1.800-1.600-1.800-1.600 1.800-1.700-1.800zM10 11v.500M14 11v.500' },
  { name: 'Disappearing Arrows', x: 0.07, icon: 'M5 12h3M10.500 12h3M16 12h3M15.500 8.500L19 12l-3.500 3.500' },
];

const challenges = [
  { t: 'Clear 20 songs', note: '(5 remaining)', mins: 6 * 24 * 60 + 5 * 60, xp: '+1.5K XP', done: 15, of: 20 },
  { t: 'Clear any song with no arrows modifier', mins: 85, xp: '+1.5K XP', card: true, done: 0, of: 1 },
];
const nextChallengeMins = 2 * 60 + 34;
const packs = ['Any', ...new Set(pages[0].filter((a) => !a.kind).map((a) => (a.sub && a.title === 'OST' ? `${a.title} ${a.sub}` : a.title)))];
const difficulties = ['Easy', 'Normal', 'Hard', 'Expert', 'Expert+'];

// Music pack passes: a battle pass per pack, six rewards each, at levels 2, 4, … 12.
// `claimed` is how many rewards are already collected; a reward whose level is reached and not yet
// collected can be claimed on the bar. The first pass is the one showing.
const REWARDS = ['Bonus song', 'Saber colours', 'Note trail', 'Avatar jacket', 'Platform skin', 'Title: Legend'];
const passes = [
  { name: 'Harmony Highway', pack: 'Linkin Park', img: 'linkin-park.webp', level: 4, xp: 300, max: 1500, claimed: 1 },
  { name: 'Bass Canyon', pack: 'Skrillex', img: 'skrillex.webp', level: 9, xp: 1200, max: 2000, claimed: 3 },
  { name: 'Robot Boulevard', pack: 'Daft Punk', img: 'daft-punk.webp', level: 12, xp: 0, max: 0, claimed: 6 },
  { name: 'Neon Avenue', pack: 'Lady Gaga', img: 'lady-gaga.webp', level: 1, xp: 120, max: 500, claimed: 0 },
];
const msLevel = (i: number) => 2 * (i + 1);
const msState = (ps: (typeof passes)[number], i: number) => (i < ps.claimed ? 'claimed' : ps.level >= msLevel(i) ? 'ready' : 'locked');
const msNote = (st: string, i: number) => (st === 'claimed' ? 'Claimed' : st === 'ready' ? 'Click to claim' : `Reach level ${msLevel(i)}`);
// the scale: its first stretch covers levels 1 to 9, its second 9 to 13
const at = (ps: (typeof passes)[number]) => ps.level + (ps.max ? ps.xp / ps.max : 0);
const fillA = (ps: (typeof passes)[number]) => Math.min(1, Math.max(0, (at(ps) - 1) / 8));
const fillB = (ps: (typeof passes)[number]) => Math.min(1, Math.max(0, (at(ps) - 9) / 4));
const first = passes[0];
---

<div class:list={['bsm', cls]} data-bsm data-library={JSON.stringify(library)} data-albums={albumSrc('')} role="group" aria-label="Beat Saber main menu, interactive">
  <div class="bsm-float">
    <div class="bsm-scene" data-scene>
      <!-- challenges -->
      <section class="bsm-panel left v-main" aria-labelledby="bsm-ch">
        <h3 id="bsm-ch" class="bsm-h">Challenges</h3>
        <ul class="bsm-list" role="list">
          {challenges.map((c) => (
            <li>
              <button type="button" class:list={['ch', c.card && 'stack']} data-ch style={`--p:${c.done / c.of}`} aria-label={`${c.t}, ${c.done} of ${c.of} done`}>
                <span class="ch-t">{c.t} {c.note && <span class="ch-note">{c.note}</span>}</span>
                <span class="ch-foot">
                  <span class="ch-time"><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="7.5" /><path d="M10 6v4.2l2.6 1.6" /></svg><span data-left={c.mins}></span></span>
                  <span class="ch-xp">{c.card && <span class="ch-plus">+<i class="ch-card" aria-hidden="true"></i></span>}{c.xp}</span>
                </span>
                <span class="ch-bar" aria-hidden="true"><i></i></span>
              </button>
            </li>
          ))}
          <li>
            <div class="ch next" aria-live="polite">new challenge in<br /><span data-left={nextChallengeMins}></span></div>
          </li>
        </ul>
      </section>

      <!-- singleplayer -->
      <section class="bsm-panel mid v-main" aria-labelledby="bsm-sp">
        <h3 id="bsm-sp" class="bsm-h">Singleplayer</h3>
        <div class="packs" data-packs>
          <div class="pages" data-pages>
            {pages.map((page, pi) => (
              <div class="page" data-page={pi} aria-hidden={pi === 0 ? undefined : 'true'}>
                {page.map((a) => a.kind ? (
                  <button type="button" class="tile special" data-tile data-special={a.kind} tabindex={pi === 0 ? undefined : -1} aria-label={a.kind === 'random' ? 'Random album: open one at random' : 'All albums'}>
                    {a.kind === 'random' ? (
                      <svg class="dice" viewBox="0 0 48 48" aria-hidden="true">
                        <path class="face" d="M24 5.500l15 7.200v20.600L24 42.500 9 33.300V12.700z" />
                        <path class="edge" d="M9 12.700l15 8.300 15-8.300M24 21v21.500" />
                        <circle cx="24" cy="12.900" r="2.300" /><circle cx="14" cy="24.500" r="2.100" /><circle cx="19" cy="33" r="2.100" />
                        <circle cx="29.500" cy="24.500" r="2.100" /><circle cx="34" cy="31" r="2.100" /><circle cx="31.800" cy="27.800" r="2.100" />
                      </svg>
                    ) : (
                      <svg class="more" viewBox="0 0 48 48" aria-hidden="true"><circle cx="12" cy="24" r="4.200" /><circle cx="24" cy="24" r="4.200" /><circle cx="36" cy="24" r="4.200" /></svg>
                    )}
                  </button>
                ) : (
                  <button type="button" class:list={['tile', a.tall && 'tall', `look-${a.look}`]} data-tile data-pack={albums.indexOf(a)} tabindex={pi === 0 ? undefined : -1} aria-label={`${[a.title, a.sub].filter(Boolean).join(' ')}: open the songs`}>
                    <span class:list={['art', a.title.length > 9 && 'long']} aria-hidden="true">
                      <span class="art-t">{a.title}</span>
                      {a.sub && <span class="art-s">{a.sub}</span>}
                    </span>
                    {a.img && <img src={albumSrc(a.img)} alt="" loading="lazy" decoding="async" onerror="this.remove()" />}
                  </button>
                ))}
              </div>
            ))}
          </div>
        </div>
        <!-- every album at once, opened by the three dots -->
        <div class="all" data-all inert>
          <div class="all-head">
            <p>All albums <span>{albums.length}</span></p>
            <button type="button" class="all-close glass" data-all-close aria-label="Back to the pages">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7l10 10M17 7L7 17" /></svg>
            </button>
          </div>
          <div class="all-grid">
            {albums.map((a, i) => (
              <button type="button" class:list={['all-item', `look-${a.look}`]} data-all-item={i} style={`--k:${i}`} aria-label={`${[a.title, a.sub].filter(Boolean).join(' ')}: open the songs`}>
                <span class="all-art">{a.img ? <img src={albumSrc(a.img)} alt="" loading="lazy" decoding="async" /> : <span>{a.title}</span>}</span>
                <span class="all-name">{a.title === 'OST' ? `${a.title} ${a.sub}` : a.title}</span>
              </button>
            ))}
          </div>
        </div>
        <div class="dots" role="tablist" aria-label="Pack pages">
          {pages.map((_, i) => (
            <button type="button" role="tab" data-dot={i} aria-selected={i === 0 ? 'true' : 'false'} aria-label={`Page ${i + 1}`}></button>
          ))}
        </div>
      </section>

      <!-- multiplayer -->
      <section class="bsm-panel right v-main" aria-labelledby="bsm-mp">
        <h3 id="bsm-mp" class="bsm-h">Multiplayer</h3>
        <div class="mp">
          <button type="button" class="pick" data-cycle={JSON.stringify(packs)} data-i="0">
            <span class="chev l" aria-hidden="true">‹</span><span class="chev r" aria-hidden="true">›</span>
            <span class="pick-l">Music Pack</span>
            <span class="pick-v" data-v>{packs[0]}</span>
          </button>
          <button type="button" class="pick" data-cycle={JSON.stringify(difficulties)} data-i="3">
            <span class="chev l" aria-hidden="true">‹</span><span class="chev r" aria-hidden="true">›</span>
            <span class="pick-l">Difficulty</span>
            <span class="pick-v" data-v>{difficulties[3]}</span>
          </button>
          <BorderBeam class="join-beam" variant="mono" size="sm" strength={0.95} duration={3.2} radius="calc(var(--u) * 14)" fill>
            <button type="button" class="join" data-join><span data-join-t>Join</span></button>
          </BorderBeam>
          <div class="pair">
            <button type="button" class="blue" data-press>Create<br />Server</button>
            <button type="button" class="blue" data-press>Join with<br />Code</button>
          </div>
        </div>
      </section>

      <!-- the bar below -->
      <nav class="bar v-main" aria-label="Menu bar">
        <button type="button" class="bar-btn" data-press>Party</button>
        <button type="button" class="bar-btn" data-press>Campaign</button>
        <button type="button" class="ico" data-press aria-label="Settings">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3.2" /><path d="M12 2.8v2.4M12 18.8v2.4M2.8 12h2.4M18.8 12h2.4M5.5 5.5l1.7 1.7M16.8 16.8l1.7 1.7M5.5 18.5l1.7-1.7M16.8 7.2l1.7-1.7" /><circle cx="12" cy="12" r="6.6" /></svg>
        </button>
        <button type="button" class="ico" data-press aria-label="Help">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8.6 8.4a3.6 3.6 0 1 1 5.2 3.2c-1.1.6-1.8 1.3-1.8 2.6v.6" /><circle cx="12" cy="18.6" r="0.6" /></svg>
        </button>
        <button type="button" class="ico" data-press aria-label="Edit avatar">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 13.5V19a1.5 1.5 0 0 1-1.5 1.5h-12A1.5 1.5 0 0 1 4 19V7a1.5 1.5 0 0 1 1.5-1.5H11" /><path d="M17.2 3.8l3 3L12 15l-3.6.6.6-3.6z" /></svg>
        </button>
        <button type="button" class="ico" data-press aria-label="Exit">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4h4.5A1.5 1.5 0 0 1 20 5.5v13a1.5 1.5 0 0 1-1.5 1.5H14" /><path d="M4 12h10M10 8l4 4-4 4" /></svg>
        </button>
      </nav>

      <!-- the song screen: a pack's songs, the chosen song, and its high scores. It takes the panels' place when a pack is picked. -->
      <section class="bsm-panel left v-songs" aria-label="Songs" inert>
        <div class="s-top">
          <button type="button" class="s-back glass" data-back aria-label="Back to the music packs">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.500 5.500L8 12l6.500 6.500" /></svg>
          </button>
          <label class="s-search glass">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.500" cy="10.500" r="5.500" /><path d="M15 15l4.500 4.500" /></svg>
            <input type="search" placeholder="Search" data-search aria-label="Search this pack’s songs" />
          </label>
        </div>
        <p class="s-pack" data-s-pack></p>
        <div class="s-body">
          <div class="s-index" data-index></div>
          <div class="s-list" data-songs role="listbox" aria-label="Songs"></div>
        </div>
      </section>

      <section class="bsm-panel mid v-songs" aria-label="Song" inert>
        <header class="d-head">
          <h3 class="d-title" data-d-title></h3>
          <p class="d-by" data-d-by></p>
          <button type="button" class="d-fav" data-fav aria-pressed="false" aria-label="Favourite">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19.500s-7-4.300-7-9.300a3.900 3.900 0 0 1 7-2.400 3.900 3.900 0 0 1 7 2.400c0 5-7 9.300-7 9.300z" /></svg>
          </button>
        </header>
        <ul class="d-stats" role="list">
          <li title="Length"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="7.500" /><path d="M12 8v4.300l2.700 1.600" /></svg><span data-d-len></span></li>
          <li title="Beats per minute"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 17.500V6.500l9-2v11" /><circle cx="6.800" cy="17.500" r="2.200" /><circle cx="15.800" cy="15.500" r="2.200" /></svg><span data-d-bpm></span></li>
          <li title="Notes"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="5" width="14" height="14" rx="3" /><path d="M9 14l3-4 3 4" /></svg><span data-d-notes></span></li>
          <li title="Walls"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.500h10v15H7zM7 9.500h10M7 14.500h10" /></svg><span data-d-walls></span></li>
          <li title="Bombs"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="13.500" r="5.500" /><path d="M14.800 9.700l2-2M17.500 5l1.500-1.500M19 7.500h1.500" /></svg><span data-d-bombs></span></li>
        </ul>
        <div class="d-modes" role="radiogroup" aria-label="Mode">
          {modes.map((m, i) => (
            <button type="button" class="d-mode glass" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-mode data-tip={m.name} aria-label={m.name}>
              {m.text ? <span>{m.text}</span> : <svg viewBox="0 0 24 24" aria-hidden="true"><path d={m.icon} /></svg>}
            </button>
          ))}
        </div>
        <div class="d-diffs" role="radiogroup" aria-label="Difficulty">
          {difficulties.map((d, i) => (
            <button type="button" class="seg" role="radio" aria-checked={i === 3 ? 'true' : 'false'} data-diff={i}>{d}</button>
          ))}
        </div>
        <div class="d-mods" role="group" aria-label="Modifiers">
          {mods.map((m) => (
            <button type="button" class="d-mod glass" aria-pressed="false" data-mod={m.x} data-tip={`${m.name}${m.x ? ` ${m.x > 0 ? '+' : '−'}${Math.abs(m.x).toFixed(2)}` : ''}`} aria-label={m.name}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d={m.icon} /></svg>
            </button>
          ))}
          <p class="d-mult">Score <b data-mult>×1.00</b></p>
        </div>
        <div class="d-go">
          <button type="button" class="d-practice glass" data-press>Practice</button>
          <button type="button" class="join d-play" data-play><span data-play-t>Play</span></button>
        </div>
      </section>

      <section class="bsm-panel right v-songs" aria-labelledby="bsm-hs" inert>
        <h3 id="bsm-hs" class="bsm-h">High scores</h3>
        <div class="hs-tabs" role="radiogroup" aria-label="Whose scores">
          {['Global', 'Friends', 'You'].map((t, i) => (
            <button type="button" class="seg" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-scope={i}>{t}</button>
          ))}
        </div>
        <ol class="hs" data-hs role="list"></ol>
        <p class="hs-you">Your best <b data-you></b><span>Max combo <b data-combo></b></span></p>
      </section>

      <!-- the music pack pass: a battle pass, with a reward at each milestone -->
      <section class="pass" data-pass data-passes={JSON.stringify(passes)} aria-label="Music pack pass">
        <div class="pass-menu" data-pass-menu role="menu" aria-label="Music pack passes" inert>
          <p class="pm-h">Music pack passes</p>
          {passes.map((ps, i) => (
            <button type="button" class="pm" role="menuitemradio" aria-checked={i === 0 ? 'true' : 'false'} data-pass-item={i}>
              <img src={albumSrc(ps.img)} alt="" loading="lazy" decoding="async" />
              <span class="pm-text">
                <span class="pm-name">{ps.name}</span>
                <span class="pm-pack">{ps.pack} Music Pack</span>
              </span>
              <span class="pm-prog">
                <span class="pm-lv">{ps.claimed === 6 ? 'Complete' : `Level ${ps.level}`}</span>
                <span class="pm-bar"><i style={`--v:${Math.min(1, (at(ps) - 1) / 11)}`}></i></span>
                <span class="pm-rw"><span data-pm-rw>{ps.claimed}</span>/6 rewards</span>
              </span>
            </button>
          ))}
        </div>
        <button type="button" class="pass-tab" data-pass-tab aria-haspopup="menu" aria-expanded="false">
          <span class="pass-names">
            <span class="pass-name" data-pass-name>{first.name}</span>
            <span class="pass-sub">Rewards <span data-pass-count>{first.claimed}</span>/6</span>
          </span>
          <img class="pass-thumb" data-pass-thumb src={albumSrc(first.img)} alt="" loading="lazy" decoding="async" />
          <svg class="pass-chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 7.500L6 4l3.500 3.500" /></svg>
        </button>
        <div class="pass-seg a">
          <div class="pass-level">
            <span class="pass-chip">Level <span data-pass-level>{first.level}</span></span>
            <span class="pass-xp" data-pass-xp>{first.max ? `${first.xp} / ${first.max} XP` : 'Complete'}</span>
          </div>
          <div class="pass-scale" data-scale="a" style={`--fill:${fillA(first)}`}>
          {[0, 1, 2, 3].map((i) => {
            const st = msState(first, i);
            return (
              <button type="button" class="ms" data-ms={i} data-state={st} aria-label={`Level ${msLevel(i)}: ${REWARDS[i]}`}>
                <span class="ms-tip">
                  <span class="ms-lv">Level {msLevel(i)}</span>
                  <span class="ms-rw">{REWARDS[i]}</span>
                  <span class="ms-st" data-ms-st>{msNote(st, i)}</span>
                </span>
              </button>
            );
          })}
          </div>
        </div>
        <div class="pass-seg b">
          <div class="pass-scale" data-scale="b" style={`--fill:${fillB(first)}`}>
          {[4, 5].map((i) => {
            const st = msState(first, i);
            return (
              <button type="button" class="ms" data-ms={i} data-state={st} aria-label={`Level ${msLevel(i)}: ${REWARDS[i]}`}>
                <span class="ms-tip">
                  <span class="ms-lv">Level {msLevel(i)}</span>
                  <span class="ms-rw">{REWARDS[i]}</span>
                  <span class="ms-st" data-ms-st>{msNote(st, i)}</span>
                </span>
              </button>
            );
          })}
          </div>
        </div>
      </section>
    </div>
  </div>
  <i class="laser" aria-hidden="true" data-laser></i>
</div>

<style>
  /* sizes are in design pixels at a 1364 px wide menu (--u), so the whole menu scales as one.
     The look: glass. Barely-there fills, hairline edges, thin type; colour and light arrive on hover. */
  .bsm {
    --cyan: #9be9ff;
    --val: #4cc9ff;
    --ink: #eef9ff;
    --mute: rgb(205 232 245 / 0.5);
    --glass: rgb(160 225 255 / 0.07);
    --glass-h: rgb(170 232 255 / 0.15);
    --line: rgb(170 230 255 / 0.16);
    --line-h: rgb(195 242 255 / 0.75);
    --ease: cubic-bezier(0.2, 0.8, 0.2, 1);
    position: relative;
    width: min(100%, 1240px);
    margin-inline: auto;
    container-type: inline-size;
    perspective: 1700px;
    font-family: 'Teko Variable', 'Teko', var(--font-display), sans-serif;
    font-style: italic; /* the game's type leans, everywhere */
    font-weight: 400;
    color: var(--ink);
    -webkit-tap-highlight-color: transparent;
  }
  .bsm-float {
    transform-style: preserve-3d;
  }
  .bsm-scene {
    /* 22 + 306 + 72 + 564 + 72 + 306 + 22 = 1364 design pixels across */
    --u: calc(100cqw / 1364);
    display: grid;
    grid-template-columns: minmax(0, 306fr) minmax(0, 564fr) minmax(0, 306fr);
    grid-template-areas: 'l m r' 'bar bar bar' 'pass pass pass'; /* the bar is centred under the whole menu, and may run wider than the pack wall */
    column-gap: calc(var(--u) * 72);
    row-gap: calc(var(--u) * 34);
    padding-inline: calc(var(--u) * 22);
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transform-style: preserve-3d;
  }
  button {
    font: inherit;
    color: inherit;
    border: 0;
    cursor: pointer;
  }
  /* in the 3D scene the layout layers can sit over the buttons for the hit test: only buttons take the pointer */
  .bsm-float,
  .bsm-scene,
  .bsm-scene * {
    pointer-events: none;
  }
  .bsm-scene button {
    pointer-events: auto;
  }
  .bsm-scene button * {
    pointer-events: none;
  }
  .bsm-scene label,
  .bsm-scene input,
  .bsm-scene .s-list,
  .bsm-scene .all-grid {
    pointer-events: auto;
  }

  /* panels: the sides curve toward the viewer, the way the menu wraps around the player */
  .bsm-panel {
    display: grid;
    align-content: start;
    gap: calc(var(--u) * 24);
    transform-style: preserve-3d;
    transition: translate 1s var(--ease), opacity 700ms ease;
  }
  .left {
    grid-area: l;
    transform-origin: right center;
    transform: rotateY(16deg);
  }
  .mid {
    grid-area: m;
  }
  .right {
    grid-area: r;
    transform-origin: left center;
    transform: rotateY(-16deg);
  }
  .bsm:not(.on) .bsm-panel,
  .bsm:not(.on) .bar,
  .bsm:not(.on) .pass {
    opacity: 0;
    translate: 0 calc(var(--u) * 30) calc(var(--u) * -260);
  }
  .bsm.on .left { transition-delay: 120ms; }
  .bsm.on .right { transition-delay: 240ms; }
  .bsm.on .bar { transition-delay: 360ms; }
  .bsm.on .pass { transition-delay: 480ms; }
  .bsm-h {
    margin: 0;
    font-family: inherit; /* the site's heading font would win otherwise */
    color: var(--mute);
    font-size: calc(var(--u) * 34);
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.05em;
    text-indent: 0.05em;
    text-align: center;
    text-transform: uppercase;
  }
  .bsm-h::after {
    content: '';
    display: block;
    width: calc(var(--u) * 44);
    height: 1px;
    margin: calc(var(--u) * 12) auto 0;
    background: linear-gradient(90deg, transparent, var(--cyan), transparent);
    opacity: 0.7;
  }

  /* glass: the shared surface of every quiet control */
  .ch,
  .pick,
  .bar-btn,
  .ico,
  .glass {
    position: relative;
    /* glass: one flat, see-through fill that softens what is behind it, a hairline edge and a lit top lip */
    background: var(--glass);
    -webkit-backdrop-filter: blur(10px) saturate(1.5);
    backdrop-filter: blur(10px) saturate(1.5);
    box-shadow: inset 0 0 0 1px var(--line), inset 0 1px 0 rgb(255 255 255 / 0.16);
    transition: background-color 260ms ease, box-shadow 260ms ease, translate 260ms var(--ease), color 200ms ease, scale 160ms ease;
  }
  button.ch:hover,
  button.ch:focus-visible,
  .pick:hover,
  .pick:focus-visible,
  .bar-btn:hover,
  .bar-btn:focus-visible,
  .ico:hover,
  .ico:focus-visible,
  .glass:hover,
  .glass:focus-visible,
  .glass:focus-within {
    background-color: var(--glass-h);
    box-shadow: inset 0 0 0 1px var(--line-h), inset 0 1px 0 rgb(255 255 255 / 0.4), 0 0 calc(var(--u) * 28) rgb(70 195 255 / 0.22);
    translate: 0 calc(var(--u) * -3);
  }
  /* a line of light that crosses a control as the pointer arrives */
  button.ch,
  .pick,
  .bar-btn,
  .join,
  .blue,
  .tile {
    overflow: hidden;
  }
  button.ch::after,
  .pick::after,
  .bar-btn::after,
  .join::after,
  .blue::after,
  .tile::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 36%, rgb(255 255 255 / 0.18) 50%, transparent 64%);
    translate: -120% 0;
  }
  button.ch:hover::after,
  .pick:hover::after,
  .bar-btn:hover::after,
  .join:hover::after,
  .blue:hover::after,
  .tile:hover::after {
    translate: 120% 0;
    transition: translate 800ms var(--ease);
  }

  /* challenges */
  .bsm-list {
    display: grid;
    gap: calc(var(--u) * 18);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ch {
    display: grid;
    align-content: space-between;
    width: 100%;
    min-height: calc(var(--u) * 124);
    padding: calc(var(--u) * 14) calc(var(--u) * 18) calc(var(--u) * 14);
    border-radius: calc(var(--u) * 14);
    text-align: left;
  }
  .ch.stack {
    box-shadow: inset 0 0 0 1px var(--line), inset 0 1px 0 rgb(255 255 255 / 0.16), calc(var(--u) * -8) 0 0 calc(var(--u) * -3) rgb(150 220 255 / 0.07), calc(var(--u) * -15) 0 0 calc(var(--u) * -6) rgb(150 220 255 / 0.04);
  }
  .ch-t {
    font-size: calc(var(--u) * 24);
    line-height: 1.02;
    letter-spacing: 0.01em;
  }
  .ch-note {
    margin-left: calc(var(--u) * 6);
    color: var(--mute);
  }
  .ch-foot {
    display: flex;
    align-items: end;
    justify-content: space-between;
    margin-top: calc(var(--u) * 12);
  }
  .ch-time {
    display: flex;
    align-items: center;
    gap: calc(var(--u) * 7);
    color: var(--mute);
    font-size: calc(var(--u) * 21);
    letter-spacing: 0.02em;
  }
  .ch-time svg {
    width: calc(var(--u) * 18);
    height: calc(var(--u) * 18);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
  }
  .ch-xp {
    display: flex;
    align-items: center;
    gap: calc(var(--u) * 9);
    color: var(--cyan);
    font-size: calc(var(--u) * 26);
    font-weight: 500;
    letter-spacing: 0.02em;
    transition: text-shadow 260ms ease;
  }
  .ch:hover .ch-xp,
  .ch:focus-visible .ch-xp {
    text-shadow: 0 0 calc(var(--u) * 14) rgb(90 205 255 / 0.9);
  }
  .ch-plus {
    display: flex;
    align-items: center;
    gap: calc(var(--u) * 5);
    color: var(--ink);
  }
  .ch-card {
    width: calc(var(--u) * 15);
    height: calc(var(--u) * 22);
    border-radius: calc(var(--u) * 3);
    background: linear-gradient(160deg, #f2f6f9, #a3b0b9);
    transform: skewX(-8deg);
  }
  .ch-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: calc(var(--u) * 3);
    background: rgb(150 225 255 / 0.1);
    opacity: 0;
    transition: opacity 260ms ease;
  }
  .ch-bar i {
    display: block;
    width: 0;
    height: 100%;
    background: linear-gradient(90deg, var(--val), var(--cyan));
    box-shadow: 0 0 8px var(--val);
    transition: width 700ms var(--ease) 80ms;
  }
  .ch:hover .ch-bar,
  .ch:focus-visible .ch-bar {
    opacity: 1;
  }
  .ch:hover .ch-bar i,
  .ch:focus-visible .ch-bar i {
    width: calc(var(--p) * 100%);
  }
  .ch.next {
    display: grid;
    place-content: center;
    color: rgb(205 232 245 / 0.32);
    background: none;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    box-shadow: none;
    border: 1px dashed rgb(170 230 255 / 0.16);
    font-size: calc(var(--u) * 22);
    line-height: 1.1;
    letter-spacing: 0.03em;
    text-align: center;
    text-transform: uppercase;
  }

  /* singleplayer: the pack wall, in pages */
  .packs {
    overflow: hidden;
    margin: calc(var(--u) * -16);
    padding: calc(var(--u) * 16);
  }
  .pages {
    display: flex;
    transition: translate 600ms cubic-bezier(0.3, 0.8, 0.2, 1);
    translate: calc(var(--page, 0) * (-100% - var(--u) * 32)) 0;
    gap: calc(var(--u) * 32);
  }
  .page {
    display: grid;
    flex: 0 0 100%;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: calc(var(--u) * 129); /* (564 - 3 gaps) / 4: square cells */
    gap: calc(var(--u) * 16);
  }
  .tile {
    --c: #8fdcff;
    position: relative;
    padding: 0;
    border-radius: calc(var(--u) * 12);
    background: color-mix(in srgb, var(--c) 13%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--c) 34%, transparent), inset 0 1px 0 rgb(255 255 255 / 0.12);
    transition: scale 280ms cubic-bezier(0.3, 1.3, 0.5, 1), box-shadow 240ms ease, opacity 240ms ease;
  }
  .tile.tall {
    grid-row: span 2;
  }
  /* covers carry their own rounded corners: the tile clips just outside them */
  .tile:has(img) {
    background: none;
    box-shadow: none;
  }
  .tile:has(img) .art {
    opacity: 0;
  }
  .tile img {
    position: absolute;
    inset: -1%;
    width: 102%;
    height: 102%;
    object-fit: cover;
  }
  /* hover: the cover comes forward and the rest of the wall steps back */
  .tile:hover,
  .tile:focus-visible {
    z-index: 1;
    scale: 1.07;
    outline: none;
    box-shadow: 0 0 0 calc(var(--u) * 1.5) rgb(255 255 255 / 0.9), 0 0 calc(var(--u) * 34) rgb(80 200 255 / 0.5), 0 calc(var(--u) * 16) calc(var(--u) * 30) rgb(0 0 0 / 0.4);
  }
  .page:has(.tile:hover) .tile:not(:hover) {
    opacity: 0.5;
  }
  .tile[aria-pressed='true'] {
    box-shadow: 0 0 0 calc(var(--u) * 2) var(--cyan), 0 0 calc(var(--u) * 30) rgb(80 200 255 / 0.55);
  }
  .tile[aria-pressed='true']::before {
    content: '✓';
    position: absolute;
    top: calc(var(--u) * 8);
    right: calc(var(--u) * 8);
    z-index: 1;
    display: grid;
    place-items: center;
    width: calc(var(--u) * 26);
    height: calc(var(--u) * 26);
    border-radius: 50%;
    background: var(--cyan);
    color: #06202c;
    font: normal 700 calc(var(--u) * 15) / 1 var(--font-ui);
    box-shadow: 0 0 calc(var(--u) * 12) rgb(80 200 255 / 0.8);
  }
  .art {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    padding: calc(var(--u) * 8);
    text-align: center;
    line-height: 0.95;
    text-transform: uppercase;
  }
  .art-t {
    color: color-mix(in srgb, var(--c) 45%, white);
    font-size: calc(var(--u) * 30);
    font-weight: 500;
    letter-spacing: 0.02em;
  }
  .art.long .art-t {
    font-size: calc(var(--u) * 21);
  }
  .art-s {
    margin-top: calc(var(--u) * 6);
    color: var(--mute);
    font-size: calc(var(--u) * 16);
    letter-spacing: 0.04em;
  }
  /* placeholder tints, until a pack's art arrives */
  .look-ost-a { --c: #2f8fff; }
  .look-ost-b { --c: #ff3a4c; }
  .look-ost-c { --c: #4f6dff; }
  .look-cube { --c: #ff3355; }
  .look-magenta { --c: #ff3fa0; }
  .look-teal { --c: #2ad0d8; }
  .look-ash { --c: #d2ccc5; }
  .look-cat { --c: #3b8cff; }
  .look-violet { --c: #b866ff; }
  .look-blank {
    background: var(--glass);
    box-shadow: inset 0 0 0 1px rgb(170 230 255 / 0.1);
  }
  .look-blank .art {
    opacity: 0.4;
  }
  .look-blank .art-t {
    font-size: calc(var(--u) * 18);
    font-weight: 400;
    letter-spacing: 0.04em;
  }
  /* the two tiles that are not packs: dark glass, a light icon */
  .tile.special {
    display: grid;
    place-items: center;
    background: rgb(8 18 32 / 0.6);
    box-shadow: inset 0 0 0 1px var(--line), inset 0 1px 0 rgb(255 255 255 / 0.1);
    color: #cfe9f3;
  }
  .tile.special svg {
    width: 46%;
    height: 46%;
    fill: currentColor;
    transition: rotate 600ms var(--ease), scale 300ms var(--ease);
  }
  .dice .face {
    opacity: 0.92;
  }
  .dice .edge {
    fill: none;
    stroke: #0a1826;
    stroke-width: 1.6;
    stroke-linejoin: round;
  }
  .dice circle {
    fill: #0a1826;
  }
  .tile.special:hover .dice,
  .tile.special:focus-visible .dice {
    rotate: 180deg;
  }
  .tile.special.rolling .dice {
    rotate: 900deg;
    transition-duration: 700ms;
  }
  .tile.special:hover .more,
  .tile.special:focus-visible .more {
    scale: 1.2;
  }

  /* every album at once */
  .all {
    display: none;
    gap: calc(var(--u) * 12);
    height: calc(var(--u) * 451);
    grid-template-rows: auto minmax(0, 1fr);
  }
  .mid[data-all] .packs,
  .mid[data-all] .dots {
    display: none;
  }
  .mid[data-all] .all {
    display: grid;
  }
  .all-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .all-head p {
    margin: 0;
    color: var(--ink);
    font-size: calc(var(--u) * 26);
    font-weight: 500;
  }
  .all-head p span {
    margin-left: calc(var(--u) * 6);
    color: var(--mute);
    font-weight: 400;
  }
  .all-close {
    display: grid;
    place-items: center;
    width: calc(var(--u) * 42);
    height: calc(var(--u) * 42);
    padding: 0;
    border-radius: 50%;
  }
  .all-close svg {
    width: calc(var(--u) * 20);
    height: calc(var(--u) * 20);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }
  .all-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    align-content: start;
    gap: calc(var(--u) * 16) calc(var(--u) * 12);
    padding: calc(var(--u) * 6) calc(var(--u) * 8) calc(var(--u) * 6) calc(var(--u) * 6);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: rgb(170 230 255 / 0.3) transparent;
  }
  .all-item {
    --c: #8fdcff;
    display: grid;
    gap: calc(var(--u) * 6);
    padding: 0;
    background: none;
    text-align: center;
    animation: all-in 420ms var(--ease) calc(var(--k) * 18ms) backwards;
  }
  @keyframes all-in {
    from { opacity: 0; translate: 0 calc(var(--u) * 12); }
  }
  .all-art {
    display: grid;
    place-items: center;
    overflow: hidden;
    aspect-ratio: 1;
    border-radius: calc(var(--u) * 11);
    background: color-mix(in srgb, var(--c) 13%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--c) 34%, transparent);
    color: color-mix(in srgb, var(--c) 45%, white);
    font-size: calc(var(--u) * 17);
    line-height: 0.95;
    text-transform: uppercase;
    transition: box-shadow 220ms ease, scale 260ms cubic-bezier(0.3, 1.3, 0.5, 1);
  }
  .all-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }
  .all-name {
    overflow: hidden;
    color: var(--mute);
    font-size: calc(var(--u) * 17);
    line-height: 1;
    white-space: nowrap;
    text-overflow: ellipsis;
    transition: color 200ms ease;
  }
  .all-item:hover .all-art,
  .all-item:focus-visible .all-art {
    scale: 1.06;
    box-shadow: 0 0 0 calc(var(--u) * 1.5) rgb(255 255 255 / 0.9), 0 0 calc(var(--u) * 26) rgb(80 200 255 / 0.5);
  }
  .all-item:hover .all-name,
  .all-item:focus-visible .all-name {
    color: var(--ink);
  }
  .all-item:focus-visible {
    outline: none;
  }

  .dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: calc(var(--u) * 12);
    margin-top: calc(var(--u) * 4);
  }
  .dots button {
    position: relative;
    width: calc(var(--u) * 9);
    height: calc(var(--u) * 9);
    padding: 0;
    border-radius: 999px;
    background: rgb(205 232 245 / 0.28);
    transition: width 320ms var(--ease), background-color 220ms ease, box-shadow 220ms ease;
  }
  .dots button::before {
    content: '';
    position: absolute;
    inset: calc(var(--u) * -10) calc(var(--u) * -6);
  }
  .dots button:hover {
    background: rgb(205 232 245 / 0.7);
  }
  .dots button[aria-selected='true'] {
    width: calc(var(--u) * 30);
    background: var(--cyan);
    box-shadow: 0 0 calc(var(--u) * 10) rgb(90 205 255 / 0.8);
  }

  /* multiplayer */
  .mp {
    display: grid;
    gap: calc(var(--u) * 14);
  }
  .pick {
    display: grid;
    gap: calc(var(--u) * 4);
    padding: calc(var(--u) * 14) 0 calc(var(--u) * 11);
    border-radius: calc(var(--u) * 14);
    line-height: 1;
  }
  .pick-l {
    color: var(--mute);
    font-size: calc(var(--u) * 22);
    letter-spacing: 0.06em;
    text-indent: 0.06em;
    text-transform: uppercase;
  }
  .pick-v {
    color: var(--val);
    font-size: calc(var(--u) * 30);
    font-weight: 500;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    transition: text-shadow 260ms ease, color 260ms ease;
  }
  .pick:hover .pick-v,
  .pick:focus-visible .pick-v {
    color: var(--cyan);
    text-shadow: 0 0 calc(var(--u) * 14) rgb(76 201 255 / 0.9);
  }
  .pick-v.flip {
    animation: bsm-flip 280ms var(--ease);
  }
  @keyframes bsm-flip {
    from { opacity: 0; translate: 0 calc(var(--u) * 10); }
  }
  /* the arrows that say "this one cycles": they appear on hover */
  .chev {
    position: absolute;
    bottom: calc(var(--u) * 12);
    color: var(--cyan);
    font-size: calc(var(--u) * 30);
    line-height: 1;
    opacity: 0;
    transition: opacity 240ms ease, translate 320ms var(--ease);
  }
  .chev.l {
    left: calc(var(--u) * 26);
    translate: calc(var(--u) * 10) 0;
  }
  .chev.r {
    right: calc(var(--u) * 26);
    translate: calc(var(--u) * -10) 0;
  }
  .pick:hover .chev,
  .pick:focus-visible .chev {
    opacity: 0.9;
    translate: 0 0;
  }

  /* the loud ones are solid colour: pink to join, blue to host or to enter a code */
  .join,
  .blue {
    --tint: 255 45 125;
    --a: #ff529c;
    --b: #ee1f72;
    position: relative;
    isolation: isolate;
    background:
      linear-gradient(203deg, rgb(255 255 255 / 0.16) 0 13%, transparent 13% 21%, rgb(255 255 255 / 0.09) 21% 29%, transparent 29%),
      linear-gradient(200deg, var(--a), var(--b) 62%);
    box-shadow: 0 0 calc(var(--u) * 26) rgb(var(--tint) / 0.32);
    text-transform: uppercase;
    transition: box-shadow 280ms ease, translate 260ms var(--ease), letter-spacing 400ms var(--ease), scale 160ms ease;
  }
  .join::before,
  .blue::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.3), rgb(255 255 255 / 0.04));
    opacity: 0;
    transition: opacity 280ms ease;
  }
  .join:hover,
  .join:focus-visible,
  .blue:hover,
  .blue:focus-visible {
    box-shadow: 0 0 calc(var(--u) * 48) rgb(var(--tint) / 0.75);
  }
  .blue:hover,
  .blue:focus-visible {
    translate: 0 calc(var(--u) * -3);
  }
  .join:hover::before,
  .join:focus-visible::before,
  .blue:hover::before,
  .blue:focus-visible::before {
    opacity: 1;
  }
  .join {
    min-height: calc(var(--u) * 112);
    border-radius: calc(var(--u) * 14);
    font-size: calc(var(--u) * 56);
    font-weight: 600;
    letter-spacing: 0.03em;
    text-indent: 0.03em;
  }
  .join:hover,
  .join:focus-visible {
    letter-spacing: 0.07em;
  }
  /* our border beam runs round Join: a white light on the pink, quicker on hover */
  .mp :global(.join-beam) {
    --glow-w: calc(var(--u) * 30);
    --glow-blur: calc(var(--u) * 8);
    --line-w: calc(var(--u) * 3.5);
    pointer-events: none;
    transition: translate 260ms var(--ease);
  }
  .mp :global(.join-beam rect) {
    rx: calc(var(--u) * 14);
  }
  .mp :global(.join-beam:hover) {
    translate: 0 calc(var(--u) * -3);
    --beam-duration: 1.6s !important;
  }
  .join[data-state] {
    font-size: calc(var(--u) * 30);
    letter-spacing: 0.03em;
  }
  .join[data-state='busy'] {
    --a: #c93a76;
    --b: #a81c58;
    animation: bsm-busy 900ms ease-in-out infinite;
  }
  .join[data-state='found'] {
    --tint: 40 220 150;
    --a: #36e6a0;
    --b: #0fb57a;
  }
  @keyframes bsm-busy {
    50% { box-shadow: 0 0 calc(var(--u) * 44) rgb(var(--tint) / 0.7); }
  }
  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: calc(var(--u) * 14);
  }
  .blue {
    --tint: 30 150 255;
    --a: #2aa2ff;
    --b: #0f76ea;
    min-height: calc(var(--u) * 78);
    border-radius: calc(var(--u) * 12);
    font-size: calc(var(--u) * 26);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: 0.02em;
  }
  .pressed {
    scale: 0.97;
  }

  /* the bar below */
  .bar {
    grid-area: bar;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: calc(var(--u) * 12);
    transition: translate 1s var(--ease), opacity 700ms ease;
  }
  .bar-btn,
  .ico {
    min-height: calc(var(--u) * 58);
    border-radius: 999px;
    color: rgb(220 240 250 / 0.72);
  }
  .bar-btn {
    display: grid;
    place-items: center;
    flex: none;
    min-width: calc(var(--u) * 170);
    padding: 0 calc(var(--u) * 28);
    font-size: calc(var(--u) * 28);
    letter-spacing: 0.05em;
    text-indent: 0.05em;
    text-align: center;
    text-transform: uppercase;
  }
  .ico {
    display: grid;
    flex: none;
    place-items: center;
    align-self: center; /* a circle: it keeps its own height instead of stretching to the bar's */
    width: calc(var(--u) * 58);
    height: calc(var(--u) * 58);
    padding: 0;
  }
  .ico svg {
    width: calc(var(--u) * 26);
    height: calc(var(--u) * 26);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: scale 260ms var(--ease), rotate 500ms var(--ease);
  }
  .bar-btn:hover,
  .bar-btn:focus-visible,
  .ico:hover,
  .ico:focus-visible {
    color: #fff;
  }
  .ico:hover svg,
  .ico:focus-visible svg {
    scale: 1.14;
  }
  .ico[aria-label='Settings']:hover svg {
    rotate: 60deg;
  }
  /* each icon names itself on hover */
  .ico::before {
    content: attr(aria-label);
    position: absolute;
    top: calc(100% + var(--u) * 10);
    left: 50%;
    color: var(--mute);
    font-size: calc(var(--u) * 17);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0;
    translate: -50% calc(var(--u) * -6);
    transition: opacity 220ms ease, translate 300ms var(--ease);
  }
  .ico:hover::before,
  .ico:focus-visible::before {
    opacity: 1;
    translate: -50% 0;
  }
  .bsm button:focus-visible {
    outline: calc(var(--u) * 2) solid var(--cyan);
    outline-offset: calc(var(--u) * 4);
  }

  /* ---------- the two screens: the packs, and a pack's songs. One leaves into the dark as the other arrives. ---------- */
  .bsm[data-view='songs'] .v-main,
  .bsm:not([data-view='songs']) .v-songs {
    opacity: 0;
    translate: 0 0 calc(var(--u) * -240);
    visibility: hidden;
    transition: translate 500ms var(--ease), opacity 300ms ease, visibility 0s 500ms;
  }

  /* The song screen's three sections are the same size: about 419 wide (the sides reach 40 outward
     past the menu's edge and 73 into the middle column, which gives that up) and one height, each
     with its last row on the bottom line. */
  .v-songs {
    --out: calc(var(--u) * 40);
    --grow: calc(var(--u) * 72.670);
    display: flex;
    flex-direction: column;
    gap: calc(var(--u) * 20);
    min-width: 0; /* long titles must not widen a panel past its column */
    height: calc(var(--u) * 512);
  }
  .v-songs.left {
    margin-left: calc(var(--out) * -1);
    margin-right: calc(var(--grow) * -1);
  }
  .v-songs.mid {
    margin-inline: var(--grow);
  }
  .v-songs.right {
    margin-left: calc(var(--grow) * -1);
    margin-right: calc(var(--out) * -1);
  }
  .v-songs .s-body {
    flex: 1;
    height: auto;
    min-height: 0;
  }
  .v-songs .d-go,
  .v-songs .hs-you {
    margin-top: auto;
  }

  /* songs: back, search, an A to Z rail and the list */
  .s-top {
    display: flex;
    align-items: center;
    gap: calc(var(--u) * 10);
  }
  .s-back {
    display: grid;
    flex: none;
    place-items: center;
    width: calc(var(--u) * 52);
    height: calc(var(--u) * 52);
    padding: 0;
    border-radius: 50%;
  }
  .s-back svg,
  .s-search svg,
  .d-stats svg,
  .d-mode svg,
  .d-mod svg,
  .d-fav svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .s-back svg {
    width: calc(var(--u) * 26);
    height: calc(var(--u) * 26);
  }
  .s-search {
    display: flex;
    flex: 1;
    align-items: center;
    gap: calc(var(--u) * 8);
    min-width: 0;
    height: calc(var(--u) * 52);
    padding: 0 calc(var(--u) * 16);
    border-radius: 99px;
    color: var(--mute);
    cursor: text;
  }
  .s-search svg {
    flex: none;
    width: calc(var(--u) * 22);
    height: calc(var(--u) * 22);
  }
  .s-search input {
    flex: 1;
    min-width: 0;
    padding: calc(var(--u) * 4) 0 0;
    border: 0;
    outline: 0;
    background: none;
    color: var(--ink);
    font: inherit;
    font-size: calc(var(--u) * 24);
  }
  .s-search input::placeholder {
    color: var(--mute);
  }
  .s-search input::-webkit-search-cancel-button {
    display: none;
  }
  .s-pack {
    margin: calc(var(--u) * -6) 0 calc(var(--u) * -8);
    color: var(--mute);
    font-size: calc(var(--u) * 20);
    text-transform: uppercase;
  }
  .s-body {
    display: grid;
    grid-template-columns: calc(var(--u) * 22) minmax(0, 1fr);
    gap: calc(var(--u) * 10);
    height: calc(var(--u) * 400);
  }
  .s-index {
    display: grid;
    align-content: space-between;
    justify-items: center;
  }
  .s-index button {
    padding: 0;
    background: none;
    color: var(--mute);
    font-size: calc(var(--u) * 15);
    line-height: 1;
    opacity: 0.3;
    transition: color 160ms ease, scale 160ms ease;
  }
  .s-index button[data-has] {
    color: var(--ink);
    opacity: 1;
  }
  .s-index button[data-has]:hover {
    color: var(--cyan);
    scale: 1.5;
  }
  .s-list {
    display: grid;
    align-content: start;
    gap: calc(var(--u) * 4);
    padding-right: calc(var(--u) * 6);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: rgb(170 230 255 / 0.3) transparent;
  }
  .song {
    display: grid;
    grid-template-columns: calc(var(--u) * 46) minmax(0, 1fr) auto;
    align-items: center;
    gap: calc(var(--u) * 12);
    padding: calc(var(--u) * 6) calc(var(--u) * 10) calc(var(--u) * 6) calc(var(--u) * 6);
    border-radius: calc(var(--u) * 10);
    background: transparent;
    box-shadow: inset 0 0 0 1px transparent;
    text-align: left;
    transition: background-color 200ms ease, box-shadow 200ms ease;
  }
  .song:hover,
  .song:focus-visible {
    background: var(--glass-h);
    box-shadow: inset 0 0 0 1px var(--line-h);
  }
  .song[aria-selected='true'] {
    background: rgb(27 132 242 / 0.3);
    box-shadow: inset 0 0 0 1px rgb(90 175 255 / 0.9);
  }
  .song-th {
    width: calc(var(--u) * 46);
    height: calc(var(--u) * 46);
    border-radius: calc(var(--u) * 7);
    background: var(--glass-h);
    object-fit: cover;
    object-position: 50% 12%;
  }
  .song-n {
    display: grid;
    gap: calc(var(--u) * 2);
    min-width: 0;
    line-height: 1;
  }
  .song-t {
    overflow: hidden;
    font-size: calc(var(--u) * 24);
    font-weight: 500;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .song-by,
  .song-bpm {
    color: var(--mute);
    font-size: calc(var(--u) * 16);
  }
  .song-m {
    display: grid;
    gap: calc(var(--u) * 2);
    justify-items: end;
    font-size: calc(var(--u) * 21);
    line-height: 1;
  }
  .s-none {
    padding: calc(var(--u) * 20) 0;
    color: var(--mute);
    font-size: calc(var(--u) * 21);
    text-align: center;
  }

  /* the chosen song */
  .v-songs.mid {
    gap: calc(var(--u) * 20);
  }
  .d-head {
    position: relative;
    display: grid;
    gap: calc(var(--u) * 4);
    padding-inline: calc(var(--u) * 40);
    text-align: center;
  }
  .d-title {
    margin: 0;
    font-family: inherit;
    display: -webkit-box;
    overflow: hidden;
    font-size: calc(var(--u) * 42);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: 0.01em;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .d-by {
    color: var(--val);
    font-size: calc(var(--u) * 24);
    line-height: 1;
  }
  .d-fav {
    position: absolute;
    top: 0;
    right: 0;
    display: grid;
    place-items: center;
    width: calc(var(--u) * 40);
    height: calc(var(--u) * 40);
    padding: 0;
    background: none;
    color: var(--mute);
    transition: color 200ms ease, scale 240ms cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  .d-fav svg {
    width: calc(var(--u) * 28);
    height: calc(var(--u) * 28);
  }
  .d-fav:hover {
    color: #fff;
    scale: 1.15;
  }
  .d-fav[aria-pressed='true'] {
    color: #ff4f9a;
  }
  .d-fav[aria-pressed='true'] svg {
    fill: currentColor;
  }
  .d-stats {
    display: flex;
    justify-content: center;
    gap: calc(var(--u) * 15);
    margin: 0;
    padding: 0;
    color: var(--mute);
    font-size: calc(var(--u) * 20);
    list-style: none;
  }
  .d-stats li {
    display: flex;
    align-items: center;
    gap: calc(var(--u) * 6);
  }
  .d-stats svg {
    width: calc(var(--u) * 19);
    height: calc(var(--u) * 19);
  }
  .d-modes {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: calc(var(--u) * 8);
  }
  .d-mode {
    display: grid;
    place-items: center;
    height: calc(var(--u) * 72);
    padding: 0;
    border-radius: calc(var(--u) * 12);
    color: var(--mute);
    font-size: calc(var(--u) * 32);
    font-weight: 600;
  }
  .d-mode svg {
    width: calc(var(--u) * 34);
    height: calc(var(--u) * 34);
    stroke-width: 2;
  }
  .d-mode[aria-checked='true'],
  .seg[aria-checked='true'] {
    background: #1b84f2;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.3), 0 0 calc(var(--u) * 22) rgb(27 132 242 / 0.55);
    color: #fff;
  }
  .d-diffs,
  .hs-tabs {
    display: flex;
    justify-content: center;
    gap: calc(var(--u) * 5);
  }
  .d-diffs .seg {
    flex: 1;
    padding-inline: 0;
    font-size: calc(var(--u) * 18);
  }
  .seg {
    padding: calc(var(--u) * 7) calc(var(--u) * 14) calc(var(--u) * 4);
    border-radius: calc(var(--u) * 8);
    background: rgb(160 225 255 / 0.06);
    color: var(--mute);
    font-size: calc(var(--u) * 20);
    line-height: 1;
    text-transform: uppercase;
    transition: background-color 200ms ease, color 200ms ease, box-shadow 200ms ease;
  }
  .seg:hover:not([aria-checked='true']) {
    background: var(--glass-h);
    color: var(--ink);
  }
  .d-mods {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: calc(var(--u) * 7);
  }
  .d-mod {
    display: grid;
    place-items: center;
    width: calc(var(--u) * 44);
    height: calc(var(--u) * 44);
    padding: 0;
    border-radius: calc(var(--u) * 10);
    color: var(--mute);
  }
  .d-mod svg {
    width: calc(var(--u) * 24);
    height: calc(var(--u) * 24);
  }
  .d-mod[aria-pressed='true'] {
    background: var(--cyan);
    box-shadow: 0 0 calc(var(--u) * 18) rgb(90 205 255 / 0.6);
    color: #06202c;
  }
  .d-mult {
    flex-basis: 100%;
    margin: 0;
    color: var(--mute);
    font-size: calc(var(--u) * 19);
    text-align: center;
  }
  .d-mult b {
    color: var(--cyan);
    font-weight: 500;
  }
  /* a control names itself on hover */
  .d-mode::before,
  .d-mod::before {
    content: attr(data-tip);
    position: absolute;
    bottom: calc(100% + var(--u) * 10);
    left: 50%;
    z-index: 2;
    padding: calc(var(--u) * 7) calc(var(--u) * 12) calc(var(--u) * 5);
    border-radius: calc(var(--u) * 9);
    background: rgb(8 26 46 / 0.94);
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--ink);
    font-size: calc(var(--u) * 18);
    font-weight: 400;
    line-height: 1;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    translate: -50% calc(var(--u) * 6);
    transition: opacity 180ms ease, translate 240ms var(--ease);
  }
  .d-mode:hover::before,
  .d-mode:focus-visible::before,
  .d-mod:hover::before,
  .d-mod:focus-visible::before {
    opacity: 1;
    translate: -50% 0;
  }
  .d-go {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: calc(var(--u) * 14);
  }
  .d-practice {
    overflow: hidden;
    min-height: calc(var(--u) * 78);
    border-radius: calc(var(--u) * 12);
    font-size: calc(var(--u) * 28);
    font-weight: 500;
    text-transform: uppercase;
  }
  .join.d-play {
    min-height: calc(var(--u) * 78);
    border-radius: calc(var(--u) * 12);
    font-size: calc(var(--u) * 42);
  }
  .join.d-play:hover,
  .join.d-play:focus-visible {
    translate: 0 calc(var(--u) * -3);
  }
  .join.d-play[data-state] {
    font-size: calc(var(--u) * 28);
  }

  /* high scores */
  .hs {
    display: grid;
    gap: calc(var(--u) * 1);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hs li {
    display: grid;
    grid-template-columns: calc(var(--u) * 46) minmax(0, 1fr) auto;
    align-items: baseline;
    gap: calc(var(--u) * 8);
    padding: calc(var(--u) * 6) calc(var(--u) * 10) calc(var(--u) * 3);
    border-radius: calc(var(--u) * 8);
    font-size: calc(var(--u) * 23);
    line-height: 1.05;
    transition: background-color 200ms ease, opacity 300ms ease, translate 400ms var(--ease);
    transition-delay: 0s, calc(var(--k) * 30ms), calc(var(--k) * 30ms);
  }
  .hs.swap li {
    opacity: 0;
    translate: calc(var(--u) * 14) 0;
    transition: none;
  }
  .hs li:hover {
    background: var(--glass-h);
  }
  .hs-n {
    color: var(--mute);
  }
  .hs-name {
    overflow: hidden;
    color: var(--cyan);
    font-weight: 500;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .hs li:nth-child(-n + 3) .hs-name {
    color: #fff;
    text-shadow: 0 0 calc(var(--u) * 12) rgb(90 205 255 / 0.8);
  }
  .hs li.me {
    background: rgb(27 132 242 / 0.25);
    box-shadow: inset 0 0 0 1px rgb(90 175 255 / 0.7);
  }
  .hs-s {
    font-variant-numeric: tabular-nums;
  }
  .hs-you {
    display: flex;
    justify-content: space-between;
    margin: 0;
    padding-top: calc(var(--u) * 12);
    border-top: 1px solid var(--line);
    color: var(--mute);
    font-size: calc(var(--u) * 19);
  }
  .hs-you b {
    margin-left: calc(var(--u) * 6);
    color: var(--ink);
    font-weight: 500;
  }

  /* ---------- the music pack pass: a blue band under the menu, bent like the panels above it ---------- */
