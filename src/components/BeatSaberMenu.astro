---
/**
 * The Beat Saber main menu, rebuilt as a live panel that hangs in the page's space: Challenges on
 * the left, the music packs in the middle, Multiplayer on the right, and the bar below. It has no
 * backdrop of its own: every control is glass, a barely-there fill with a hairline edge and thin
 * type, and colour and light arrive on hover. The side panels curve toward the viewer like the
 * game's menu around the player; the whole menu floats, leans a little with the pointer, and a soft
 * laser dot follows the pointer over it.
 *
 * Everything works: challenge timers count down, the pack pages turn, a pack can be picked, the
 * multiplayer pack and difficulty cycle, and Join looks for a lobby.
 *
 * Album art goes in public/cases/beat-saber/albums/, named as `img` on each pack below: square covers
 * for albums, tall ones (about 9:16) for banners. A tile whose file is missing shows a placeholder in
 * the pack's colours.
 */
import '@fontsource-variable/teko';
import BorderBeam from './effects/BorderBeam.astro';

interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const albumSrc = (f: string) => `${base}/cases/beat-saber/albums/${f}`;

type Album = { title: string; sub?: string; img?: string; tall?: boolean; look: string };
const blank = (n: number): Album => ({ title: `Pack ${n}`, look: 'blank' });
// a page is four columns, three rows: square albums on top, banners two rows tall below,
// in the game's arrangement (two squares stack in the gap between banners)
const pages: Album[][] = [
  [
    { title: 'Daft Punk', img: 'daft-punk.webp', look: 'ost-b' },
    { title: 'Lady Gaga', sub: 'Music Pack', img: 'lady-gaga.webp', look: 'magenta' },
    { title: 'Imagine Dragons', sub: 'Music Pack', img: 'imagine-dragons.webp', look: 'ost-c' },
    { title: 'Britney Spears', img: 'britney-spears.webp', look: 'violet' },
    { title: 'TinyTAN', img: 'tinytan.webp', tall: true, look: 'magenta' },
    { title: 'Skrillex', sub: 'Music Pack', img: 'skrillex.webp', look: 'teal' },
    { title: 'Linkin Park', sub: 'Music Pack', img: 'linkin-park.webp', tall: true, look: 'ash' },
    { title: 'Monstercat', sub: 'Music Pack Vol. 1', img: 'monstercat.webp', tall: true, look: 'cat' },
    { title: 'Rocket League', sub: '× Monstercat', img: 'rocket-league.webp', look: 'cat' },
  ],
  [
    { title: 'OST', sub: 'Vol. 1', look: 'ost-a' },
    { title: 'OST', sub: 'Vol. 2', look: 'ost-b' },
    { title: 'OST', sub: 'Vol. 3', look: 'ost-c' },
    { title: 'Volume Four', sub: 'Beat Saber', look: 'cube' },
    { title: 'Camellia', look: 'teal' },
    { title: 'Extras', look: 'violet' },
    ...Array.from({ length: 6 }, (_, i) => blank(16 + i)),
  ],
  Array.from({ length: 12 }, (_, i) => blank(22 + i)),
  Array.from({ length: 12 }, (_, i) => blank(34 + i)),
];

const challenges = [
  { t: 'Clear 20 songs', note: '(5 remaining)', mins: 6 * 24 * 60 + 5 * 60, xp: '+1.5K XP', done: 15, of: 20 },
  { t: 'Clear any song with no arrows modifier', mins: 85, xp: '+1.5K XP', card: true, done: 0, of: 1 },
];
const nextChallengeMins = 2 * 60 + 34;
const packs = ['Any', ...new Set(pages[0].map((a) => (a.sub && a.title === 'OST' ? `${a.title} ${a.sub}` : a.title)))];
const difficulties = ['Easy', 'Normal', 'Hard', 'Expert', 'Expert+'];
---

<div class:list={['bsm', cls]} data-bsm role="group" aria-label="Beat Saber main menu, interactive">
  <div class="bsm-float">
    <div class="bsm-scene" data-scene>
      <!-- challenges -->
      <section class="bsm-panel left" aria-labelledby="bsm-ch">
        <h3 id="bsm-ch" class="bsm-h">Challenges</h3>
        <ul class="bsm-list" role="list">
          {challenges.map((c) => (
            <li>
              <button type="button" class:list={['ch', c.card && 'stack']} data-ch style={`--p:${c.done / c.of}`} aria-label={`${c.t}, ${c.done} of ${c.of} done`}>
                <span class="ch-t">{c.t} {c.note && <span class="ch-note">{c.note}</span>}</span>
                <span class="ch-foot">
                  <span class="ch-time"><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="7.5" /><path d="M10 6v4.2l2.6 1.6" /></svg><span data-left={c.mins}></span></span>
                  <span class="ch-xp">{c.card && <span class="ch-plus">+<i class="ch-card" aria-hidden="true"></i></span>}{c.xp}</span>
                </span>
                <span class="ch-bar" aria-hidden="true"><i></i></span>
              </button>
            </li>
          ))}
          <li>
            <div class="ch next" aria-live="polite">new challenge in<br /><span data-left={nextChallengeMins}></span></div>
          </li>
        </ul>
      </section>

      <!-- singleplayer -->
      <section class="bsm-panel mid" aria-labelledby="bsm-sp">
        <h3 id="bsm-sp" class="bsm-h">Singleplayer</h3>
        <div class="packs" data-packs>
          <div class="pages" data-pages>
            {pages.map((page, pi) => (
              <div class="page" data-page={pi} aria-hidden={pi === 0 ? undefined : 'true'}>
                {page.map((a) => (
                  <button type="button" class:list={['tile', a.tall && 'tall', `look-${a.look}`]} data-tile tabindex={pi === 0 ? undefined : -1} aria-label={[a.title, a.sub].filter(Boolean).join(' ')}>
                    <span class:list={['art', a.title.length > 9 && 'long']} aria-hidden="true">
                      <span class="art-t">{a.title}</span>
                      {a.sub && <span class="art-s">{a.sub}</span>}
                    </span>
                    {a.img && <img src={albumSrc(a.img)} alt="" loading="lazy" decoding="async" onerror="this.remove()" />}
                  </button>
                ))}
              </div>
            ))}
          </div>
        </div>
        <div class="dots" role="tablist" aria-label="Pack pages">
          {pages.map((_, i) => (
            <button type="button" role="tab" data-dot={i} aria-selected={i === 0 ? 'true' : 'false'} aria-label={`Page ${i + 1}`}></button>
          ))}
        </div>
      </section>

      <!-- multiplayer -->
      <section class="bsm-panel right" aria-labelledby="bsm-mp">
        <h3 id="bsm-mp" class="bsm-h">Multiplayer</h3>
        <div class="mp">
          <button type="button" class="pick" data-cycle={JSON.stringify(packs)} data-i="0">
            <span class="chev l" aria-hidden="true">‹</span><span class="chev r" aria-hidden="true">›</span>
            <span class="pick-l">Music Pack</span>
            <span class="pick-v" data-v>{packs[0]}</span>
          </button>
          <button type="button" class="pick" data-cycle={JSON.stringify(difficulties)} data-i="3">
            <span class="chev l" aria-hidden="true">‹</span><span class="chev r" aria-hidden="true">›</span>
            <span class="pick-l">Difficulty</span>
            <span class="pick-v" data-v>{difficulties[3]}</span>
          </button>
          <BorderBeam class="join-beam" variant="mono" size="sm" strength={0.95} duration={3.2} radius="calc(var(--u) * 14)" fill>
            <button type="button" class="join" data-join><span data-join-t>Join</span></button>
          </BorderBeam>
          <div class="pair">
            <button type="button" class="blue" data-press>Create<br />Server</button>
            <button type="button" class="blue" data-press>Join with<br />Code</button>
          </div>
        </div>
      </section>

      <!-- the bar below -->
      <nav class="bar" aria-label="Menu bar">
        <button type="button" class="bar-btn" data-press>Party</button>
        <button type="button" class="bar-btn" data-press>Campaign</button>
        <button type="button" class="ico" data-press aria-label="Settings">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3.2" /><path d="M12 2.8v2.4M12 18.8v2.4M2.8 12h2.4M18.8 12h2.4M5.5 5.5l1.7 1.7M16.8 16.8l1.7 1.7M5.5 18.5l1.7-1.7M16.8 7.2l1.7-1.7" /><circle cx="12" cy="12" r="6.6" /></svg>
        </button>
        <button type="button" class="ico" data-press aria-label="Help">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8.6 8.4a3.6 3.6 0 1 1 5.2 3.2c-1.1.6-1.8 1.3-1.8 2.6v.6" /><circle cx="12" cy="18.6" r="0.6" /></svg>
        </button>
        <button type="button" class="ico" data-press aria-label="Edit avatar">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 13.5V19a1.5 1.5 0 0 1-1.5 1.5h-12A1.5 1.5 0 0 1 4 19V7a1.5 1.5 0 0 1 1.5-1.5H11" /><path d="M17.2 3.8l3 3L12 15l-3.6.6.6-3.6z" /></svg>
        </button>
        <button type="button" class="ico" data-press aria-label="Exit">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4h4.5A1.5 1.5 0 0 1 20 5.5v13a1.5 1.5 0 0 1-1.5 1.5H14" /><path d="M4 12h10M10 8l4 4-4 4" /></svg>
        </button>
      </nav>
    </div>
  </div>
  <i class="laser" aria-hidden="true" data-laser></i>
</div>

<style>
  /* sizes are in design pixels at a 1320 px wide menu (--u), so the whole menu scales as one.
     The look: glass. Barely-there fills, hairline edges, thin type; colour and light arrive on hover. */
  .bsm {
    --cyan: #9be9ff;
    --val: #4cc9ff;
    --ink: #eef9ff;
    --mute: rgb(205 232 245 / 0.5);
    --glass: rgb(150 220 255 / 0.05);
    --glass-h: rgb(150 220 255 / 0.12);
    --line: rgb(170 230 255 / 0.16);
    --line-h: rgb(195 242 255 / 0.75);
    --ease: cubic-bezier(0.2, 0.8, 0.2, 1);
    position: relative;
    width: min(100%, 1240px);
    margin-inline: auto;
    container-type: inline-size;
    perspective: 1700px;
    font-family: 'Teko Variable', 'Teko', var(--font-display), sans-serif;
    font-style: italic; /* the game's type leans, everywhere */
    font-weight: 400;
    color: var(--ink);
    -webkit-tap-highlight-color: transparent;
  }
  .bsm-float {
    transform-style: preserve-3d;
    animation: bsm-float 7s ease-in-out infinite;
  }
  @keyframes bsm-float {
    50% { translate: 0 -8px; }
  }
  .bsm-scene {
    --u: calc(100cqw / 1320);
    display: grid;
    grid-template-columns: 306fr 564fr 306fr;
    grid-template-areas: 'l m r' '. bar .';
    column-gap: calc(var(--u) * 72);
    row-gap: calc(var(--u) * 34);
    padding-inline: calc(var(--u) * 22);
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transform-style: preserve-3d;
  }
  button {
    font: inherit;
    color: inherit;
    border: 0;
    cursor: pointer;
  }
  /* in the 3D scene the layout layers can sit over the buttons for the hit test: only buttons take the pointer */
  .bsm-float,
  .bsm-scene,
  .bsm-scene * {
    pointer-events: none;
  }
  .bsm-scene button {
    pointer-events: auto;
  }
  .bsm-scene button * {
    pointer-events: none;
  }

  /* panels: the sides curve toward the viewer, the way the menu wraps around the player */
  .bsm-panel {
    display: grid;
    align-content: start;
    gap: calc(var(--u) * 24);
    transform-style: preserve-3d;
    transition: translate 1s var(--ease), opacity 700ms ease;
  }
  .left {
    grid-area: l;
    transform-origin: right center;
    transform: rotateY(16deg);
  }
  .mid {
    grid-area: m;
  }
  .right {
    grid-area: r;
    transform-origin: left center;
    transform: rotateY(-16deg);
  }
  .bsm:not(.on) .bsm-panel,
  .bsm:not(.on) .bar {
    opacity: 0;
    translate: 0 calc(var(--u) * 30) calc(var(--u) * -260);
  }
  .bsm.on .left { transition-delay: 120ms; }
  .bsm.on .right { transition-delay: 240ms; }
  .bsm.on .bar { transition-delay: 360ms; }
  .bsm-h {
    margin: 0;
    color: var(--mute);
    font-size: calc(var(--u) * 28);
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.22em;
    text-indent: 0.22em;
    text-align: center;
    text-transform: uppercase;
  }
  .bsm-h::after {
    content: '';
    display: block;
    width: calc(var(--u) * 44);
    height: 1px;
    margin: calc(var(--u) * 12) auto 0;
    background: linear-gradient(90deg, transparent, var(--cyan), transparent);
    opacity: 0.7;
  }

  /* glass: the shared surface of every quiet control */
  .ch,
  .pick,
  .bar-btn,
  .ico {
    position: relative;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.05), transparent 46%), var(--glass);
    box-shadow: inset 0 0 0 1px var(--line);
    transition: background-color 260ms ease, box-shadow 260ms ease, translate 260ms var(--ease), color 200ms ease, scale 160ms ease;
  }
  button.ch:hover,
  button.ch:focus-visible,
  .pick:hover,
  .pick:focus-visible,
  .bar-btn:hover,
  .bar-btn:focus-visible,
  .ico:hover,
  .ico:focus-visible {
    background-color: var(--glass-h);
    box-shadow: inset 0 0 0 1px var(--line-h), 0 0 calc(var(--u) * 28) rgb(70 195 255 / 0.22);
    translate: 0 calc(var(--u) * -3);
  }
  /* a line of light that crosses a control as the pointer arrives */
  button.ch,
  .pick,
  .bar-btn,
  .join,
  .blue,
  .tile {
    overflow: hidden;
  }
  button.ch::after,
  .pick::after,
  .bar-btn::after,
  .join::after,
  .blue::after,
  .tile::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 36%, rgb(255 255 255 / 0.18) 50%, transparent 64%);
    translate: -120% 0;
  }
  button.ch:hover::after,
  .pick:hover::after,
  .bar-btn:hover::after,
  .join:hover::after,
  .blue:hover::after,
  .tile:hover::after {
    translate: 120% 0;
    transition: translate 800ms var(--ease);
  }

  /* challenges */
  .bsm-list {
    display: grid;
    gap: calc(var(--u) * 18);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ch {
    display: grid;
    align-content: space-between;
    width: 100%;
    min-height: calc(var(--u) * 124);
    padding: calc(var(--u) * 14) calc(var(--u) * 18) calc(var(--u) * 14);
    border-radius: calc(var(--u) * 14);
    text-align: left;
  }
  .ch.stack {
    box-shadow: inset 0 0 0 1px var(--line), calc(var(--u) * -8) 0 0 calc(var(--u) * -3) rgb(150 220 255 / 0.07), calc(var(--u) * -15) 0 0 calc(var(--u) * -6) rgb(150 220 255 / 0.04);
  }
  .ch-t {
    font-size: calc(var(--u) * 24);
    line-height: 1.02;
    letter-spacing: 0.02em;
  }
  .ch-note {
    margin-left: calc(var(--u) * 6);
    color: var(--mute);
  }
  .ch-foot {
    display: flex;
    align-items: end;
    justify-content: space-between;
    margin-top: calc(var(--u) * 12);
  }
  .ch-time {
    display: flex;
    align-items: center;
    gap: calc(var(--u) * 7);
    color: var(--mute);
    font-size: calc(var(--u) * 21);
    letter-spacing: 0.04em;
  }
  .ch-time svg {
    width: calc(var(--u) * 18);
    height: calc(var(--u) * 18);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
  }
  .ch-xp {
    display: flex;
    align-items: center;
    gap: calc(var(--u) * 9);
    color: var(--cyan);
    font-size: calc(var(--u) * 26);
    font-weight: 500;
    letter-spacing: 0.03em;
    transition: text-shadow 260ms ease;
  }
  .ch:hover .ch-xp,
  .ch:focus-visible .ch-xp {
    text-shadow: 0 0 calc(var(--u) * 14) rgb(90 205 255 / 0.9);
  }
  .ch-plus {
    display: flex;
    align-items: center;
    gap: calc(var(--u) * 5);
    color: var(--ink);
  }
  .ch-card {
    width: calc(var(--u) * 15);
    height: calc(var(--u) * 22);
    border-radius: calc(var(--u) * 3);
    background: linear-gradient(160deg, #f2f6f9, #a3b0b9);
    transform: skewX(-8deg);
  }
  .ch-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: calc(var(--u) * 3);
    background: rgb(150 225 255 / 0.1);
    opacity: 0;
    transition: opacity 260ms ease;
  }
  .ch-bar i {
    display: block;
    width: 0;
    height: 100%;
    background: linear-gradient(90deg, var(--val), var(--cyan));
    box-shadow: 0 0 8px var(--val);
    transition: width 700ms var(--ease) 80ms;
  }
  .ch:hover .ch-bar,
  .ch:focus-visible .ch-bar {
    opacity: 1;
  }
  .ch:hover .ch-bar i,
  .ch:focus-visible .ch-bar i {
    width: calc(var(--p) * 100%);
  }
  .ch.next {
    display: grid;
    place-content: center;
    color: rgb(205 232 245 / 0.32);
    background: none;
    box-shadow: none;
    border: 1px dashed rgb(170 230 255 / 0.16);
    font-size: calc(var(--u) * 22);
    line-height: 1.1;
    letter-spacing: 0.1em;
    text-align: center;
    text-transform: uppercase;
  }

  /* singleplayer: the pack wall, in pages */
  .packs {
    overflow: hidden;
    margin: calc(var(--u) * -16);
    padding: calc(var(--u) * 16);
  }
  .pages {
    display: flex;
    transition: translate 600ms cubic-bezier(0.3, 0.8, 0.2, 1);
    translate: calc(var(--page, 0) * (-100% - var(--u) * 32)) 0;
    gap: calc(var(--u) * 32);
  }
  .page {
    display: grid;
    flex: 0 0 100%;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: calc(var(--u) * 129); /* (564 - 3 gaps) / 4: square cells */
    gap: calc(var(--u) * 16);
  }
  .tile {
    --c: #8fdcff;
    position: relative;
    padding: 0;
    border-radius: calc(var(--u) * 12);
    background: radial-gradient(120% 80% at 50% 118%, color-mix(in srgb, var(--c) 40%, transparent), transparent 72%), var(--glass);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--c) 30%, transparent);
    transition: scale 280ms cubic-bezier(0.3, 1.3, 0.5, 1), box-shadow 240ms ease, opacity 240ms ease;
  }
  .tile.tall {
    grid-row: span 2;
  }
  /* covers carry their own rounded corners: the tile clips just outside them */
  .tile:has(img) {
    background: none;
    box-shadow: none;
  }
  .tile:has(img) .art {
    opacity: 0;
  }
  .tile img {
    position: absolute;
    inset: -1%;
    width: 102%;
    height: 102%;
    object-fit: cover;
  }
  /* banner art is a little wider than the slot: ease it in, part squeezed, part cropped */
  .tile.tall img {
    inset: 0 auto 0 -6%;
    width: 112%;
    height: 100%;
    object-fit: fill;
  }
  /* hover: the cover comes forward and the rest of the wall steps back */
  .tile:hover,
  .tile:focus-visible {
    z-index: 1;
    scale: 1.07;
    outline: none;
    box-shadow: 0 0 0 calc(var(--u) * 1.5) rgb(255 255 255 / 0.9), 0 0 calc(var(--u) * 34) rgb(80 200 255 / 0.5), 0 calc(var(--u) * 16) calc(var(--u) * 30) rgb(0 0 0 / 0.4);
  }
  .page:has(.tile:hover) .tile:not(:hover) {
    opacity: 0.5;
  }
  .tile[aria-pressed='true'] {
    box-shadow: 0 0 0 calc(var(--u) * 2) var(--cyan), 0 0 calc(var(--u) * 30) rgb(80 200 255 / 0.55);
  }
  .tile[aria-pressed='true']::before {
    content: '✓';
    position: absolute;
    top: calc(var(--u) * 8);
    right: calc(var(--u) * 8);
    z-index: 1;
    display: grid;
    place-items: center;
    width: calc(var(--u) * 26);
    height: calc(var(--u) * 26);
    border-radius: 50%;
    background: var(--cyan);
    color: #06202c;
    font: normal 700 calc(var(--u) * 15) / 1 var(--font-ui);
    box-shadow: 0 0 calc(var(--u) * 12) rgb(80 200 255 / 0.8);
  }
  .art {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    padding: calc(var(--u) * 8);
    text-align: center;
    line-height: 0.95;
    text-transform: uppercase;
  }
  .art-t {
    color: color-mix(in srgb, var(--c) 45%, white);
    font-size: calc(var(--u) * 30);
    font-weight: 500;
    letter-spacing: 0.06em;
  }
  .art.long .art-t {
    font-size: calc(var(--u) * 21);
  }
  .art-s {
    margin-top: calc(var(--u) * 6);
    color: var(--mute);
    font-size: calc(var(--u) * 16);
    letter-spacing: 0.14em;
  }
  /* placeholder tints, until a pack's art arrives */
  .look-ost-a { --c: #2f8fff; }
  .look-ost-b { --c: #ff3a4c; }
  .look-ost-c { --c: #4f6dff; }
  .look-cube { --c: #ff3355; }
  .look-magenta { --c: #ff3fa0; }
  .look-teal { --c: #2ad0d8; }
  .look-ash { --c: #d2ccc5; }
  .look-cat { --c: #3b8cff; }
  .look-violet { --c: #b866ff; }
  .look-blank {
    background: var(--glass);
    box-shadow: inset 0 0 0 1px rgb(170 230 255 / 0.1);
  }
  .look-blank .art {
    opacity: 0.4;
  }
  .look-blank .art-t {
    font-size: calc(var(--u) * 18);
    font-weight: 400;
    letter-spacing: 0.14em;
  }
  .dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: calc(var(--u) * 12);
    margin-top: calc(var(--u) * 4);
  }
  .dots button {
    position: relative;
    width: calc(var(--u) * 9);
    height: calc(var(--u) * 9);
    padding: 0;
    border-radius: 999px;
    background: rgb(205 232 245 / 0.28);
    transition: width 320ms var(--ease), background-color 220ms ease, box-shadow 220ms ease;
  }
  .dots button::before {
    content: '';
    position: absolute;
    inset: calc(var(--u) * -10) calc(var(--u) * -6);
  }
  .dots button:hover {
    background: rgb(205 232 245 / 0.7);
  }
  .dots button[aria-selected='true'] {
    width: calc(var(--u) * 30);
    background: var(--cyan);
    box-shadow: 0 0 calc(var(--u) * 10) rgb(90 205 255 / 0.8);
  }

  /* multiplayer */
  .mp {
    display: grid;
    gap: calc(var(--u) * 14);
  }
  .pick {
    display: grid;
    gap: calc(var(--u) * 4);
    padding: calc(var(--u) * 14) 0 calc(var(--u) * 11);
    border-radius: calc(var(--u) * 14);
    line-height: 1;
  }
  .pick-l {
    color: var(--mute);
    font-size: calc(var(--u) * 19);
    letter-spacing: 0.2em;
    text-indent: 0.2em;
    text-transform: uppercase;
  }
  .pick-v {
    color: var(--val);
    font-size: calc(var(--u) * 30);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: text-shadow 260ms ease, color 260ms ease;
  }
  .pick:hover .pick-v,
  .pick:focus-visible .pick-v {
    color: var(--cyan);
    text-shadow: 0 0 calc(var(--u) * 14) rgb(76 201 255 / 0.9);
  }
  .pick-v.flip {
    animation: bsm-flip 280ms var(--ease);
  }
  @keyframes bsm-flip {
    from { opacity: 0; translate: 0 calc(var(--u) * 10); }
  }
  /* the arrows that say "this one cycles": they appear on hover */
  .chev {
    position: absolute;
    bottom: calc(var(--u) * 12);
    color: var(--cyan);
    font-size: calc(var(--u) * 30);
    line-height: 1;
    opacity: 0;
    transition: opacity 240ms ease, translate 320ms var(--ease);
  }
  .chev.l {
    left: calc(var(--u) * 26);
    translate: calc(var(--u) * 10) 0;
  }
  .chev.r {
    right: calc(var(--u) * 26);
    translate: calc(var(--u) * -10) 0;
  }
  .pick:hover .chev,
  .pick:focus-visible .chev {
    opacity: 0.9;
    translate: 0 0;
  }

  /* the loud ones are solid colour: pink to join, blue to host or to enter a code */
  .join,
  .blue {
    --tint: 255 45 125;
    --a: #ff529c;
    --b: #ee1f72;
    position: relative;
    isolation: isolate;
    background:
      linear-gradient(203deg, rgb(255 255 255 / 0.16) 0 13%, transparent 13% 21%, rgb(255 255 255 / 0.09) 21% 29%, transparent 29%),
      linear-gradient(200deg, var(--a), var(--b) 62%);
    box-shadow: 0 0 calc(var(--u) * 26) rgb(var(--tint) / 0.32);
    text-transform: uppercase;
    transition: box-shadow 280ms ease, translate 260ms var(--ease), letter-spacing 400ms var(--ease), scale 160ms ease;
  }
  .join::before,
  .blue::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.3), rgb(255 255 255 / 0.04));
    opacity: 0;
    transition: opacity 280ms ease;
  }
  .join:hover,
  .join:focus-visible,
  .blue:hover,
  .blue:focus-visible {
    box-shadow: 0 0 calc(var(--u) * 48) rgb(var(--tint) / 0.75);
  }
  .blue:hover,
  .blue:focus-visible {
    translate: 0 calc(var(--u) * -3);
  }
  .join:hover::before,
  .join:focus-visible::before,
  .blue:hover::before,
  .blue:focus-visible::before {
    opacity: 1;
  }
  .join {
    min-height: calc(var(--u) * 112);
    border-radius: calc(var(--u) * 14);
    font-size: calc(var(--u) * 56);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-indent: 0.06em;
  }
  .join:hover,
  .join:focus-visible {
    letter-spacing: 0.14em;
  }
  /* our border beam runs round Join: a white light on the pink, quicker on hover */
  .mp :global(.join-beam) {
    --glow-w: calc(var(--u) * 30);
    --glow-blur: calc(var(--u) * 8);
    --line-w: calc(var(--u) * 3.5);
    pointer-events: none;
    transition: translate 260ms var(--ease);
  }
  .mp :global(.join-beam rect) {
    rx: calc(var(--u) * 14);
  }
  .mp :global(.join-beam:hover) {
    translate: 0 calc(var(--u) * -3);
    --beam-duration: 1.6s !important;
  }
  .join[data-state] {
    font-size: calc(var(--u) * 30);
    letter-spacing: 0.06em;
  }
  .join[data-state='busy'] {
    --a: #c93a76;
    --b: #a81c58;
    animation: bsm-busy 900ms ease-in-out infinite;
  }
  .join[data-state='found'] {
    --tint: 40 220 150;
    --a: #36e6a0;
    --b: #0fb57a;
  }
  @keyframes bsm-busy {
    50% { box-shadow: 0 0 calc(var(--u) * 44) rgb(var(--tint) / 0.7); }
  }
  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: calc(var(--u) * 14);
  }
  .blue {
    --tint: 30 150 255;
    --a: #2aa2ff;
    --b: #0f76ea;
    min-height: calc(var(--u) * 78);
    border-radius: calc(var(--u) * 12);
    font-size: calc(var(--u) * 26);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: 0.05em;
  }
  .pressed {
    scale: 0.97;
  }

  /* the bar below */
  .bar {
    grid-area: bar;
    display: flex;
    justify-content: center;
    gap: calc(var(--u) * 12);
    transition: translate 1s var(--ease), opacity 700ms ease;
  }
  .bar-btn,
  .ico {
    min-height: calc(var(--u) * 58);
    border-radius: 999px;
    color: rgb(220 240 250 / 0.72);
  }
  .bar-btn {
    display: grid;
    place-items: center;
    min-width: calc(var(--u) * 170);
    padding: 0 calc(var(--u) * 28);
    font-size: calc(var(--u) * 26);
    letter-spacing: 0.16em;
    text-indent: 0.16em;
    text-align: center;
    text-transform: uppercase;
  }
  .ico {
    display: grid;
    place-items: center;
    width: calc(var(--u) * 58);
    padding: 0;
  }
  .ico svg {
    width: calc(var(--u) * 26);
    height: calc(var(--u) * 26);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: scale 260ms var(--ease), rotate 500ms var(--ease);
  }
  .bar-btn:hover,
  .bar-btn:focus-visible,
  .ico:hover,
  .ico:focus-visible {
    color: #fff;
  }
  .ico:hover svg,
  .ico:focus-visible svg {
    scale: 1.14;
  }
  .ico[aria-label='Settings']:hover svg {
    rotate: 60deg;
  }
  /* each icon names itself on hover */
  .ico::before {
    content: attr(aria-label);
    position: absolute;
    top: calc(100% + var(--u) * 10);
    left: 50%;
    color: var(--mute);
    font-size: calc(var(--u) * 17);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0;
    translate: -50% calc(var(--u) * -6);
    transition: opacity 220ms ease, translate 300ms var(--ease);
  }
  .ico:hover::before,
  .ico:focus-visible::before {
    opacity: 1;
    translate: -50% 0;
  }
  .bsm button:focus-visible {
    outline: calc(var(--u) * 2) solid var(--cyan);
    outline-offset: calc(var(--u) * 4);
  }

  /* the laser dot that follows the pointer over the menu */
  .laser {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    width: 10px;
    height: 10px;
    margin: -5px 0 0 -5px;
    border-radius: 50%;
    background: radial-gradient(circle, #fff 0 24%, rgb(155 233 255 / 0.9) 34%, rgb(60 190 255 / 0) 72%);
    box-shadow: 0 0 14px 3px rgb(60 190 255 / 0.5);
    opacity: 0;
    pointer-events: none;
    transition: opacity 200ms ease;
  }
  .bsm.aim .laser {
    opacity: 1;
  }

  /* narrow screens: one column, flat, the packs first */
  @container (max-width: 760px) {
    .bsm-scene {
      --u: calc(100cqw / 640);
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'm' 'r' 'l' 'bar';
      row-gap: calc(var(--u) * 52);
      transform: none;
    }
    .left,
    .right {
      transform: none;
    }
    .bar {
      flex-wrap: wrap;
      row-gap: calc(var(--u) * 16);
    }
  }
  @media (hover: none) {
    .page:has(.tile:hover) .tile:not(:hover) {
      opacity: 1;
    }
    .ico::before {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bsm-float,
    .join[data-state='busy'] {
      animation: none;
    }
    .bsm-panel,
    .bar,
    .pages,
    .tile,
    .ch-bar i {
      transition: none;
    }
    button.ch::after,
    .pick::after,
    .bar-btn::after,
    .join::after,
    .blue::after,
    .tile::after {
      display: none;
    }
  }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-bsm]').forEach((menu) => {
    const scene = menu.querySelector<HTMLElement>('[data-scene]')!;
    const laser = menu.querySelector<HTMLElement>('[data-laser]')!;

    // it boots in once it is on screen, or, when the page opens veiled, as the veil lifts
    const root = document.documentElement;
    const boot = () => requestAnimationFrame(() => menu.classList.add('on'));
    if (root.hasAttribute('data-veil')) {
      new MutationObserver((_, mo) => {
        if (!root.hasAttribute('data-revealing')) return;
        mo.disconnect();
        setTimeout(boot, 850);
      }).observe(root, { attributes: true, attributeFilter: ['data-revealing'] });
    } else {
      new IntersectionObserver((es, io) => {
        if (!es.some((e) => e.isIntersecting)) return;
        io.disconnect();
        boot();
      }, { threshold: 0.15 }).observe(menu);
    }

    // challenge timers count down
    const fmt = (m: number) => {
      m = Math.max(0, Math.round(m));
      const d = Math.floor(m / 1440), h = Math.floor((m % 1440) / 60), mm = m % 60;
      return d ? `${d}d ${h}h` : h ? `${h}h ${mm}m` : `${mm}m`;
    };
    const t0 = Date.now();
    const timers = [...menu.querySelectorAll<HTMLElement>('[data-left]')].map((el) => ({ el, mins: Number(el.dataset.left) }));
    const tick = () => { const gone = (Date.now() - t0) / 60000; for (const t of timers) t.el.textContent = fmt(t.mins - gone); };
    tick();
    setInterval(tick, 15000);

    // pack pages, and picking a pack
    const pages = menu.querySelector<HTMLElement>('[data-pages]')!;
    const dots = [...menu.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const pageEls = [...menu.querySelectorAll<HTMLElement>('[data-page]')];
    const goPage = (i: number) => {
      pages.style.setProperty('--page', String(i));
      dots.forEach((d, j) => d.setAttribute('aria-selected', String(j === i)));
      pageEls.forEach((p, j) => {
        p.toggleAttribute('aria-hidden', j !== i);
        p.querySelectorAll<HTMLElement>('[data-tile]').forEach((t) => (t.tabIndex = j === i ? 0 : -1));
      });
    };
    dots.forEach((d, i) => d.addEventListener('click', () => goPage(i)));
    let page = 0;
    menu.querySelector('[data-packs]')!.addEventListener('wheel', (e) => {
      const we = e as WheelEvent;
      if (Math.abs(we.deltaX) < 20) return;
      page = Math.max(0, Math.min(dots.length - 1, page + Math.sign(we.deltaX)));
      goPage(page);
    }, { passive: true });
    dots.forEach((d, i) => d.addEventListener('click', () => { page = i; }));
    const tiles = [...menu.querySelectorAll<HTMLButtonElement>('[data-tile]')];
    tiles.forEach((t) => t.addEventListener('click', () => {
      const on = t.getAttribute('aria-pressed') !== 'true';
      tiles.forEach((x) => x.removeAttribute('aria-pressed'));
      if (on) t.setAttribute('aria-pressed', 'true');
    }));

    // the multiplayer pickers cycle through their values
    menu.querySelectorAll<HTMLButtonElement>('[data-cycle]').forEach((b) => {
      const vals: string[] = JSON.parse(b.dataset.cycle!);
      const v = b.querySelector<HTMLElement>('[data-v]')!;
      b.addEventListener('click', () => {
        const i = (Number(b.dataset.i) + 1) % vals.length;
        b.dataset.i = String(i);
        v.textContent = vals[i];
        v.classList.remove('flip');
        void v.offsetWidth;
        v.classList.add('flip');
      });
    });

    // Join looks for a lobby
    const join = menu.querySelector<HTMLButtonElement>('[data-join]')!;
    const jt = menu.querySelector<HTMLElement>('[data-join-t]')!;
    let busy = false;
    join.addEventListener('click', () => {
      if (busy) return;
      busy = true;
      join.dataset.state = 'busy';
      let n = 0;
      const dotsT = setInterval(() => { jt.textContent = 'Finding lobby' + '.'.repeat(n++ % 4); }, 300);
      setTimeout(() => {
        clearInterval(dotsT);
        join.dataset.state = 'found';
        jt.textContent = 'Lobby found';
        setTimeout(() => { join.removeAttribute('data-state'); jt.textContent = 'Join'; busy = false; }, 1600);
      }, 2200);
    });

    // a press on everything else
    menu.querySelectorAll<HTMLElement>('[data-press], [data-join], [data-cycle]').forEach((b) => {
      b.addEventListener('pointerdown', () => b.classList.add('pressed'));
      const up = () => b.classList.remove('pressed');
      b.addEventListener('pointerup', up);
      b.addEventListener('pointerleave', up);
    });

    // the menu leans a little toward the pointer, and the laser dot follows it over the menu
    if (reduce) return;
    let tx = 0, ty = 0, x = 0, y = 0, raf = 0, visible = true;
    const loop = () => {
      x += (tx - x) * 0.08;
      y += (ty - y) * 0.08;
      scene.style.setProperty('--ry', `${(x * 5).toFixed(3)}deg`);
      scene.style.setProperty('--rx', `${(-y * 3.5).toFixed(3)}deg`);
      raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.001 && visible ? requestAnimationFrame(loop) : 0;
    };
    addEventListener('pointermove', (e) => {
      const r = menu.getBoundingClientRect();
      tx = Math.max(-1, Math.min(1, (e.clientX - (r.left + r.width / 2)) / (innerWidth / 2)));
      ty = Math.max(-1, Math.min(1, (e.clientY - (r.top + r.height / 2)) / (innerHeight / 2)));
      if (!raf && visible) raf = requestAnimationFrame(loop);
    }, { passive: true });
    new IntersectionObserver((es) => { visible = es[0].isIntersecting; }).observe(menu);
    menu.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      const r = menu.getBoundingClientRect();
      laser.style.translate = `${e.clientX - r.left}px ${e.clientY - r.top}px`;
      menu.classList.add('aim');
    });
    menu.addEventListener('pointerleave', () => menu.classList.remove('aim'));
  });
</script>
