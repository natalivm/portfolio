    box-shadow: inset 0 0 0 1px var(--line), 0 calc(var(--u) * 24) calc(var(--u) * 60) rgb(0 0 0 / 0.5);
    /* in front of the challenges panel, whose near edge leans out toward the viewer */
    transform: translateZ(calc(var(--u) * 110));
