</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-bsm]').forEach((menu) => {
    const scene = menu.querySelector<HTMLElement>('[data-scene]')!;
    const laser = menu.querySelector<HTMLElement>('[data-laser]')!;

    // it boots in once it is on screen, or, when the page opens veiled, as the veil lifts
    const root = document.documentElement;
    const boot = () => requestAnimationFrame(() => menu.classList.add('on'));
    if (root.hasAttribute('data-veil')) {
      new MutationObserver((_, mo) => {
        if (!root.hasAttribute('data-revealing')) return;
        mo.disconnect();
        setTimeout(boot, 850);
      }).observe(root, { attributes: true, attributeFilter: ['data-revealing'] });
    } else {
      new IntersectionObserver((es, io) => {
        if (!es.some((e) => e.isIntersecting)) return;
        io.disconnect();
        boot();
      }, { threshold: 0.15 }).observe(menu);
    }

    // challenge timers count down
    const fmt = (m: number) => {
      m = Math.max(0, Math.round(m));
      const d = Math.floor(m / 1440), h = Math.floor((m % 1440) / 60), mm = m % 60;
      return d ? `${d}d ${h}h` : h ? `${h}h ${mm}m` : `${mm}m`;
    };
    const t0 = Date.now();
    const timers = [...menu.querySelectorAll<HTMLElement>('[data-left]')].map((el) => ({ el, mins: Number(el.dataset.left) }));
    const tick = () => { const gone = (Date.now() - t0) / 60000; for (const t of timers) t.el.textContent = fmt(t.mins - gone); };
    tick();
    setInterval(tick, 15000);

    // pack pages, and picking a pack
    const pages = menu.querySelector<HTMLElement>('[data-pages]')!;
    const dots = [...menu.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const pageEls = [...menu.querySelectorAll<HTMLElement>('[data-page]')];
    const goPage = (i: number) => {
      pages.style.setProperty('--page', String(i));
      dots.forEach((d, j) => d.setAttribute('aria-selected', String(j === i)));
      pageEls.forEach((p, j) => {
        p.toggleAttribute('aria-hidden', j !== i);
        p.querySelectorAll<HTMLElement>('[data-tile]').forEach((t) => (t.tabIndex = j === i ? 0 : -1));
      });
    };
    dots.forEach((d, i) => d.addEventListener('click', () => goPage(i)));
    let page = 0;
    menu.querySelector('[data-packs]')!.addEventListener('wheel', (e) => {
      const we = e as WheelEvent;
      if (Math.abs(we.deltaX) < 20) return;
      page = Math.max(0, Math.min(dots.length - 1, page + Math.sign(we.deltaX)));
      goPage(page);
    }, { passive: true });
    dots.forEach((d, i) => d.addEventListener('click', () => { page = i; }));
    // ---- the song screen: picking a pack opens its songs, the chosen song and its high scores
    type Song = { t: string; by: string; len: string; bpm: number; notes: number; walls: number; bombs: number };
    type Pack = { name: string; img: string; songs: Song[] };
    const library: Pack[] = JSON.parse(menu.dataset.library!);
    const albumsAt = menu.dataset.albums!;
    const $ = <T extends HTMLElement = HTMLElement>(sel: string) => menu.querySelector<T>(sel)!;
    const songList = $('[data-songs]');
    const indexRail = $('[data-index]');
    const search = $<HTMLInputElement>('[data-search]');
    const hs = $('[data-hs]');
    const screens = { main: [...menu.querySelectorAll<HTMLElement>('.v-main')], songs: [...menu.querySelectorAll<HTMLElement>('.v-songs')] };
    const NAMES = ['NeonKatana', 'BlockSmasher', 'saber_cat', 'Luxx', 'Riko Vance', 'PixelMonk', 'DJ Vertex', 'ohnoitsmel', 'Quasar', 'tenpercent', 'Mirelle', 'Halcyon', 'wristbreaker', 'Ito'];
    const FRIENDS = ['Marta', 'Jonas K.', 'Priya', 'Leo', 'Ana'];
    const DIFF = [0.45, 0.65, 0.85, 1, 1.25]; // how dense each difficulty is, against Expert
    const rand = (str: string) => {
      let h = 2166136261;
      for (const c of str) h = Math.imul(h ^ c.charCodeAt(0), 16777619);
      return () => { h = Math.imul(h ^ (h >>> 15), 2246822507); h = Math.imul(h ^ (h >>> 13), 3266489909); return ((h ^= h >>> 16) >>> 0) / 4294967296; };
    };
    const num = (n: number) => Math.round(n).toLocaleString('en-US');
    // rows are built here, in the browser: give them this component's style scope so its styles reach them
    const cid = [...menu.attributes].find((a) => a.name.startsWith('data-astro-cid-'))?.name;
    const scoped = (root: HTMLElement) => { if (cid) root.querySelectorAll('*').forEach((el) => el.setAttribute(cid, '')); };
    let pack: Pack | null = null, song: Song | null = null, diff = 3, scope = 0, lastTile: HTMLElement | null = null;

    const drawScores = () => {
      if (!song) return;
      const notes = Math.round(song.notes * DIFF[diff]);
      const top = notes * 920; // every note cut cleanly at the full combo
      const r = rand(song.t + diff + scope);
      const mine = top * (0.84 + r() * 0.06);
      const rows = scope === 0
        ? NAMES.slice().sort(() => r() - 0.5).slice(0, 10).map((n, i) => ({ n, s: top * (0.992 - i * 0.006 - r() * 0.004), me: false }))
        : scope === 1
          ? [...FRIENDS.map((n) => ({ n, s: top * (0.8 + r() * 0.14), me: false })), { n: 'You', s: mine, me: true }].sort((a, b) => b.s - a.s)
          : [0, 1, 2].map((i) => ({ n: ['Today', 'Last week', 'First try'][i], s: mine * (1 - i * 0.07), me: i === 0 }));
      hs.classList.add('swap');
      hs.innerHTML = rows.map((x, i) => `<li class="${x.me ? 'me' : ''}" style="--k:${i}"><span class="hs-n">#${i + 1}</span><span class="hs-name"></span><span class="hs-s">${num(x.s)}</span></li>`).join('');
      hs.querySelectorAll('.hs-name').forEach((el, i) => { el.textContent = rows[i].n; });
      scoped(hs);
      void hs.offsetWidth;
      hs.classList.remove('swap');
      $('[data-you]').textContent = num(mine);
      $('[data-combo]').textContent = num(notes * (0.55 + r() * 0.4));
      $('[data-d-notes]').textContent = num(notes);
    };
    const pickSong = (sg: Song) => {
      song = sg;
      $('[data-d-title]').textContent = sg.t;
      $('[data-d-by]').textContent = sg.by;
      $('[data-d-len]').textContent = sg.len;
      $('[data-d-bpm]').textContent = String(sg.bpm);
      $('[data-d-walls]').textContent = String(sg.walls);
      $('[data-d-bombs]').textContent = String(sg.bombs);
      $('[data-fav]').setAttribute('aria-pressed', 'false');
      songList.querySelectorAll<HTMLElement>('.song').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.t === sg.t)));
      drawScores();
    };
    const drawSongs = () => {
      if (!pack) return;
      const q = search.value.trim().toLowerCase();
      const shown = pack.songs.filter((x) => !q || x.t.toLowerCase().includes(q));
      songList.textContent = '';
      for (const sg of shown) {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'song';
        b.setAttribute('role', 'option');
        b.dataset.t = sg.t;
        b.setAttribute('aria-selected', String(sg === song));
        const th = pack.img ? Object.assign(document.createElement('img'), { src: albumsAt + pack.img, alt: '', className: 'song-th' }) : Object.assign(document.createElement('span'), { className: 'song-th' });
        const n = document.createElement('span'); n.className = 'song-n';
        const t = document.createElement('span'); t.className = 'song-t'; t.textContent = sg.t;
        const by = document.createElement('span'); by.className = 'song-by'; by.textContent = sg.by;
        n.append(t, by);
        const m = document.createElement('span'); m.className = 'song-m';
        const len = document.createElement('span'); len.textContent = sg.len;
        const bpm = document.createElement('span'); bpm.className = 'song-bpm'; bpm.textContent = `${sg.bpm} bpm`;
        m.append(len, bpm);
        b.append(th, n, m);
        b.addEventListener('click', () => pickSong(sg));
        songList.append(b);
      }
      if (!shown.length) songList.innerHTML = '<p class="s-none">No songs match.</p>';
      scoped(songList);
      // the rail lights the letters this list has
      const letter = (x: Song) => { const c = x.t.replace(/^[^a-z0-9]+/i, '')[0]?.toUpperCase() ?? '#'; return /[A-Z]/.test(c) ? c : '#'; };
      const has = new Set(shown.map(letter));
      indexRail.querySelectorAll<HTMLElement>('button').forEach((b) => b.toggleAttribute('data-has', has.has(b.textContent!)));
    };
    for (const c of '#ABCDEFGHIJKLMNOPRSTUVWY') {
      const b = document.createElement('button');
      b.type = 'button';
      b.tabIndex = -1;
      b.textContent = c;
      b.addEventListener('click', () => {
        const first = [...songList.querySelectorAll<HTMLElement>('.song')].find((x) => { const k = x.dataset.t!.replace(/^[^a-z0-9]+/i, '')[0]?.toUpperCase(); return c === '#' ? !/[A-Z]/.test(k ?? '') : k === c; });
        first?.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        first?.focus({ preventScroll: true });
      });
      indexRail.append(b);
    }
    scoped(indexRail);
    const setView = (v: 'main' | 'songs') => {
      menu.dataset.view = v;
      screens.main.forEach((el) => el.toggleAttribute('inert', v !== 'main'));
      screens.songs.forEach((el) => el.toggleAttribute('inert', v !== 'songs'));
    };
    const openPack = (i: number, from: HTMLElement) => {
      pack = library[i];
      lastTile = from;
      search.value = '';
      song = pack.songs[0];
      $('[data-s-pack]').textContent = `${pack.name} · ${pack.songs.length} songs`;
      drawSongs();
      pickSong(song);
      songList.scrollTop = 0;
      setView('songs');
      $('[data-back]').focus({ preventScroll: true });
    };
    const tiles = [...menu.querySelectorAll<HTMLButtonElement>('[data-tile]')];
    // the three dots show every album at once; the dice opens one at random
    const mid = $('.bsm-panel.mid.v-main');
    const allBox = $('[data-all]');
    const showAll = (on: boolean) => {
      mid.toggleAttribute('data-all', on);
      allBox.toggleAttribute('inert', !on);
      if (on) $('[data-all-close]').focus({ preventScroll: true });
    };
    let rolling = false;
    tiles.forEach((t) => t.addEventListener('click', () => {
      if (t.dataset.special === 'all') { lastTile = t; showAll(true); return; }
      if (t.dataset.special === 'random') {
        if (rolling) return;
        rolling = true;
        t.classList.add('rolling');
        const withArt = library.map((x, i) => (x.img ? i : -1)).filter((i) => i >= 0);
        const i = withArt[Math.floor(Math.random() * withArt.length)];
        setTimeout(() => { t.classList.remove('rolling'); rolling = false; openPack(i, t); }, reduce ? 0 : 650);
        return;
      }
      openPack(Number(t.dataset.pack), t);
    }));
    $('[data-all-close]').addEventListener('click', () => { showAll(false); lastTile?.focus({ preventScroll: true }); });
    menu.querySelectorAll<HTMLElement>('[data-all-item]').forEach((b) => b.addEventListener('click', () => {
      const from = lastTile ?? b;
      showAll(false);
      openPack(Number(b.dataset.allItem), from);
    }));
    const back = () => { setView('main'); lastTile?.focus({ preventScroll: true }); };
    $('[data-back]').addEventListener('click', back);
    menu.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || list.classList.contains('open')) return;
      if (menu.dataset.view === 'songs') back();
      else if (mid.hasAttribute('data-all')) { showAll(false); lastTile?.focus({ preventScroll: true }); }
    });
    search.addEventListener('input', drawSongs);
    $('[data-fav]').addEventListener('click', (e) => { const b = e.currentTarget as HTMLElement; b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true')); });
    const radios = (sel: string, on: (i: number) => void) => {
      const all = [...menu.querySelectorAll<HTMLElement>(sel)];
      all.forEach((b, i) => b.addEventListener('click', () => { all.forEach((x) => x.setAttribute('aria-checked', String(x === b))); on(i); }));
    };
    radios('[data-mode]', () => {});
    radios('[data-diff]', (i) => { diff = i; drawScores(); });
    radios('[data-scope]', (i) => { scope = i; drawScores(); });
    const modBtns = [...menu.querySelectorAll<HTMLElement>('[data-mod]')];
    modBtns.forEach((b) => b.addEventListener('click', () => {
      b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true'));
      const x = modBtns.reduce((n, m) => n + (m.getAttribute('aria-pressed') === 'true' ? Number(m.dataset.mod) : 0), 1);
      $('[data-mult]').textContent = `×${x.toFixed(2)}`;
    }));
    const playBtn = $('[data-play]'), playT = $('[data-play-t]');
    let starting = false;
    playBtn.addEventListener('click', () => {
      if (starting) return;
      starting = true;
      playBtn.dataset.state = 'busy';
      const steps = ['Get ready', '3', '2', '1', 'Go!'];
      steps.forEach((txt, i) => setTimeout(() => { playT.textContent = txt; if (i === steps.length - 1) playBtn.dataset.state = 'found'; }, i * 650));
      setTimeout(() => { playBtn.removeAttribute('data-state'); playT.textContent = 'Play'; starting = false; }, steps.length * 650 + 700);
    });

    // the multiplayer pickers cycle through their values
    menu.querySelectorAll<HTMLButtonElement>('[data-cycle]').forEach((b) => {
      const vals: string[] = JSON.parse(b.dataset.cycle!);
      const v = b.querySelector<HTMLElement>('[data-v]')!;
      b.addEventListener('click', () => {
        const i = (Number(b.dataset.i) + 1) % vals.length;
        b.dataset.i = String(i);
        v.textContent = vals[i];
        v.classList.remove('flip');
        void v.offsetWidth;
        v.classList.add('flip');
      });
    });

    // Join looks for a lobby
    const join = menu.querySelector<HTMLButtonElement>('[data-join]')!;
    const jt = menu.querySelector<HTMLElement>('[data-join-t]')!;
    let busy = false;
    join.addEventListener('click', () => {
      if (busy) return;
      busy = true;
      join.dataset.state = 'busy';
      let n = 0;
      const dotsT = setInterval(() => { jt.textContent = 'Finding lobby' + '.'.repeat(n++ % 4); }, 300);
      setTimeout(() => {
        clearInterval(dotsT);
        join.dataset.state = 'found';
        jt.textContent = 'Lobby found';
        setTimeout(() => { join.removeAttribute('data-state'); jt.textContent = 'Join'; busy = false; }, 1600);
      }, 2200);
    });

    // the music pack pass: the tab opens the list of passes; picking one puts it on the bar;
    // a milestone that has been reached can be claimed
    const pass = menu.querySelector<HTMLElement>('[data-pass]')!;
    type Pass = { name: string; pack: string; img: string; level: number; xp: number; max: number; claimed: number };
    const passes: Pass[] = JSON.parse(pass.dataset.passes!);
    const tab = pass.querySelector<HTMLButtonElement>('[data-pass-tab]')!;
    const list = pass.querySelector<HTMLElement>('[data-pass-menu]')!;
    const items = [...pass.querySelectorAll<HTMLButtonElement>('[data-pass-item]')];
    const stones = [...pass.querySelectorAll<HTMLButtonElement>('[data-ms]')];
    const thumb = pass.querySelector<HTMLImageElement>('[data-pass-thumb]')!;
    const albums = thumb.src.slice(0, thumb.src.lastIndexOf('/') + 1);
    const q = (sel: string) => pass.querySelector<HTMLElement>(sel)!;
    let cur = 0;
    const show = (i: number) => {
      cur = i;
      const ps = passes[i];
      const at = ps.level + (ps.max ? ps.xp / ps.max : 0);
      q('[data-pass-name]').textContent = ps.name;
      q('[data-pass-count]').textContent = String(ps.claimed);
      q('[data-pass-level]').textContent = String(ps.level);
      q('[data-pass-xp]').textContent = ps.max ? `${ps.xp} / ${ps.max} XP` : 'Complete';
      thumb.src = albums + ps.img;
      q('[data-scale="a"]').style.setProperty('--fill', String(Math.min(1, Math.max(0, (at - 1) / 8))));
      q('[data-scale="b"]').style.setProperty('--fill', String(Math.min(1, Math.max(0, (at - 9) / 4))));
      stones.forEach((st, k) => {
        const lv = 2 * (k + 1);
        const state = k < ps.claimed ? 'claimed' : ps.level >= lv ? 'ready' : 'locked';
        st.dataset.state = state;
        st.querySelector('[data-ms-st]')!.textContent = state === 'claimed' ? 'Claimed' : state === 'ready' ? 'Click to claim' : `Reach level ${lv}`;
      });
      items.forEach((it, k) => {
        it.setAttribute('aria-checked', String(k === i));
        it.querySelector('[data-pm-rw]')!.textContent = String(passes[k].claimed);
      });
    };
    const openList = (on: boolean) => {
      list.classList.toggle('open', on);
      list.toggleAttribute('inert', !on);
      tab.setAttribute('aria-expanded', String(on));
      if (on) items[cur].focus({ preventScroll: true });
    };
    tab.addEventListener('click', () => openList(!list.classList.contains('open')));
    items.forEach((it, i) => it.addEventListener('click', () => { show(i); openList(false); tab.focus({ preventScroll: true }); }));
    document.addEventListener('pointerdown', (e) => {
      if (list.classList.contains('open') && !list.contains(e.target as Node) && !tab.contains(e.target as Node)) openList(false);
    });
    pass.addEventListener('keydown', (e) => {
      if (!list.classList.contains('open')) return;
      if (e.key === 'Escape') { openList(false); tab.focus({ preventScroll: true }); }
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        const k = items.indexOf(document.activeElement as HTMLButtonElement);
        items[(k + (e.key === 'ArrowDown' ? 1 : -1) + items.length) % items.length].focus({ preventScroll: true });
      }
    });
    stones.forEach((st) => st.addEventListener('click', () => {
      if (st.dataset.state !== 'ready') return;
      // rewards are claimed in order: this one and any reached before it
      passes[cur].claimed = Number(st.dataset.ms) + 1;
      show(cur);
      st.classList.remove('pop');
      void st.offsetWidth;
      st.classList.add('pop');
    }));

    // a press on everything else
    menu.querySelectorAll<HTMLElement>('[data-press], [data-join], [data-cycle], [data-pass-tab], [data-play], [data-mode], [data-back]').forEach((b) => {
      b.addEventListener('pointerdown', () => b.classList.add('pressed'));
      const up = () => b.classList.remove('pressed');
      b.addEventListener('pointerup', up);
      b.addEventListener('pointerleave', up);
    });

    // the menu leans a little toward the pointer, and the laser dot follows it over the menu
    if (reduce) return;
    let tx = 0, ty = 0, x = 0, y = 0, raf = 0, visible = true;
    const loop = () => {
      x += (tx - x) * 0.08;
      y += (ty - y) * 0.08;
      scene.style.setProperty('--ry', `${(x * 5).toFixed(3)}deg`);
      scene.style.setProperty('--rx', `${(-y * 3.5).toFixed(3)}deg`);
      raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.001 && visible ? requestAnimationFrame(loop) : 0;
    };
    addEventListener('pointermove', (e) => {
      const r = menu.getBoundingClientRect();
      tx = Math.max(-1, Math.min(1, (e.clientX - (r.left + r.width / 2)) / (innerWidth / 2)));
      ty = Math.max(-1, Math.min(1, (e.clientY - (r.top + r.height / 2)) / (innerHeight / 2)));
      if (!raf && visible) raf = requestAnimationFrame(loop);
    }, { passive: true });
    new IntersectionObserver((es) => { visible = es[0].isIntersecting; }).observe(menu);
    menu.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      const r = menu.getBoundingClientRect();
      laser.style.translate = `${e.clientX - r.left}px ${e.clientY - r.top}px`;
      menu.classList.add('aim');
    });
    menu.addEventListener('pointerleave', () => menu.classList.remove('aim'));
  });
</script>
