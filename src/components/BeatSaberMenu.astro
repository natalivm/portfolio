  /* the list of passes, opened from the tab */
  .pass-menu {
    position: absolute;
    bottom: calc(100% + var(--u) * 16);
    left: 0;
    z-index: 3;
    display: grid;
    gap: calc(var(--u) * 6);
    width: calc(var(--u) * 470);
    padding: calc(var(--u) * 12);
    border-radius: calc(var(--u) * 18);
    background: rgb(8 24 42 / 0.9);
