---
/**
 * Sort Journey: Collections. Everything here is read from the owner's art board (screens, sets,
 * popups, UI assets); the numbers come from the screens themselves (Summer Album: 60/135 cards,
 * nine cards to a set, page 1/15).
 */
import type { Project } from '../../data/projects';

interface Props {
  project: Project;
}
const { project: p } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const art = (name: string) => `${base}/cases/sort-journey/${name}.webp`;

const structure = [
  { name: 'Album', text: 'A season with a grand prize and a timer. The Summer Album holds 15 sets and 135 cards.' },
  { name: 'Set', text: 'Nine cards around one holiday moment: Beach Holiday, Pirate Adventure, Safari.' },
  { name: 'Card', text: 'A photo worth one to five stars. Duplicates turn into Card Stars.' },
  { name: 'Pack', text: 'How cards arrive. Common packs are a surprise; a rare pack holds at least one card of its star level.' },
];

const sections = [
  {
    key: 'screens',
    title: 'Where it lives',
    intro: 'Three screens carry the feature: Home, where it starts; the album; and a set opened card by card.',
    img: { src: 'screens', w: 707, h: 400, alt: 'Three phone screens: Home with the corgi beside a treasure chest, the Summer Album with its sets in a grid, and the Tropical Escape set with nine photo cards' },
    notes: [
      { h: 'Home', t: 'The collection sits on Home as a chest beside the corgi, with its progress on the left edge. Nothing new to find.' },
      { h: 'Album', t: 'The season’s sets on a shelf, three to a row, each with its progress or a tick when it is done. The grand prize stays in view at the top.' },
      { h: 'Set', t: 'A set opens like a page of photos: nine cards, their stars underneath, and a stamp when every card is collected.' },
    ],
  },
  {
    key: 'sets',
    title: 'Sets',
    intro: 'Every set is a book with its own colour and one scene from a trip.',
    img: { src: 'sets', w: 707, h: 403, alt: 'Twenty-seven set covers drawn as small framed books, each with its own colour and holiday scene' },
    notes: [
      { h: 'One subject a cover', t: 'Each scene has one clear subject, centred and bright against its frame, so a cover still reads at the size of a thumbnail.' },
      { h: 'Colour tells them apart', t: 'The frame colours rotate across the shelf, so neighbouring sets never look alike.' },
    ],
  },
  {
    key: 'popups',
    title: 'Popups',
    intro: 'Five moments explain the feature as it happens: the rules, the packs, opening a pack, a new album and Card Stars.',
    img: { src: 'popups', w: 707, h: 365, alt: 'Five popups: Cards Collection, Card Packs, Common Pack, New Album: Summer Vibes!, and Card Stars' },
    notes: [
      { h: 'One frame', t: 'A red ribbon for the title, a purple close button, a dark backdrop and one yellow action. Every popup is built the same way.' },
      { h: 'Rules as pictures', t: 'Collect cards in events, complete the sets, win prizes: three steps, each drawn rather than written.' },
      { h: 'The corgi hosts', t: 'The game’s corgi presents Card Stars, as it greets players on Home and in the key art.' },
    ],
  },
  {
    key: 'ui',
    title: 'UI assets',
    intro: 'Packs, chests, buttons and every state a card can be in.',
    img: { src: 'ui-assets', w: 707, h: 620, alt: 'UI assets: six card packs in two rows, three treasure chests, Claim and price buttons, and card states from locked to collected, with Reroll and +1 Card offers' },
    notes: [
      { h: 'Rarity in one language', t: 'Packs climb from plain white through green, blue and pink to purple and red, adding a star at each step. Chests follow the same climb.' },
      { h: 'Every card state', t: 'Locked with its stars greyed, new, collected with duplicates counted, and two ways to finish a set: reroll a card or buy one more.' },
      { h: 'Prices you can read', t: 'Star prices sit on green buttons; the same price in grey means it cannot be paid yet.' },
    ],
  },
];

// How the cards were made. In the owner's words: a custom style in Layer AI; Claude, connected
// to Layer AI, writes the themes and a prompt for every card; Layer AI renders them in a batch;
// the renders go into a folder and are uploaded to the game.
const pipeline = [
  { who: 'Me', name: 'A style for the game', text: 'A custom style in Layer AI, built from Sort Journey’s own art, so every render belongs to the game.' },
  { who: 'Claude', name: 'A theme, nine prompts', text: 'Connected to Layer AI, Claude proposes the set’s theme and writes a prompt for each of its nine cards.' },
  { who: 'Layer AI', name: 'Batch render', text: 'Every prompt rendered in one batch, in the game’s style.' },
  { who: 'Folder', name: 'Saved together', text: 'The renders land in one folder per set, named and ready.' },
  { who: 'The game', name: 'Uploaded', text: 'The folder is uploaded to the project, and the set fills its place in the album.' },
];
// One real set from the game, shown going through the pipeline: its card names are from the Cards screen.
const demoSet = 'Tropical Escape';
const demoCards = ['Travel Suitcase', 'Boarding Pass', 'Beach Postcard', 'Sun Cream', 'Seashell', 'Camera Snapshot', 'Beach Bag', 'Open Book', 'Golden Sunset'];
// A colour for each rendered card, in the set's beach palette (a diagram, not the art)
const demoFills = [
  'linear-gradient(160deg, #ffb46b, #e7743a)',
  'linear-gradient(160deg, #9fd3ff, #4c96ff)',
  'linear-gradient(160deg, #ffe39a, #f6b23c)',
  'linear-gradient(160deg, #ffd0a8, #f39a5b)',
  'linear-gradient(160deg, #fff1d6, #e9c98f)',
  'linear-gradient(160deg, #8ee6e8, #2fb3c0)',
  'linear-gradient(160deg, #ffc2d8, #e96aa0)',
  'linear-gradient(160deg, #d6e8ff, #8db6f2)',
  'linear-gradient(160deg, #ffcf7a, #f0653a)',
];
const palette = ['#f5913a', '#4c96ff', '#e96aa0', '#7cc36b', '#a98bf0'];
const SETS = 20, CARDS = 9;
// Set colours, taken from the album covers
const setColours = ['#f5913a', '#a98bf0', '#f6c142', '#e96aa0', '#7cc36b', '#ffffff', '#e8504a', '#3fc1c9'];

const principles = [
  { h: 'Souvenirs, not menus', t: 'Albums are stitched photo books, cards are holiday snapshots, packs are foil packets. The feature looks like things you would bring home from a trip.' },
  { h: 'One rarity language', t: 'Colour and star count rise together, and mean the same on packs, cards and chests.' },
  { h: 'One frame for every popup', t: 'Ribbon title, close button, one yellow action. Players learn it once.' },
  { h: 'Light marks value', t: 'Glow and sparkles sit on rewards, the grand prize and an opening pack, and nowhere else.' },
  { h: 'Readable small', t: 'One subject per card and per cover, so a whole season still reads on a phone.' },
];
---

<article class="wrap case">
  <section class="sec">
    <div class="sec-head">
      <h2>Collections</h2>
      <div>
        <p>
          Collections is a feature of Sort Journey, a travel puzzle game by Bluetile Games. Players collect
          cards in events, complete the sets and win prizes. The work covered the key art, the feature’s
          screens, every set cover, its popups and its UI assets.
        </p>
        {p.link && (
          <p class="out">
            <a class="pill pill-light" href={p.link.href} target="_blank" rel="noopener">{p.link.label}</a>
          </p>
        )}
      </div>
    </div>
    <ol class="structure" role="list">
      {structure.map((s, i) => (
        <li>
          <span class="step" aria-hidden="true">{i + 1}</span>
          <h3>{s.name}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="sec">
    <div class="sec-head">
      <h2>How the cards were made</h2>
      <div>
        <p>
          A season runs to around 20 sets of nine cards: about 180 card illustrations, every season.
          Making that much content was the real challenge.
        </p>
        <p>
          In early 2026, when few studios had tried AI for production art, I connected Claude to Layer AI and
          built a pipeline around it.
        </p>
      </div>
    </div>

    <figure class="fig" data-fig data-process>
      <ol class="proc" role="list">
        {pipeline.map((st, i) => (
          <li class="stage" data-stage={i + 1}>
            <div class="vis" aria-hidden="true">
              {i === 0 && (
                <div class="paper style-card">
                  <p class="paper-title">Sort Journey style</p>
                  <span class="dots">{palette.map((c, k) => <i style={`--c:${c}; --k:${k}`} />)}</span>
                  <span class="samples">{demoFills.slice(0, 3).map((g, k) => <i style={`--g:${g}; --k:${k}`} />)}</span>
                  <p class="paper-meta">Layer AI · custom style</p>
                </div>
              )}
              {i === 1 && (
                <div class="paper prompts-card">
                  <p class="theme">{demoSet}</p>
                  <ol class="prompts">{demoCards.map((c, k) => <li style={`--k:${k}`}>{c}</li>)}</ol>
                </div>
              )}
              {i === 2 && (
                <div class="render">
                  <span class="renders">{demoFills.map((g, k) => <i style={`--g:${g}; --k:${k}`} />)}</span>
                  <p class="tag-n"><span data-n="render">0</span>/9 rendered</p>
                </div>
              )}
              {i === 3 && (
                <div class="folder-wrap">
                  <span class="folder">
                    <svg class="f-back" viewBox="0 0 96 72"><path d="M6 14a6 6 0 0 1 6-6h22l8 8h42a6 6 0 0 1 6 6v38a6 6 0 0 1-6 6H12a6 6 0 0 1-6-6z" fill="#fff" /></svg>
                    <span class="drops">{demoFills.slice(0, 3).map((g, k) => <i style={`--g:${g}; --k:${k}`} />)}</span>
                    <svg class="f-front" viewBox="0 0 96 72"><path d="M6 30h84v30a6 6 0 0 1-6 6H12a6 6 0 0 1-6-6z" fill="#eaf3ff" /></svg>
                  </span>
                  <p class="tag-n">tropical-escape · <span data-n="files">0</span> files</p>
                </div>
              )}
              {i === 4 && (
                <div class="paper album-card">
                  <span class="book"><i /></span>
                  <p class="paper-title">{demoSet}</p>
                  <span class="abar"><i /></span>
                  <p class="paper-meta"><span data-n="album">0</span>/9 in the album</p>
                  <svg class="tick" viewBox="0 0 24 24"><circle cx="12" cy="12" r="11" fill="#17824a" /><path d="M7 12.5l3.2 3.2L17 9" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </div>
              )}
            </div>
            <span class="who" data-who={st.who}>{st.who}</span>
            <h3><span class="n">{i + 1}</span>{st.name}</h3>
            <p>{st.text}</p>
          </li>
        ))}
      </ol>
      <figcaption>
        One set, {demoSet}, going through the pipeline. Its nine cards are the real ones from the game; the
        coloured tiles stand in for the renders. It plays while it is on screen.
      </figcaption>
    </figure>

    <figure class="fig" data-fig data-season>
      <div class="season-tile">
        <div class="season" role="img" aria-label={`One season: ${SETS} sets of ${CARDS} cards, ${SETS * CARDS} cards in all`}>
          <p class="axis-y" aria-hidden="true">{CARDS} cards a set</p>
          <div class="grid" aria-hidden="true" style={`--sets:${SETS}`}>
            {Array.from({ length: SETS }).map((_, c) => (
              <span class="set" style={`--c:${c}; --col:${setColours[c % setColours.length]}`}>
                {Array.from({ length: CARDS }).map((_, r) => <i style={`--r:${r}`} />)}
              </span>
            ))}
          </div>
          <p class="axis-x" aria-hidden="true">{SETS} sets a season</p>
          <p class="total"><b data-n="season" data-to={SETS * CARDS}>{SETS * CARDS}</b> cards</p>
        </div>
      </div>
      <figcaption>One season, one square per card. Each column is a set: one theme, nine prompts, rendered together.</figcaption>
    </figure>
  </section>

  {sections.map((s) => (
    <section class="sec">
      <div class="sec-head">
        <h2>{s.title}</h2>
        <div><p>{s.intro}</p></div>
      </div>
      <div class="art-row">
        <figure class="art">
          <img src={art(s.img.src)} width={s.img.w} height={s.img.h} alt={s.img.alt} loading="lazy" decoding="async" />
        </figure>
        <ul class="notes" role="list">
          {s.notes.map((n) => (
            <li>
              <h3>{n.h}</h3>
              <p>{n.t}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <section class="sec">
    <div class="sec-head">
      <h2>Art direction notes</h2>
      <div><p>The rules the whole feature was drawn to.</p></div>
    </div>
    <ol class="principles" role="list">
      {principles.map((n, i) => (
        <li>
          <span class="step" aria-hidden="true">{i + 1}</span>
          <h3>{n.h}</h3>
          <p>{n.t}</p>
        </li>
      ))}
    </ol>
  </section>
</article>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const count = (el: Element | null, to: number, ms: number) => {
    if (!el) return;
    if (reduce || ms <= 0) { el.textContent = String(to); return; }
    const t0 = performance.now();
    const step = (now: number) => {
      const t = Math.min((now - t0) / ms, 1);
      el.textContent = String(Math.round(to * t));
      if (t < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };

  // The process: one set travels through the five stages, then the loop starts again.
  const proc = document.querySelector<HTMLElement>('[data-process]');
  let running = false;
  const STAGES = 5;
  const n = (k: string) => proc?.querySelector(`[data-n="${k}"]`) ?? null;
  const setStage = (k: number) => {
    if (!proc) return;
    for (let i = 1; i <= STAGES; i++) proc.classList.toggle(`s${i}`, i <= k);
    proc.querySelectorAll('.stage').forEach((el, i) => el.classList.toggle('on', i === k - 1));
  };
  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
  async function play() {
    if (!proc || running) return;
    running = true;
    while (proc.hasAttribute('data-live') && !document.hidden) {
      setStage(1);
      await wait(1300);
      setStage(2);
      await wait(1900);
      setStage(3);
      count(n('render'), 9, 9 * 150 + 300);
      await wait(2000);
      setStage(4);
      count(n('files'), 9, 700);
      await wait(1500);
      setStage(5);
      count(n('album'), 9, 900);
      await wait(2600);
      setStage(0);
      ['render', 'files', 'album'].forEach((k) => { const el = n(k); if (el) el.textContent = '0'; });
      await wait(700);
    }
    running = false;
  }

  const io = new IntersectionObserver((es) => es.forEach((e) => {
    e.target.toggleAttribute('data-live', e.isIntersecting);
    if (!e.isIntersecting) return;
    if (e.target === proc) play();
    if (!e.target.classList.contains('seen')) {
      e.target.classList.add('seen'); // the season grid fills once, the first time
      count(e.target.querySelector('[data-n="season"]'), 180, 1900);
    }
  }), { threshold: 0.3 });

  if (reduce) {
    // Everything shown in its finished state, nothing moves
    setStage(STAGES);
    ['render', 'files', 'album'].forEach((k) => { const el = n(k); if (el) el.textContent = '9'; });
    document.querySelectorAll('[data-fig]').forEach((f) => f.classList.add('seen'));
  } else {
    document.querySelectorAll('[data-fig]').forEach((f) => io.observe(f));
  }
</script>

<style>
  .case {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(72px, 9vw, 128px);
    margin-top: clamp(56px, 7vw, 96px);
  }
  .sec {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(24px, 3vw, 40px);
  }
  .sec-head {
    display: grid;
    grid-template-columns: minmax(10rem, 1fr) minmax(0, 2fr);
    gap: 16px clamp(32px, 6vw, 96px);
  }
  .sec-head h2 {
    font-size: clamp(1.5rem, 2.2vw, 2rem);
  }
  .sec-head p {
    max-width: 64ch;
    font-size: 1.125rem;
  }  .sec-head p + p {
    margin-top: 0.8em;
  }

  .out {
    margin-top: 20px;
  }

  /* Album → set → card → pack: four numbered steps on one rule */
  .structure,
  .principles {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .structure {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px clamp(16px, 2.4vw, 32px);
  }
  .structure li {
    display: grid;
    align-content: start;
    gap: 8px;
    padding-top: 16px;
    border-top: 2px solid var(--ink);
  }
  .step {
    color: var(--ink-2);
    font-size: 0.875rem;
    font-weight: 500;
  }
  .structure h3,
  .principles h3,
  .notes h3 {
    font-size: clamp(1.125rem, 1.6vw, 1.375rem);
    letter-spacing: -0.025em;
    line-height: 1.15;
  }
  .structure p,
  .principles p,
  .notes p {
    color: var(--ink-2);
  }

  /* Art at its own size on the board's blue; notes beside it */
  .art-row {
    display: grid;
    grid-template-columns: minmax(0, 707px) minmax(0, 1fr);
    align-items: start;
    gap: 24px clamp(32px, 5vw, 72px);
  }
  .art {
    margin: 0;
    padding: 8px;
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-tile);
  }
  .art img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    background: #4c96ff;
  }
  .notes {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--line);
  }
  .notes li {
    display: grid;
    gap: 6px;
    padding: 18px 0;
    border-top: 1px solid var(--line);
  }

  .principles {
    border-bottom: 1px solid var(--line);
  }
  .principles li {
    display: grid;
    grid-template-columns: 2.5rem minmax(10rem, 1fr) minmax(0, 2fr);
    align-items: baseline;
    gap: 6px clamp(16px, 3vw, 40px);
    padding: 20px 0;
    border-top: 1px solid var(--line);
  }
  .principles p {
    max-width: 60ch;
    font-size: 1.0625rem;
  }

  .fig {
    margin: 0;
  }
  figcaption {
    max-width: 72ch;
    margin-top: 14px;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  /* ---------- The process: five stages, one set passing through ---------- */
  .proc {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 20px 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .stage {
    position: relative;
    display: grid;
    grid-template-rows: auto auto auto 1fr;
    align-content: start;
    gap: 10px;
  }
  /* the arrow to the next stage, lit once that stage has started */
  .stage:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 118px;
    right: -11px;
    z-index: 1;
    width: 8px;
    height: 8px;
    border-top: 2px solid var(--line);
    border-right: 2px solid var(--line);
    transform: rotate(45deg);
    transition: border-color var(--t-med) var(--ease-out);
  }
  .s2 .stage:nth-child(1)::after,
  .s3 .stage:nth-child(2)::after,
  .s4 .stage:nth-child(3)::after,
  .s5 .stage:nth-child(4)::after {
    border-color: var(--ink);
  }
  .vis {
    position: relative;
    display: grid;
    place-items: center;
    height: 236px;
    margin-bottom: 4px;
    padding: 12px;
    border-radius: var(--radius-md);
    background: #4c96ff;
    overflow: hidden;
    transition: box-shadow var(--t-med) var(--ease-out), transform var(--t-med) var(--ease-out);
  }
  .stage.on .vis {
    box-shadow: 0 0 0 3px var(--ink);
    transform: translateY(-3px);
  }
  .stage h3 {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 1.0625rem;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .stage .n {
    color: var(--ink-2);
    font-size: 0.875rem;
    font-weight: 500;
  }
  .stage > p {
    color: var(--ink-2);
    font-size: 0.9375rem;
  }
  .who {
    justify-self: start;
    padding: 3px 10px;
    border-radius: var(--pill);
    background: var(--surface-2);
    font-size: 0.75rem;
    font-weight: 600;
  }
  .who[data-who='Claude'] {
    background: #f3e3d6;
    color: #7a3a14;
  }
  .who[data-who='Layer AI'] {
    background: #e3e6fb;
    color: #2632a8;
  }
  .who[data-who='Me'] {
    background: var(--btn-bg);
    color: var(--btn-ink);
  }

  /* shared pieces inside the stages */
  .paper {
    position: relative;
    width: 100%;
    padding: 12px;
    border-radius: 14px;
    background: #fff;
    color: #0b1a30;
  }
  .paper-title {
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.2;
  }
  .paper-meta {
    color: #45546c;
    font-size: 0.75rem;
  }
  .tag-n {
    padding: 4px 10px;
    border-radius: var(--pill);
    background: #fff;
    color: #0b1a30;
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  /* 1. the style */
  .style-card {
    display: grid;
    gap: 12px;
  }
  .dots,
  .samples {
    display: flex;
    gap: 6px;
  }
  .dots i {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--c);
  }
  .samples i {
    flex: 1;
    aspect-ratio: 1;
    border-radius: 8px;
    background: var(--g);
  }
  .dots i,
  .samples i {
    opacity: 0.25;
    transform: scale(0.7);
    transition: opacity 400ms var(--ease-out), transform 400ms var(--ease-out);
    transition-delay: calc(var(--k) * 90ms);
  }
  .s1 .dots i,
  .s1 .samples i {
    opacity: 1;
    transform: none;
  }

  /* 2. the theme and its nine prompts */
  .prompts-card {
    display: grid;
    gap: 8px;
    align-self: stretch;
  }
  .theme {
    justify-self: start;
    padding: 3px 9px;
    border-radius: var(--pill);
    background: #f3e3d6;
    color: #7a3a14;
    font-size: 0.75rem;
    font-weight: 600;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 300ms var(--ease-out), transform 300ms var(--ease-out);
  }
  .prompts {
    display: grid;
    gap: 3px;
