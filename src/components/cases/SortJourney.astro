---
/**
 * Sort Journey: Collections. Everything here is read from the owner's art board (screens, sets,
 * popups, UI assets); the numbers come from the screens themselves (Summer Album: 60/135 cards,
 * nine cards to a set, page 1/15).
 */
import type { Project } from '../../data/projects';

interface Props {
  project: Project;
}
const { project: p } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const art = (name: string) => `${base}/cases/sort-journey/${name}.webp`;

const structure = [
  { name: 'Album', text: 'A season with a grand prize and a timer. The Summer Album holds 15 sets and 135 cards.' },
  { name: 'Set', text: 'Nine cards around one holiday moment: Beach Holiday, Pirate Adventure, Safari.' },
  { name: 'Card', text: 'A photo worth one to five stars. Duplicates turn into Card Stars.' },
  { name: 'Pack', text: 'How cards arrive. Common packs are a surprise; a rare pack holds at least one card of its star level.' },
];

const screens = [
  { img: 'screen-home', h: 'Home', t: 'The collection sits on Home as a chest beside the corgi, with its progress on the left edge. Nothing new to find.', alt: 'Home screen: a Paris street, the corgi beside a purple treasure chest, and the Level 10 button' },
  { img: 'screen-album', h: 'Album', t: 'The season’s sets on a shelf, three to a row, each with its progress or a tick when it is done. The grand prize stays in view at the top.', alt: 'The Summer Album: a grand prize of 999 gems, 60 of 135 cards, and the sets in a three-column grid' },
  { img: 'screen-cards', h: 'Set', t: 'A set opens like a page of photos: nine cards, their stars underneath, and a stamp when every card is collected.', alt: 'The Tropical Escape set, complete: nine photo cards with their stars' },
];
const popups = [
  { name: 'Cards Collection', alt: 'Cards Collection popup: collect cards in events, complete the sets, win cool prizes' },
  { name: 'Card Packs', alt: 'Card Packs popup: common packs, and rare packs that hold at least one card of their star level' },
  { name: 'Common Pack', alt: 'A common pack opening into three cards, with a Claim button' },
  { name: 'New Album', alt: 'New album popup: Summer Vibes!, 29 days left, with its rewards and a Show Me button' },
  { name: 'Card Stars', alt: 'Card Stars popup hosted by the corgi: duplicates give Card Stars to redeem chests for 200, 300 and 400 stars' },
];
const packs = ['no-star', '1-star', '2-star', '3-star', '4-star', '5-star'];
const chests = [
  { img: 'chest-1', price: 200, alt: 'A wooden chest with a silver star' },
  { img: 'chest-2', price: 300, alt: 'A red quilted chest with a gold star' },
  { img: 'chest-3', price: 400, alt: 'A gold-trimmed chest with a red star' },
];
const cardStates = [
  { img: 'card-locked1', w: 188, label: 'Locked', alt: 'A locked card' },
  { img: 'card-locked2', w: 188, label: 'Locked', alt: 'A locked card showing one grey star' },
  { img: 'card-locked3', w: 188, label: 'Locked', alt: 'A locked card showing three grey stars' },
  { img: 'card-new', w: 193, label: 'New', alt: 'The Sun Cream card with a NEW ribbon and one star' },
  { img: 'card-dupe', w: 184, label: '+2 copies', alt: 'The Seashell card with three stars and a +2 duplicates badge' },
  { img: 'card-dupe2', w: 183, label: '+2 copies', alt: 'The Camera Snapshot card with five stars and a +2 duplicates badge' },
];
const offers = [
  { img: 'offer-reroll', w: 211, label: 'Reroll', alt: 'A Reroll offer: swap a card for 120 gems' },
  { img: 'offer-card', w: 204, label: '+1 card', alt: 'A mystery +1 Card offer for 160 gems' },
];

// How the cards were made. In the owner's words: a custom style in Layer AI; Claude, connected
// to Layer AI, writes the themes and a prompt for every card; Layer AI renders them in a batch;
// the renders go into a folder and are uploaded to the game.
const pipeline = [
  { who: 'Me', name: 'A style for the game', text: 'A custom style in Layer AI, built from Sort Journey’s own art, so every render belongs to the game.' },
  { who: 'Claude', name: 'A theme, nine prompts', text: 'Connected to Layer AI, Claude proposes the set’s theme and writes a prompt for each of its nine cards.' },
  { who: 'Layer AI', name: 'Batch render', text: 'Every prompt rendered in one batch, in the game’s style.' },
  { who: 'Folder', name: 'Saved together', text: 'The renders land in one folder per set, named and ready.' },
  { who: 'The game', name: 'Uploaded', text: 'The folder is uploaded to the project, and the set fills its place in the album.' },
];
// One real set from the game, shown going through the pipeline: its card names are from the Cards screen.
const demoSet = 'Tropical Escape';
const demoCards = ['Travel Suitcase', 'Boarding Pass', 'Beach Postcard', 'Sun Cream', 'Seashell', 'Camera Snapshot', 'Beach Bag', 'Open Book', 'Golden Sunset'];
// A colour for each rendered card, in the set's beach palette (a diagram, not the art)
const demoFills = [
  'linear-gradient(160deg, #ffb46b, #e7743a)',
  'linear-gradient(160deg, #9fd3ff, #4c96ff)',
  'linear-gradient(160deg, #ffe39a, #f6b23c)',
  'linear-gradient(160deg, #ffd0a8, #f39a5b)',
  'linear-gradient(160deg, #fff1d6, #e9c98f)',
  'linear-gradient(160deg, #8ee6e8, #2fb3c0)',
  'linear-gradient(160deg, #ffc2d8, #e96aa0)',
  'linear-gradient(160deg, #d6e8ff, #8db6f2)',
  'linear-gradient(160deg, #ffcf7a, #f0653a)',
];
const palette = ['#f5913a', '#4c96ff', '#e96aa0', '#7cc36b', '#a98bf0'];

const principles = [
  { h: 'Souvenirs, not menus', t: 'Albums are stitched photo books, cards are holiday snapshots, packs are foil packets. The feature looks like things you would bring home from a trip.' },
  { h: 'One rarity language', t: 'Colour and star count rise together, and mean the same on packs, cards and chests.' },
  { h: 'One frame for every popup', t: 'Ribbon title, close button, one yellow action. Players learn it once.' },
  { h: 'Light marks value', t: 'Glow and sparkles sit on rewards, the grand prize and an opening pack, and nowhere else.' },
  { h: 'Readable small', t: 'One subject per card and per cover, so a whole season still reads on a phone.' },
];
---

<canvas class="sj-bg" aria-hidden="true" data-sj-bg></canvas>

<article class="wrap case">
  <section class="sec">
    <div class="sec-head" data-fig>
      <h2 class="ribbon"><span>Collections</span></h2>
      <div>
        <p>
          Collections is a feature of Sort Journey, a travel puzzle game by Bluetile Games. Players collect
          cards in events, complete the sets and win prizes. The work covered the key art, the feature’s
          screens, every set cover, its popups and its UI assets.
        </p>
        {p.link && (
          <p class="out">
            <a class="pill pill-light" href={p.link.href} target="_blank" rel="noopener">{p.link.label}</a>
          </p>
        )}
      </div>
    </div>
    <ol class="structure" role="list">
      {structure.map((s, i) => (
        <li>
          <span class="step" aria-hidden="true">{i + 1}</span>
          <h3>{s.name}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="sec">
    <div class="sec-head" data-fig>
      <h2 class="ribbon"><span>AI production</span></h2>
      <div>
        <p>
          A season runs to around 20 sets of nine cards: about 180 card illustrations, every season.
          Making that much content was the real challenge.
        </p>
        <p>
          In early 2026, when few studios had tried AI for production art, I connected Claude to Layer AI and
          built a pipeline around it.
        </p>
      </div>
    </div>

    <figure class="fig" data-fig data-process>
      <ol class="proc" role="list">
        {pipeline.map((st, i) => (
          <li class="stage" data-stage={i + 1}>
            <div class="vis" aria-hidden="true">
              {i === 0 && (
                <div class="paper style-card">
                  <p class="paper-title">Sort Journey style</p>
                  <span class="dots">{palette.map((c, k) => <i style={`--c:${c}; --k:${k}`} />)}</span>
                  <span class="samples">{demoFills.slice(0, 3).map((g, k) => <i style={`--g:${g}; --k:${k}`} />)}</span>
                  <p class="paper-meta">Layer AI · custom style</p>
                </div>
              )}
              {i === 1 && (
                <div class="paper prompts-card">
                  <p class="theme">{demoSet}</p>
                  <ol class="prompts">{demoCards.map((c, k) => <li style={`--k:${k}`}>{c}</li>)}</ol>
                </div>
              )}
              {i === 2 && (
                <div class="render">
                  <span class="renders">{demoFills.map((g, k) => <i style={`--g:${g}; --k:${k}`} />)}</span>
                  <p class="tag-n"><span data-n="render">0</span>/9 rendered</p>
                </div>
              )}
              {i === 3 && (
                <div class="folder-wrap">
                  <span class="folder">
                    <svg class="f-back" viewBox="0 0 96 72"><path d="M6 14a6 6 0 0 1 6-6h22l8 8h42a6 6 0 0 1 6 6v38a6 6 0 0 1-6 6H12a6 6 0 0 1-6-6z" fill="#fff" /></svg>
                    <span class="drops">{demoFills.slice(0, 3).map((g, k) => <i style={`--g:${g}; --k:${k}`} />)}</span>
                    <svg class="f-front" viewBox="0 0 96 72"><path d="M6 30h84v30a6 6 0 0 1-6 6H12a6 6 0 0 1-6-6z" fill="#eaf3ff" /></svg>
                  </span>
                  <p class="tag-n">tropical-escape · <span data-n="files">0</span> files</p>
                </div>
              )}
              {i === 4 && (
                <div class="paper album-card">
                  <span class="book"><i /></span>
                  <p class="paper-title">{demoSet}</p>
                  <span class="abar"><i /></span>
                  <p class="paper-meta"><span data-n="album">0</span>/9 in the album</p>
                  <svg class="tick" viewBox="0 0 24 24"><circle cx="12" cy="12" r="11" fill="#17824a" /><path d="M7 12.5l3.2 3.2L17 9" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </div>
              )}
            </div>
            <span class="who" data-who={st.who}>{st.who}</span>
            <h3><span class="n">{i + 1}</span>{st.name}</h3>
            <p>{st.text}</p>
          </li>
        ))}
      </ol>
    </figure>

  </section>

  <section class="sec">
    <div class="sec-head" data-fig>
      <h2>Screens</h2>
      <div><p>Three screens carry the feature: Home, where it starts; the album; and a set opened card by card.</p></div>
    </div>
    <ol class="phones" role="list" data-fig>
      {screens.map((sc, i) => (
        <li class="rise" style={`--k:${i}`}>
          <img src={art(sc.img)} width="640" height="1294" alt={sc.alt} loading="lazy" decoding="async" />
          <h3>{sc.h}</h3>
          <p>{sc.t}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="sec">
    <div class="sec-head" data-fig>
      <h2>Sets</h2>
    </div>
    <figure class="fig sets" data-fig>
      <img class="torn" src={`${base}/cases/sort-journey/bg-sets.svg`} width="1295" height="878" alt="" loading="lazy" decoding="async" />
      <img class="rise covers" src={art('sets')} width="2400" height="953" alt="Twenty-seven set covers drawn as small framed books, each with its own colour and holiday scene" loading="lazy" decoding="async" />
    </figure>
    <ul class="notes cols" role="list">
      <li><h3>One subject a cover</h3><p>Each scene has one clear subject, centred and bright against its frame, so a cover still reads at the size of a thumbnail.</p></li>
      <li><h3>Colour tells them apart</h3><p>The frame colours rotate across the shelf, so neighbouring sets never look alike.</p></li>
    </ul>
  </section>

  <section class="sec">
    <div class="sec-head" data-fig>
      <h2>Popups</h2>
      <div><p>Five moments explain the feature as it happens: the rules, the packs, opening a pack, a new album and Card Stars.</p></div>
    </div>
    <ol class="popups" role="list" data-fig>
      {popups.map((pp, i) => (
        <li class="rise" style={`--k:${i}`}>
          <img src={art(`popup-${i + 1}`)} width="480" height="1040" alt={pp.alt} loading="lazy" decoding="async" />
          <p>{pp.name}</p>
        </li>
      ))}
    </ol>
    <div class="host">
      <ul class="notes cols" role="list">
        <li><h3>One frame</h3><p>A red ribbon for the title, a purple close button, a dark backdrop and one yellow action. Every popup is built the same way.</p></li>
        <li><h3>Rules as pictures</h3><p>Collect cards in events, complete the sets, win prizes: three steps, each drawn rather than written.</p></li>
        <li><h3>The corgi hosts</h3><p>The game’s corgi presents Card Stars, as it greets players on Home and in the key art.</p></li>
      </ul>
      <img class="corgi" src={art('corgi')} width="560" height="560" alt="The game’s corgi, tongue out, in a red bandana" loading="lazy" decoding="async" />
    </div>
  </section>

  <section class="sec">
    <div class="sec-head" data-fig>
      <h2 class="ribbon"><span>UI assets</span></h2>
      <div><p>Packs, chests, buttons and every state a card can be in.</p></div>
    </div>

    <div class="kit" data-fig>
      <div class="kit-main">
        <div class="board" style={`--board:url(${art('bg-board')})`}>
          <ul class="packs" role="list" aria-label="Card packs, closed">
            {packs.map((pk, i) => (
              <li class="rise" style={`--k:${i}`}><img src={art(`pack-${i}`)} width="231" height="280" alt={`A ${pk.replace('-', ' ')} card pack`} loading="lazy" decoding="async" /></li>
            ))}
          </ul>
          <ul class="packs open" role="list" aria-label="Card packs, opened">
            {packs.map((pk, i) => (
              <li class="rise" style={`--k:${i + 4}`}><img src={art(`pack-${i}-open`)} width="216" height="216" alt={`The ${pk.replace('-', ' ')} pack, opened`} loading="lazy" decoding="async" /></li>
            ))}
          </ul>
        </div>
        <ul class="chests" role="list">
          {chests.map((c, i) => (
            <li class="rise" style={`--k:${i + 2}`}><img src={art(c.img)} width="485" height="436" alt={c.alt} loading="lazy" decoding="async" /></li>
          ))}
        </ul>
        <ul class="buttons" role="list">
          <li class="rise claim" style="--k:5"><img src={art('btn-claim')} width="320" height="128" alt="The yellow Claim button" loading="lazy" decoding="async" /></li>
          <li class="rise" style="--k:6"><img src={art('btn-200')} width="209" height="112" alt="A green price button: 200 stars, can be paid" loading="lazy" decoding="async" /></li>
          <li class="rise" style="--k:7"><img src={art('btn-400')} width="210" height="112" alt="A grey price button: 400 stars, not yet" loading="lazy" decoding="async" /></li>
        </ul>
      </div>

      <div class="panel">
        <ul class="fans" role="list">
          {[1, 2, 3].map((k) => (
            <li class="rise" style={`--k:${k}`}><img src={art(`fan-${k}`)} width="235" height="220" alt="A fan of three collected cards" loading="lazy" decoding="async" /></li>
          ))}
        </ul>
        <ul class="states" role="list">
          {cardStates.map((c, i) => (
            <li class="rise" style={`--k:${i + 2}`}><img src={art(c.img)} width={c.w} height="260" alt={c.alt} loading="lazy" decoding="async" /></li>
          ))}
        </ul>
        <ul class="offers" role="list">
          {offers.map((c, i) => (
            <li class="rise" style={`--k:${i + 8}`}><img src={art(c.img)} width={c.w} height="280" alt={c.alt} loading="lazy" decoding="async" /></li>
          ))}
        </ul>
      </div>
    </div>

    <ul class="notes cols" role="list">
      <li><h3>Rarity in one language</h3><p>Packs climb from plain white through green, blue and pink to purple and red, adding a star at each step. Chests follow the same climb: wood and silver, then red, then gold.</p></li>
      <li><h3>Every card state</h3><p>Locked with its stars greyed, new, collected with duplicates counted, and two ways to finish a set: reroll a card or buy one more.</p></li>
      <li><h3>Prices you can read</h3><p>One yellow action per popup. Star prices sit on green buttons; the same price in grey means it cannot be paid yet.</p></li>
    </ul>
  </section>

  <section class="sec">
    <div class="sec-head" data-fig>
      <h2 class="ribbon"><span>Art direction</span></h2>
      <div><p>The rules the whole feature was drawn to.</p></div>
    </div>
    <ol class="principles" role="list">
      {principles.map((n, i) => (
        <li>
          <span class="step" aria-hidden="true">{i + 1}</span>
          <h3>{n.h}</h3>
          <p>{n.t}</p>
        </li>
      ))}
    </ol>
  </section>
</article>

<script>
  // Background: paws, bones and fish skeletons pressed into the game's blue. JavaScript places them
  // (four sizes, each on its own offset grid; a smaller one gives way to any larger one it would
  // touch) and hands the few on screen to a fragment shader, which draws each as a signed-distance
  // shape: a darker blue pressed in, with a light edge underneath. They scroll with the page and sway
  // very slightly. Without WebGL the CSS pattern stays; with reduced motion the motifs hold still.
  (() => {
    const canvas = document.querySelector<HTMLCanvasElement>('[data-sj-bg]');
    const gl = canvas?.getContext('webgl', { antialias: false, alpha: true, premultipliedAlpha: true });
    if (!canvas || !gl) return;
    const MAX = 64;

    const vert = 'attribute vec2 a;void main(){gl_Position=vec4(a,0.,1.);}';
    const frag = `
      precision mediump float;
      uniform vec2 uRes; uniform float uDpr; uniform float uTime; uniform int uCount;
      uniform vec4 uA[${MAX}];   // centre in CSS px (viewport), radius, scale
      uniform vec4 uB[${MAX}];   // angle, kind, strength, phase
      mat2 rot(float a){ float c = cos(a), s = sin(a); return mat2(c, -s, s, c); }
      float sdEll(vec2 p, vec2 r){ float k0 = length(p / r); float k1 = length(p / (r * r)); return k0 * (k0 - 1.0) / k1; }
      float sdSeg(vec2 p, vec2 a, vec2 b){ vec2 pa = p - a, ba = b - a; float h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0); return length(pa - ba * h); }
      // y points down, so toes sit above the pad
      float paw(vec2 p){
        float d = sdEll(p - vec2(0.0, 8.0), vec2(20.0, 16.0));
        d = min(d, sdEll(rot(0.35) * (p - vec2(-21.0, -10.0)), vec2(7.0, 9.0)));
        d = min(d, sdEll(rot(0.12) * (p - vec2(-8.0, -23.0)), vec2(7.5, 10.0)));
        d = min(d, sdEll(rot(-0.12) * (p - vec2(8.0, -23.0)), vec2(7.5, 10.0)));
        d = min(d, sdEll(rot(-0.35) * (p - vec2(21.0, -10.0)), vec2(7.0, 9.0)));
        return d;
      }
      float bone(vec2 p){
        float d = sdSeg(p, vec2(-24.0, 0.0), vec2(24.0, 0.0)) - 6.0;
        d = min(d, length(p - vec2(-27.0, -6.5)) - 7.5);
        d = min(d, length(p - vec2(-27.0, 6.5)) - 7.5);
        d = min(d, length(p - vec2(27.0, -6.5)) - 7.5);
        d = min(d, length(p - vec2(27.0, 6.5)) - 7.5);
        return d;
      }
      float fish(vec2 p){
        float w = 2.2;
        float d = abs(sdEll(p - vec2(25.0, 0.0), vec2(13.0, 9.0))) - w;
        d = min(d, sdSeg(p, vec2(-27.0, 0.0), vec2(12.0, 0.0)) - w);
        for (int i = 0; i < 3; i++) {
          float x = -13.0 + float(i) * 8.5;
          d = min(d, sdSeg(p, vec2(x - 5.0, -9.0), vec2(x, 0.0)) - w);
          d = min(d, sdSeg(p, vec2(x - 5.0, 9.0), vec2(x, 0.0)) - w);
        }
        d = min(d, sdSeg(p, vec2(-27.0, 0.0), vec2(-38.0, -10.0)) - w);
        d = min(d, sdSeg(p, vec2(-38.0, -10.0), vec2(-38.0, 10.0)) - w);
        d = min(d, sdSeg(p, vec2(-38.0, 10.0), vec2(-27.0, 0.0)) - w);
        d = min(d, length(p - vec2(29.0, -2.0)) - 2.2);
        return d;
      }
      float motif(vec2 p, float t){ return t < 0.56 ? paw(p) : (t < 0.78 ? bone(p) : fish(p)); }
      void main(){
        vec2 frag = vec2(gl_FragCoord.x, uRes.y - gl_FragCoord.y) / uDpr;
        vec4 col = vec4(0.0);
        for (int i = 0; i < ${MAX}; i++) {
          if (i >= uCount) break;
          vec4 a = uA[i];
          vec2 p = frag - a.xy;
          if (dot(p, p) > a.z * a.z) continue;          // nowhere near this motif
          vec4 b = uB[i];
          float sc = a.w;
          p.y -= sin(uTime * 0.45 + b.w * 0.5) * 3.0;     // a slight bob
          float ang = b.x + sin(uTime * 0.35 + b.w) * 0.08;
          float edge = 1.5 + 0.5 * sc;                     // the lit edge grows a little with the motif
          float d = motif(rot(ang) * (p / sc), b.y) * sc;
          float d2 = motif(rot(ang) * ((p - vec2(0.0, edge)) / sc), b.y) * sc;
          float inside = 1.0 - smoothstep(-0.75, 0.75, d);
          float rim = (1.0 - smoothstep(-0.75, 0.75, d2)) * (1.0 - inside);
          col += (vec4(0.184, 0.435, 0.839, 1.0) * 0.2 * inside + vec4(1.0) * 0.13 * rim) * b.z;
        }
        gl_FragColor = col;
      }`;
    const compile = (type: number, src: string) => {
      const sh = gl.createShader(type)!;
      gl.shaderSource(sh, src);
      gl.compileShader(sh);
      return gl.getShaderParameter(sh, gl.COMPILE_STATUS) ? sh : null;
    };
    const vs = compile(gl.VERTEX_SHADER, vert), fs = compile(gl.FRAGMENT_SHADER, frag);
    if (!vs || !fs) return;
    const prog = gl.createProgram()!;
    gl.attachShader(prog, vs);
    gl.attachShader(prog, fs);
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return;
    gl.useProgram(prog);
    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, 'a');
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
    const u = (n: string) => gl.getUniformLocation(prog, n);
    const uRes = u('uRes'), uDpr = u('uDpr'), uTime = u('uTime'), uCount = u('uCount'), uA = u('uA'), uB = u('uB');

    // ---- placement, in page coordinates (CSS px) ----
    const R = 45; // a motif's radius at scale 1, with room for its lit edge
    const LAYERS = [
      { cs: 560, ox: 0, oy: 0, s0: 1.7, s1: 2.6, pr: 0.5, seed: 1 },      // large
      { cs: 320, ox: 131, oy: 77, s0: 0.85, s1: 1.3, pr: 0.8, seed: 37 },  // medium
      { cs: 250, ox: 197, oy: 143, s0: 0.7, s1: 1.05, pr: 0.85, seed: 53 }, // medium, filling the gaps
      { cs: 180, ox: 59, oy: 211, s0: 0.38, s1: 0.62, pr: 0.5, seed: 91 }, // small: paws and bones only
    ];
    const hash = (x: number, y: number, k: number) => { const n = Math.sin(x * 127.1 + y * 311.7 + k * 74.7) * 43758.5453; return n - Math.floor(n); };
    type M = { x: number; y: number; r: number; s: number; ang: number; kind: number; w: number; ph: number };
    let K = 1;
    // every motif whose cell overlaps a band of the page, larger sizes first
    const placeBand = (top: number, bottom: number, width: number) => {
      const kept: M[] = [];
      LAYERS.forEach((L, l) => {
        const cs = L.cs * K, ox = L.ox * K, oy = L.oy * K, s0 = L.s0 * K, s1 = L.s1 * K;
        const j = cs * 0.5 - R * s1 - 4; // jitter that keeps a motif inside its own cell
        for (let cy = Math.floor((top - oy) / cs); cy * cs + oy < bottom; cy++) {
          for (let cx = Math.floor((-ox - cs) / cs); cx * cs + ox < width + cs; cx++) {
            const k = L.seed;
            if (hash(cx, cy, k + 7.3) >= L.pr) continue;
            const s = s0 + (s1 - s0) * hash(cx, cy, k + 11.7);
            const m: M = {
              x: (cx + 0.5) * cs + ox + (hash(cx, cy, k) - 0.5) * 2 * j,
              y: (cy + 0.5) * cs + oy + (hash(cx, cy, k + 19.19) - 0.5) * 2 * j,
              r: R * s,
              s,
              ang: (hash(cx, cy, k + 23) - 0.5) * 2.2,
              kind: hash(cx, cy, k + 3.1) * (l === 3 ? 0.77 : 1), // a fish's lines get too thin when small
              w: 0.7 + 0.3 * hash(cx, cy, k + 5.5),
              ph: hash(cx, cy, k + 29) * 40,
            };
            if (kept.some((o) => Math.hypot(o.x - m.x, o.y - m.y) < o.r + m.r + 12 * K)) continue;
            kept.push(m);
          }
        }
      });
      return kept;
    };

    const A = new Float32Array(MAX * 4), B = new Float32Array(MAX * 4);
    let dpr = 1, count = 0, band: { top: number; bottom: number; list: M[] } | null = null;
    const size = () => {
      dpr = Math.min(devicePixelRatio || 1, 1.5); // soft shapes stay smooth; keeps the cost down on dense screens
      canvas.width = Math.round(innerWidth * dpr);
      canvas.height = Math.round(innerHeight * dpr);
      gl.viewport(0, 0, canvas.width, canvas.height);
      K = innerWidth < 600 ? 0.62 : 1; // smaller and closer together on phones
      band = null;
    };
    // motifs are placed for a band larger than the screen and re-placed only when the screen nears its edge
    const visible = (y: number) => {
      const pad = 700, H = innerHeight;
      if (!band || y < band.top + pad / 2 || y + H > band.bottom - pad / 2) {
        // start the band on a large-cell boundary, so placement never depends on where the band begins
        const top = Math.floor((y - pad) / (560 * K)) * 560 * K - 560 * K, bottom = y + H + pad + 560 * K;
        band = { top, bottom, list: placeBand(top, bottom, innerWidth) };
      }
      count = 0;
      for (const m of band.list) {
        if (count >= MAX) break;
        const vy = m.y - y;
        if (vy + m.r < -8 || vy - m.r > H + 8) continue;
        A.set([m.x, vy, m.r + 6, m.s], count * 4);
        B.set([m.ang, m.kind, m.w, m.ph], count * 4);
        count++;
      }
    };

    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const t0 = performance.now();
    const draw = (now: number) => {
      visible(scrollY);
      gl.uniform2f(uRes, canvas.width, canvas.height);
      gl.uniform1f(uDpr, dpr);
      gl.uniform1f(uTime, still ? 0 : (now - t0) / 1000);
      gl.uniform1i(uCount, count);
      gl.uniform4fv(uA, A);
      gl.uniform4fv(uB, B);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
    };
    size();
    addEventListener('resize', () => { size(); draw(performance.now()); });
    if (still) {
      addEventListener('scroll', () => draw(performance.now()), { passive: true });
      draw(performance.now());
    } else {
      // full rate while the page scrolls; the slow sway alone only needs about 20 frames a second
      let lastScroll = 0, lastDraw = 0;
      addEventListener('scroll', () => { lastScroll = performance.now(); }, { passive: true });
      const loop = (now: number) => {
        if (!document.hidden && (now - lastScroll < 200 || now - lastDraw > 50)) {
          draw(now);
          lastDraw = now;
        }
        requestAnimationFrame(loop);
      };
      requestAnimationFrame(loop);
    }
    document.documentElement.setAttribute('data-shader', ''); // the CSS pattern steps aside
  })();
</script>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const count = (el: Element | null, to: number, ms: number) => {
    if (!el) return;
    if (reduce || ms <= 0) { el.textContent = String(to); return; }
    const t0 = performance.now();
    const step = (now: number) => {
      const t = Math.min((now - t0) / ms, 1);
      el.textContent = String(Math.round(to * t));
      if (t < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };

  // The process: one set travels through the five stages, then the loop starts again.
  const proc = document.querySelector<HTMLElement>('[data-process]');
  let running = false;
  const STAGES = 5;
  const n = (k: string) => proc?.querySelector(`[data-n="${k}"]`) ?? null;
  const setStage = (k: number) => {
    if (!proc) return;
    for (let i = 1; i <= STAGES; i++) proc.classList.toggle(`s${i}`, i <= k);
    proc.querySelectorAll('.stage').forEach((el, i) => el.classList.toggle('on', i === k - 1));
  };
  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
  async function play() {
    if (!proc || running) return;
    running = true;
    while (proc.hasAttribute('data-live') && !document.hidden) {
      setStage(1);
      await wait(1300);
      setStage(2);
      await wait(1900);
      setStage(3);
      count(n('render'), 9, 9 * 150 + 300);
      await wait(2000);
      setStage(4);
      count(n('files'), 9, 700);
      await wait(1500);
      setStage(5);
      count(n('album'), 9, 900);
      await wait(2600);
      setStage(0);
      ['render', 'files', 'album'].forEach((k) => { const el = n(k); if (el) el.textContent = '0'; });
      await wait(700);
    }
    running = false;
  }

  const io = new IntersectionObserver((es) => es.forEach((e) => {
    e.target.toggleAttribute('data-live', e.isIntersecting);
    if (!e.isIntersecting) return;
    if (e.target === proc) play();
    if (!e.target.classList.contains('seen')) {
      e.target.classList.add('seen'); // things rise in, once
    }
  }), { threshold: 0.3 });

  if (reduce) {
    // Everything shown in its finished state, nothing moves
    setStage(STAGES);
    ['render', 'files', 'album'].forEach((k) => { const el = n(k); if (el) el.textContent = '9'; });
    document.querySelectorAll('[data-fig]').forEach((f) => f.classList.add('seen'));
  } else {
    document.querySelectorAll('[data-fig]').forEach((f) => { f.setAttribute('data-armed', ''); io.observe(f); });
  }
</script>

