---
/**
 * BestPlay: visual development for a revamp of the app. The film at the top of the page
 * (HomeRevampFilm) shows the home screen redesign; this is the story under it, why the revamp,
 * from the research deck in the Art system revamp Figma file. The deck's words are set as text;
 * the only images are the app's own screens and art, and the reference screens. The research
 * panels borrow the deck's look: cream panels, a serif, a deep green.
 */
import '@fontsource-variable/newsreader';
import type { Project } from '../../data/projects';

interface Props {
  project: Project;
}
const { project: p } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const art = (name: string) => `${base}/cases/bestplay/${name}.webp`;

const principles = [
  { h: 'Professional and structured', t: 'A clear grid, honest numbers in dollars, one message per card.' },
  { h: 'Fun and interactive', t: 'Play, motion and rewards stay. They just stop shouting.' },
  { h: 'Room for every style', t: 'A light, calm frame that any art can sit on, in a light or a dark theme.' },
  { h: 'For everyone', t: 'Players of every age and background, in everyday moments they recognise.' },
];

const review = [
  { h: 'It tips over', t: 'A very heavy top and a very light bottom. Everything important piles up at the start.' },
  { h: 'It’s cramped', t: 'Text doesn’t fit its boxes, the contrast is very low and the type is too small.' },
  { h: 'Everything shouts', t: 'Very high saturation on every card, so each one competes with the next.' },
];

const stats = [
  { n: '28%', t: 'of US video game players are 50 or older', src: 1 },
  { n: '47%', t: 'of US video game players are women', src: 1 },
  { n: '29%', t: 'of US adults in households earning under $30,000 a year go online only through a smartphone, against 7% of those earning $100,000 or more', src: 2 },
];

// numbered in the order they first appear on the page
const sources = [
  { t: 'Entertainment Software Association, Essential Facts About the U.S. Video Game Industry, 2025.', href: 'https://www.theesa.com/resources/essential-facts-about-the-us-video-game-industry/2025-data' },
  { t: 'Pew Research Center, Mobile Fact Sheet: smartphone dependency by income. Survey of U.S. adults, January 30 to June 18, 2026.', href: 'https://www.pewresearch.org/internet/fact-sheet/mobile/' },
  { t: 'Federal Trade Commission, “New FTC Data Show a Big Jump in Reported Losses to Fraud to $12.5 Billion in 2024”, March 2025.', href: 'https://www.ftc.gov/news-events/news/press-releases/2025/03/new-ftc-data-show-big-jump-reported-losses-fraud-125-billion-2024' },
  { t: 'Federal Trade Commission, Data Spotlight: “Paying to get paid: gamified job scams drive record losses”, December 2024.', href: 'https://www.ftc.gov/news-events/data-visualizations/data-spotlight/2024/12/paying-get-paid-gamified-job-scams-drive-record-losses' },
  { t: 'B.J. Fogg and others, Stanford Web Credibility Project, “How Do People Evaluate a Web Site’s Credibility?”, Consumer WebWatch, 2002. 46.1% of comments overall; 54.6% for finance sites.', href: 'https://advocacy.consumerreports.org/research/how-do-people-evaluate-a-web-sites-credibility' },
  { t: 'Joseph C. Nunes and Xavier Drèze, “The Endowed Progress Effect: How Artificial Advancement Increases Effort”, Journal of Consumer Research, 2006.', href: 'https://msbfile03.usc.edu/digitalmeasures/jnunes/intellcont/Endowed%20Progress%20Effect-1.pdf' },
];

const cues = [
  { cue: 'Gold coin piles and treasure chests', where: 'Home, Events', read: 'Jackpot. Too good to be true.' },
  { cue: 'Crowns, magenta and “Buy tickets”', where: 'Lucky Draw', read: 'A lottery.' },
  { cue: 'A $4,000 prize above a $99.99 balance', where: 'Home, Events', read: 'That will never be me.' },
  { cue: '“Shortcut to big money!” with a money-face emoji', where: 'Home', read: 'Get rich quick.' },
  { cue: 'Bubble 3D lettering in many styles', where: 'Every screen', read: 'A game for kids.' },
  { cue: 'The fox in a suit, holding a briefcase of cash', where: 'Home, Events, Cash out', read: 'Wall Street, not people like me.' },
];

const costs = [
  { h: 'Store page', t: 'Gold and jackpot screenshots look like every other earn-money app, and like the scams.', m: 'store page conversion' },
  { h: 'First session', t: 'Five loud promotions bury the simple loop: play, earn, cash out.', m: 'onboarding completion, day-1 retention' },
  { h: 'First cash out', t: 'A $4,000 headline makes a $5 cash out feel like losing.', m: 'share of players who cash out, time to first cash out' },
  { h: 'Word of mouth', t: 'People hesitate to recommend an app that looks like a scam.', m: 'invites sent, “scam” or “fake” in reviews' },
];

const benchmarks = [
  { kind: 'Money apps', h: 'How money should look', apps: ['Cash App', 'Chime', 'Credit Karma'] },
  { kind: 'Rewards and cash back', h: 'How earning should feel', apps: ['Ibotta', 'Fetch', 'Upside'] },
  { kind: 'Store loyalty', h: 'How events and boosts should read', apps: ['Starbucks Rewards', 'Walgreens', 'Dollar General'] },
  { kind: 'Calm games', h: 'How play stays fun without shouting', apps: ['Duolingo', 'Wordscapes', 'Microsoft Solitaire Collection'] },
];

const words = [
  { today: 'Shortcut to big money! 🤑', next: 'Extra cash for everyday needs', why: 'Promises what we can deliver' },
  { today: 'Big Win Alert: Play Now!', next: 'Play Games. Reach a new level. +$5.00', why: 'Says what to do and what it pays' },
  { today: 'Double Your Coins! 200k / 400k', next: 'Complete tasks 7 days in a row and get +$5.00', why: 'Dollars, not coin totals' },
  { today: '$4,000 Treasure Trove', next: '$4,000 shared by [__] winners', why: 'Shows how many people win' },
  { today: 'Buy tickets', next: 'Get tickets for [500] coins', why: 'Clear about the price' },
  { today: '+100$ and $99,99', next: '$100 and $99.99', why: 'The US money format' },
];

const themes = [
  { h: 'A little extra goes a long way', items: ['Gas for the car', 'Weekend errands', 'Your daily coffee'], note: 'A relatable mix of essentials and small pleasures.' },
  { h: 'More reasons to celebrate', items: ['Birthday surprises', 'Gifts for loved ones', 'Special occasions'], note: 'Emotionally warm, and easy to picture.' },
  { h: 'Something extra for your best friend', items: ['Pet food', 'Favorite treats', 'Toys and essentials'], note: 'Pet care brings warmth, personality and strong visual storytelling.' },
  { h: 'Make home a little sweeter', items: ['Household essentials', 'Little home upgrades', 'Everyday comforts'], note: 'Practical, without dwelling on financial hardship.' },
  { h: 'Make room for more fun', items: ['Movie nights', 'Favorite takeout', 'Weekend treats'], note: 'Connects playing games with positive, attainable moments.' },
  { h: 'Stay connected to what matters', items: ['Phone expenses', 'Internet at home', 'Entertainment subscriptions'], note: 'Everyday digital costs, close to home for mobile-first players.' },
];

const changes = [
  { h: 'Wallet on top', t: 'Coins, the time until they convert and Cash out move above the banner, on a calm grey bar.' },
  { h: 'Event banner', t: 'A white timer that counts to the second, no menu button, and carousel dots, so the banner reads as one of several.' },
  { h: 'Double coins', t: 'The daily streak row goes. One line of copy, one progress pill and a pile of coins stay.' },
  { h: 'Invite friends', t: 'The offer becomes the headline, with five avatar slots and an Invite button to show progress.' },
  { h: 'Story card', t: '“Make room for more fun”, the fox’s movie night from the new campaign, replaces “Shortcut to big money!”.' },
];
---

<article class="wrap case bp">
  <!-- the thesis -->
  <section class="sec">
    <div class="sec-head">
      <h2>Why a revamp</h2>
      <div>
        <p class="lede">
          BestPlay pays people to play games: coins add up and convert to cash. Over time its look drifted toward
          a casino, all gold, jackpots and loud promises. The revamp has one message: we don’t want to look like
          another casino app. We want to earn our players’ trust.
        </p>
        <p>
          Trust doesn’t have to mean boring, though. BestPlay isn’t a bank either. The new look stays fun and
          interactive and leaves room for a variety of styles, while looking professional and structured, and
          appealing to a wide, diverse range of people.
        </p>
        {p.link && (
          <p class="out">
            <a class="pill pill-light" href={p.link.href} target="_blank" rel="noopener">{p.link.label}</a>
          </p>
        )}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="scale" data-scale role="img" aria-label="A scale from casino to bank, with BestPlay in the middle: trusted, and still fun">
      <div class="end">
        <p class="eyebrow">Casino</p>
        <p>Gold, jackpots, loud promises. Fun, but hard to trust.</p>
      </div>
      <div class="mid">
        <p class="eyebrow">BestPlay</p>
        <p class="serif">Trusted, and still fun</p>
      </div>
      <div class="end">
        <p class="eyebrow">Bank</p>
        <p>Calm and trusted, but no fun at all.</p>
      </div>
      <div class="line" aria-hidden="true"><i></i></div>
    </div>
    <ul class="principles" role="list">
      {principles.map((x) => <li><h3>{x.h}</h3><p>{x.t}</p></li>)}
    </ul>
  </section>

  <!-- chapter 1: an honest look -->
  <section class="sec">
    <div class="sec-head">
      <h2>What Home says today</h2>
      <div><p>First, an honest look at two live versions of Home, and what a new player takes in during their first few seconds.</p></div>
    </div>
    <div class="review">
      <div class="screens">
        <figure class="phone">
          <img src={art('home-1000')} width="524" height="1280" loading="lazy" decoding="async" alt="BestPlay Home with a $1,000 race banner, the coin balance, a Double your coins streak, the Mission Board and Special Offers" />
          <span class="pin" style="--x:86%;--y:12%" aria-hidden="true">1</span>
        </figure>
        <figure class="phone">
          <img src={art('home-4000')} width="488" height="1034" loading="lazy" decoding="async" alt="BestPlay Home with the $4,000 Treasure Trove banner, the coin balance, Invite Friends, Shortcut to big money and the Mission Board" />
          <span class="pin" style="--x:22%;--y:15%" aria-hidden="true">2</span>
          <span class="pin" style="--x:88%;--y:46%" aria-hidden="true">3</span>
        </figure>
      </div>
      <ol class="notes" role="list">
        {review.map((r, i) => (
          <li>
            <span class="pin static" aria-hidden="true">{i + 1}</span>
            <h3>{r.h}</h3>
            <p>{r.t}</p>
          </li>
        ))}
      </ol>
    </div>

    <div class="pair">
      <figure class="shot">
        <img src={art('fox-everywhere')} width="1231" height="861" loading="lazy" decoding="async" alt="Three BestPlay screens with the fox circled on almost every card: the earning mode picker and two versions of Home" />
      </figure>
      <div class="note">
        <span class="pin static" aria-hidden="true">4</span>
        <h3>A fox everywhere</h3>
        <p>
          The same fox, in a suit, on almost every card feels like a lack of ideas. And nothing on screen shows the
          everyday things our players relate to.
        </p>
      </div>
    </div>
    <div class="pair flip">
      <div class="note">
        <span class="pin static" aria-hidden="true">5</span>
        <h3>Space, but no guidance</h3>
        <p>
          The Double coins streak takes a big part of Home and only opens a static popup. It could guide the day
          instead: today’s tasks, how far along they are, and what each one pays.
        </p>
      </div>
      <div class="duo">
        <figure class="shot">
          <img src={art('streak-today')} width="767" height="876" loading="lazy" decoding="async" alt="Today: the Double coins streak on Home, and the static Coin goal popup it opens" />
          <figcaption>Today: a streak, and a static popup</figcaption>
        </figure>
        <figure class="shot">
          <img src={art('streak-guided')} width="387" height="874" loading="lazy" decoding="async" alt="A sketch of a guided day: Day 4, finish 5 tasks, each with its progress, reward and a Play button, then open the Safe" />
          <figcaption>A sketch: the day as tasks</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- chapter 2: the drift -->
  <section class="sec">
    <div class="sec-head">
      <h2>How the style drifted</h2>
      <div><p class="quote">“We started light, casual and whimsical, and ended up dark, commercial and hardcore.”</p></div>
    </div>
    <div class="drift" aria-label="Then: light, casual, whimsical. Now: dark, commercial, hardcore.">
      <div class="then">
        <span class="label">Then</span>
        <span class="chip">light</span><span class="chip">casual</span><span class="chip">whimsical</span>
      </div>
      <span class="arrow" aria-hidden="true">→</span>
      <div class="now">
        <span class="label">Now</span>
        <span class="chip">dark</span><span class="chip">commercial</span><span class="chip">hardcore</span>
      </div>
    </div>
    <div class="collage">
      <img src={art('drift-popups')} width="1100" height="788" loading="lazy" decoding="async" alt="Two Weekly Tournament popups promising a $100K pool of real cash every week" />
      <img src={art('drift-vault')} width="420" height="1026" loading="lazy" decoding="async" alt="A dark $2,000 Black Vault community challenge" />
      <img src={art('drift-mall')} width="1000" height="750" loading="lazy" decoding="async" alt="The fox in sunglasses and a suit with a gold cash register and shopping bags in a shiny mall" />
    </div>
    <div class="notes2">
      <div class="note">
        <h3>A style anyone can pick up</h3>
        <p>
          If the style no longer serves the product, it can’t support production either. In a fast-paced team,
          anyone should be able to pick it up and replicate it, with AI too.
        </p>
      </div>
      <div class="note">
        <h3>Light, and dark at night</h3>
        <p>
          A lighter UI lets any kind of graphics sit on it, and makes a dark theme easy: a must these days for
          players who play late at night, since it’s easier on the eyes.
        </p>
      </div>
    </div>
  </section>

  <!-- chapter 3: the research, as a deck -->
  <section class="sec">
    <div class="sec-head">
      <h2>What the research says</h2>
      <div><p>Who the players are, what they fear, and what the current look costs. From the deck that started the revamp.</p></div>
    </div>
  </section>

  <div class="deck">
    <section class="panel">
      <p class="eyebrow">Who we design for</p>
      <h2 class="serif">Our players are older, lower-income and live on their phones</h2>
      <ul class="stats" role="list">
        {stats.map((s) => <li><span class="big serif">{s.n}</span><p>{s.t}<sup><a href={`#src-${s.src}`} aria-label={`Source ${s.src}`}>{s.src}</a></sup></p></li>)}
      </ul>
    </section>

    <section class="panel">
      <p class="eyebrow">What they’ve learned</p>
      <h2 class="serif">They have good reason to distrust apps that pay for tasks</h2>
      <div class="ftc">
        <figure class="bars" aria-label="Job scam losses reported to the FTC: $90M in 2020, $501M in 2024">
          <figcaption>Job scam losses reported to the FTC<sup><a href="#src-3" aria-label="Source 3">3</a></sup></figcaption>
          <div class="plot" aria-hidden="true">
            <div class="bar" style="--h:18%"><b>$90M</b><span>2020</span></div>
            <div class="bar dark" style="--h:100%"><b>$501M</b><span>2024</span></div>
          </div>
        </figure>
        <div class="ftc-side">
          <p class="big serif">$750.6M</p>
          <p>lost to business and job opportunity scams in 2024, up nearly $250M in a year.<sup><a href="#src-3" aria-label="Source 3">3</a></sup> The FTC links much of the rise to gamified “task scams”.<sup><a href="#src-4" aria-label="Source 4">4</a></sup></p>
          <p class="rule">“Earn money doing simple tasks in an app” describes BestPlay. It also describes these scams. <strong>Our look has to show the difference.</strong></p>
        </div>
      </div>
    </section>

    <section class="panel">
      <p class="eyebrow">What they fear</p>
      <h2 class="serif">Even real prizes can’t beat the fear</h2>
      <div class="fear">
        <div class="fear-text">
          <p>
            Temu gives away real prizes, smart watches, tablets, even sofas, yet most people are too scared of scams
            to take part: scared their card details and private data will be stolen. Plenty of YouTubers and
            TikTokers explain how it works, and the fear still wins. Older players often don’t know a virtual card
            can keep a one-off purchase safe.
          </p>
          <blockquote class="serif">
            Temu’s loud interface kept me away for a long time too. Then it dropped most of the screaming titles and
            got calmer and more stylish.
          </blockquote>
        </div>
        <figure class="shot">
          <img src={art('temu')} width="735" height="676" loading="lazy" decoding="async" alt="Temu’s home screen before and after its redesign: from red sale banners and FREE badges to a calm white layout" />
          <figcaption>Temu before and after: fewer screaming titles, a calmer look</figcaption>
        </figure>
      </div>
    </section>

    <section class="panel green">
      <p class="eyebrow">Why the look matters</p>
      <div class="credible">
        <p class="huge serif">46%</p>
        <p>of people’s comments on why a website seemed credible were about its design look, the most mentioned factor. For finance sites it was 55%.<sup><a href="#src-5" aria-label="Source 5">5</a></sup></p>
      </div>
      <p class="serif say">People judge whether to trust a service by how it looks. Before a player ever cashes out, the look is all the evidence they have.</p>
    </section>

    <section class="panel">
      <p class="eyebrow">What a wary player reads</p>
      <h2 class="serif">Six cues that read as casino or kids’ game</h2>
      <ul class="cues" role="list">
        {cues.map((c) => (
          <li>
            <p class="cue">{c.cue}</p>
            <p class="where">{c.where}</p>
            <p class="bubble serif">“{c.read}”</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="panel">
      <p class="eyebrow">What it costs</p>
      <h2 class="serif">Where the current look likely costs us</h2>
      <ol class="steps" role="list">
        {costs.map((c, i) => (
          <li>
            <p class="eyebrow">Step {i + 1}</p>
            <h3>{c.h}</h3>
            <p>{c.t}</p>
            <p class="measure"><strong>Measure:</strong> {c.m}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="panel">
      <p class="eyebrow">Benchmarks</p>
      <h2 class="serif">We benchmark against four kinds of apps</h2>
      <ul class="bench" role="list">
        {benchmarks.map((b) => (
          <li>
            <p class="eyebrow">{b.kind}</p>
            <h3>{b.h}</h3>
            <ul role="list">{b.apps.map((a) => <li>{a}</li>)}</ul>
          </li>
        ))}
      </ul>
      <div class="bench-notes">
        <p><strong>Not on the list: other earn-money apps.</strong> Many share our current look, so copying them won’t help us stand out.</p>
        <p><strong>Principles, not screens.</strong> We study why these apps feel trustworthy and calm, then draw our own.</p>
      </div>
    </section>

    <section class="panel">
      <p class="eyebrow">Research</p>
      <h2 class="serif">Which car-wash card gets finished more often?</h2>
      <div class="wash" data-wash>
        <div class="card">
          <span class="tag">19% finished</span>
          <p class="eyebrow">Card A</p>
          <div class="stamp-card">
            <p class="serif">Buy 8 washes, get 1 free</p>
            <div class="dots" aria-hidden="true">{Array.from({ length: 8 }, () => <i />)}</div>
            <p class="small">8 washes to go</p>
          </div>
        </div>
        <div class="card">
          <span class="tag win">34% finished</span>
          <p class="eyebrow">Card B</p>
          <div class="stamp-card">
            <p class="serif">Buy 10 washes, get 1 free</p>
            <div class="dots" aria-hidden="true">{Array.from({ length: 10 }, (_, i) => <i class:list={[i < 2 && 'on']} style={`--k:${i}`} />)}</div>
            <p class="small">2 stamps free, so also 8 washes to go</p>
          </div>
        </div>
      </div>
      <p class="serif say dark">A head start nearly doubled completion.<sup><a href="#src-6" aria-label="Source 6">6</a></sup> <span>Start weekly goals and streaks with progress already counted.</span></p>
    </section>

    <section class="panel">
      <p class="eyebrow">Words</p>
      <h2 class="serif">The words change with the pictures</h2>
      <ul class="words" role="list">
        {words.map((w) => (
          <li>
            <p class="was"><span class="visually-hidden">Today: </span><s>{w.today}</s></p>
            <p class="becomes serif"><span class="visually-hidden">Proposed: </span>{w.next}</p>
            <p class="why">{w.why}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="panel sources" aria-labelledby="bp-sources">
      <h2 id="bp-sources" class="eyebrow">Sources</h2>
      <ol role="list">
        {sources.map((x, i) => (
          <li id={`src-${i + 1}`}>
            <span class="sn">{i + 1}</span>
            <p>{x.t} <a href={x.href} target="_blank" rel="noopener">Link</a></p>
          </li>
        ))}
      </ol>
    </section>
  </div>

  <!-- chapter 4: where the look is going -->
  <section class="sec">
    <div class="sec-head">
      <h2>Where the look is going</h2>
      <div>
        <p>
          The fun stays: spins, daily rewards, bright 3D objects, game art and little moments of surprise. What
          changes is the frame around them, calmer and more structured, so they read as play, not as a jackpot.
        </p>
      </div>
    </div>
    <figure class="shot mood">
      <img src={art('moodboard')} width="1600" height="905" loading="lazy" decoding="async" alt="Moodboard: a prize wheel, a shop feed, icons for play games, complete tasks, daily rewards and invite and earn, a 3D Happy Diwali, sports objects in 3D, a $60 ticket, a claw machine, a daily reward gift box and a grid of game icons" />
      <figcaption>The moodboard: references for the playful side of the new look.</figcaption>
    </figure>
  </section>

  <section class="sec">
    <div class="campaign">
      <div class="campaign-text">
        <p class="eyebrow">The campaign</p>
        <p class="headline serif">“A little extra goes a long way.”</p>
        <p>
          The message behind the new look. It feels American, relatable and optimistic, without exaggerating how
          much players can earn. It celebrates small financial wins that make everyday life easier, and moments of
          happiness: family, pets, personal treats and everyday freedom.
        </p>
        <p class="aside serif">We want players to think, “That would be nice to have a little extra money for.” So it feels like a real app.</p>
      </div>
      <figure class="shot">
        <img src={art('campaign')} width="861" height="459" loading="lazy" decoding="async" alt="Campaign card: More for what matters most, with a grocery bag and a bill, and ticks for groceries, bills and everyday expenses" />
      </figure>
    </div>
    <ol class="themes" role="list">
      {themes.map((t, i) => (
        <li>
          <div class="theme-top">
            <img src={art(`theme-${i + 1}`)} width="146" height="146" loading="lazy" decoding="async" alt="" />
            <span class="num serif" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          </div>
          <h3>{t.h}</h3>
          <ul class="chips" role="list">{t.items.map((x) => <li>{x}</li>)}</ul>
          <p class="small">{t.note}</p>
        </li>
      ))}
    </ol>
    <div class="foxes">
      <figure class="shot">
        <img src={art('fox-market')} width="760" height="955" loading="lazy" decoding="async" alt="The fox in a sweater, walking home from an autumn market with a bag of groceries" />
      </figure>
      <figure class="shot">
        <img src={art('fox-movie')} width="1300" height="644" loading="lazy" decoding="async" alt="The fox in a hoodie on the sofa with a bowl of popcorn, a movie night at home" />
      </figure>
    </div>
    <p class="fox">
      <strong>And the fox?</strong> It stays, but leaves the suit and the briefcase of cash for everyday life: a market
      stroll, a movie night at home. The movie night now leads the “Make room for more fun” card on Home.
    </p>
  </section>

