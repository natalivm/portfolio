---
/**
 * BestPlay: visual development for a revamp of the app. The film at the top of the page
 * (HomeRevampFilm) replays the home screen redesign on the real screens; this is the text under it.
 */
import type { Project } from '../../data/projects';

interface Props {
  project: Project;
}
const { project: p } = Astro.props;

const changes = [
  { h: 'Wallet on top', t: 'Coins, the time until they convert and Cash out move above the banner, on a calm grey bar.' },
  { h: 'Event banner', t: 'A white timer that counts to the second, no menu button, and carousel dots, so the banner reads as one of several.' },
  { h: 'Double coins', t: 'The daily streak row goes. One line of copy, one progress pill and a pile of coins stay.' },
  { h: 'Invite friends', t: 'The offer becomes the headline, with five avatar slots and an Invite button to show progress.' },
  { h: 'Story card', t: 'A full-width card with its own timer and steps replaces the old promo.' },
];
---

<article class="wrap case">
  <section class="sec">
    <div class="sec-head">
      <h2>The revamp</h2>
      <div>
        <p>
          BestPlay is a games app where play earns coins that convert to cash. The work was visual development
          for a revamp of the app, starting with Home: the same content, in a clearer order, on calmer surfaces.
        </p>
        <p>The film above replays the redesign on the real screens, one change at a time. Pick a step to jump to it.</p>
        {p.link && (
          <p class="out">
            <a class="pill pill-light" href={p.link.href} target="_blank" rel="noopener">{p.link.label}</a>
          </p>
        )}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="sec-head">
      <h2>Home, step by step</h2>
      <div><p>Five changes, in the order the film makes them.</p></div>
    </div>
    <ol class="changes" role="list">
      {changes.map((c, i) => (
        <li>
          <span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3>{c.h}</h3>
          <p>{c.t}</p>
        </li>
      ))}
    </ol>
  </section>
</article>

<style>
  .case {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(64px, 8vw, 112px);
    margin-top: clamp(56px, 7vw, 96px);
  }
  .sec {
    display: grid;
    gap: clamp(24px, 3vw, 40px);
  }
  .sec-head {
    display: grid;
    grid-template-columns: minmax(10rem, 1fr) minmax(0, 2fr);
    gap: 16px clamp(32px, 6vw, 96px);
  }
  .sec-head h2 {
    font-size: clamp(1.5rem, 2.2vw, 2rem);
  }
  .sec-head p {
    max-width: 64ch;
    font-size: 1.125rem;
  }
  .sec-head p + p {
    margin-top: 0.8em;
  }
  .out {
    margin-top: 20px;
  }
  .changes {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 24px clamp(16px, 2vw, 28px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .changes li {
    display: grid;
    align-content: start;
    gap: 8px;
    padding-top: 16px;
    border-top: 2px solid var(--ink);
  }
  .n {
    color: var(--accent);
    font: 600 0.8125rem/1 var(--font-ui);
    letter-spacing: 0.06em;
  }
  h3 {
    font-size: clamp(1.0625rem, 1.4vw, 1.2rem);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .changes p {
    color: var(--ink-2);
  }
  @media (max-width: 1000px) {
    .changes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 720px) {
    .sec-head,
    .changes {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
