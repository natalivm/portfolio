</article>

<script>
  // the scale's marker settles in the middle, the pins drop in, and the head-start stamps land, each as it comes into view
  const io = new IntersectionObserver((es) => es.forEach((e) => {
    if (!e.isIntersecting) return;
    e.target.classList.add('seen');
    io.unobserve(e.target);
  }), { threshold: 0.35 });
  document.querySelectorAll('[data-wash], [data-scale], .review').forEach((el) => {
    el.classList.add('armed');
    io.observe(el);
  });
</script>

