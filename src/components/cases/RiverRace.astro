---
/**
 * River Race, a timed event in Sort Journey (Bluetile Games). Everything is the game's own art,
 * exported from the feature's Figma file. The race board is rebuilt from its layers so it can be
 * played: win a level to hop up a lily pad, fail one and you're in the water.
 */
import type { Project } from '../../data/projects';

interface Props {
  project: Project;
}
const { project: p } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const art = (name: string) => `${base}/cases/river-race/${name}.webp`;

const rules = [
  { name: 'Line up', text: 'The event opens with a timer, and the racers wait together on the dock.' },
  { name: 'Win to hop', text: 'Every level won on the first try moves you one lily pad up the river.' },
  { name: 'Fail and you’re out', text: 'Lose a single level and you slip into the water. Your race is over.' },
  { name: 'Reach the shore', text: 'The first three across take the trophies. Everyone else who makes it still gets a prize.' },
];

// The board, in % of its own box (9:16). Pads climb from the dock to the island; y is each pad's centre.
const PADS = [
  { x: 40, y: 83, w: 28, k: 7 },
  { x: 22, y: 76.5, w: 26, k: 6 },
  { x: 35, y: 70, w: 24, k: 5 },
  { x: 56, y: 64.5, w: 22.5, k: 4 },
  { x: 70, y: 59, w: 21, k: 3 },
  { x: 55, y: 54, w: 19.5, k: 2 },
  { x: 35, y: 49.5, w: 18, k: 4 },
  { x: 24, y: 45, w: 16.5, k: 5 },
  { x: 40, y: 41, w: 15.5, k: 3 },
  { x: 58, y: 37, w: 14.5, k: 2 },
];
const RACERS = [
  { id: 'you', img: 'corgi-crown', name: 'You', dock: { x: 70, y: 95 } },
  { id: 'pink', img: 'pet-pink', name: 'Pink', dock: { x: 63, y: 90 } },
  { id: 'purple', img: 'pet-purple', name: 'Purple', dock: { x: 75, y: 89 } },
  { id: 'blue', img: 'pet-purple', name: 'Blue', tint: 'hue-rotate(-62deg) saturate(1.15)', dock: { x: 86, y: 90 } },
  { id: 'orange', img: 'pet-pink', name: 'Orange', tint: 'hue-rotate(52deg) saturate(1.2)', dock: { x: 95, y: 94 } },
];

const layers = [
  { n: 'The river', t: 'One painted surface, calm in the middle and darker at the banks, so pads and racers read on top.' },
  { n: 'The shore', t: 'A jungle island at the top of the screen: the finish line, and the only place with depth.' },
  { n: 'Ten lily pads', t: 'One per level, smaller as they climb, so the path is the progress bar.' },
  { n: 'Dock and signs', t: 'Where the race starts, and two wooden signs for your level and how many have finished.' },
  { n: 'The prizes', t: 'Gold, silver and bronze on a heap of coins, on show from the first second.' },
  { n: 'The racers', t: 'You in a crown, the others in one bright colour each, so the pack reads at a glance.' },
];

const boardScreens = [
  { img: 'race-info', h: 'The rules, three lines', t: 'Win on your first try to move up. Fail and you’re out. Reach the shore for the rewards.', alt: 'River Race rules: win levels on your first try to progress, fail and you are out, reach the shore for rewards' },
  { img: 'race-1', h: 'Everyone on the dock', t: 'The race starts with the whole pack seen from behind, looking up the river at the prizes.', alt: 'River Race board at the start: pets on the dock, ten lily pads up to an island with three trophies' },
  { img: 'race-3', h: 'One pad per win', t: 'Racers that share a pad crowd onto it, and your tag shows your place.', alt: 'River Race board mid-race: the player is 6th, sharing a pad with two other pets' },
  { img: 'race-4', h: 'First to the shore', t: 'The winner takes the gold spot on the island, crown and all.', alt: 'River Race board: the crowned corgi has reached the island first and stands on the gold trophy' },
];
const fillScreens = [
  { img: 'race-5', alt: 'River Race board: a pink pet has taken first place while the player is 3rd on a pad' },
  { img: 'race-6', alt: 'River Race board: pink first and purple second on the island, the player still 3rd' },
  { img: 'race-7', alt: 'River Race board: all three podium places taken, a pet that failed bobs in the water' },
];

const popups = [
  { img: 'popup-started', name: 'Event started', alt: 'Popup: River Race event started, with the timer and the player on a lily pad' },
  { img: 'popup-moves', name: 'No more moves', alt: 'Popup: no more moves, shuffle the board to keep playing' },
  { img: 'popup-sure', name: 'Are you sure?', alt: 'Popup: are you sure, only 5 levels left to the reward, you will lose your achievements' },
  { img: 'popup-abandoned', name: 'Out of the race', alt: 'Popup: event abandoned, you failed the race, better luck next time' },
  { img: 'popup-ended', name: 'Event ended', alt: 'Popup: River Race event ended, better luck next time, over an empty river' },
];

const rewards = [
  { img: 'reward-1', name: '1st', alt: 'Reward screen: congratulations, you are 1st, a gold trophy with a crown in leaves' },
  { img: 'reward-2', name: '2nd', alt: 'Reward screen: you are 2nd, a silver trophy on a silver pedestal' },
  { img: 'reward-3', name: '3rd', alt: 'Reward screen: you are 3rd, a bronze trophy on a bronze pedestal' },
  { img: 'reward-4', name: 'Made it', alt: 'Reward screen: you finished 11th, a gift to cheer you up' },
  { img: 'reward-5', name: 'Claim', alt: 'Reward screen: three gems to claim' },
];
const trophies = [
  { img: 'trophy-gold', label: '1st', h: 100, alt: 'Gold trophy with a crown' },
  { img: 'trophy-silver', label: '2nd', h: 84, alt: 'Silver trophy' },
  { img: 'trophy-bronze', label: '3rd', h: 78, alt: 'Bronze trophy' },
  { img: 'gift', label: 'Made it', h: 70, alt: 'A gift box with a blue bow' },
];

const homes = [
  { img: 'home-1', h: 'Won', t: 'Gold in the corner of Home, counting down to the next race.', alt: 'Home screen with the gold River Race badge and a timer, top left' },
  { img: 'home-2', h: 'Second', t: 'The badge carries the trophy you won.', alt: 'Home screen with the silver River Race badge' },
  { img: 'home-3', h: 'Third', t: 'Bronze, in the same leaves.', alt: 'Home screen with the bronze River Race badge' },
  { img: 'home-4', h: 'Made it', t: 'A gift with your place on it.', alt: 'Home screen with a gift badge marked 10' },
];

const backs = ['blue', 'purple', 'lilac', 'orange', 'apricot', 'brown', 'cocoa', 'green'];

const principles = [
  { h: 'The path is the progress bar', t: 'Ten pads for ten levels, the island as the finish. Players read how far they have come without a number.' },
  { h: 'Find yourself in a crowd', t: 'You wear the crown and a pink tag with your place. Everyone else is one flat, bright colour.' },
  { h: 'Show the prize from the start', t: 'The trophies stand on the island for the whole race, so there is always something to climb toward.' },
  { h: 'Lose kindly', t: 'A racer who fails bobs in the water instead of vanishing, and finishers outside the top three still get a gift.' },
  { h: 'Familiar frame, new world', t: 'Popups keep the game’s blue ribbon, close button and one yellow action. Only the scenery is new.' },
];
---

<article class="wrap case">
  <div class="rr-pads" aria-hidden="true">
    {[
    { s: 'r', t: -15, o: 20, w: 78, k: 4, r: 8 },
    { s: 'l', t: -8, o: 22, w: 66, k: 6, r: -6 },
    { s: 'l', t: 2, o: 18, w: 84, k: 3, r: -10 },
    { s: 'r', t: 6, o: 22, w: 70, k: 5, r: 12 },
    { s: 'l', t: 13, o: 40, w: 58, k: 6, r: 6 },
    { s: 'r', t: 18, o: 14, w: 88, k: 2, r: -6 },
    { s: 'l', t: 25, o: 12, w: 74, k: 4, r: 14 },
    { s: 'r', t: 31, o: 38, w: 60, k: 6, r: -12 },
    { s: 'l', t: 38, o: 30, w: 90, k: 2, r: 4 },
    { s: 'r', t: 44, o: 20, w: 76, k: 3, r: 9 },
    { s: 'l', t: 51, o: 16, w: 62, k: 5, r: -8 },
    { s: 'r', t: 57, o: 30, w: 86, k: 4, r: -3 },
    { s: 'l', t: 64, o: 28, w: 78, k: 7, r: 10 },
    { s: 'r', t: 70, o: 12, w: 64, k: 6, r: 16 },
    { s: 'l', t: 77, o: 14, w: 86, k: 3, r: -14 },
    { s: 'r', t: 83, o: 26, w: 80, k: 2, r: 6 },
    { s: 'l', t: 90, o: 36, w: 60, k: 5, r: 2 },
    { s: 'r', t: 96, o: 16, w: 72, k: 4, r: -9 },
    ].map((d) => (
      <img class={d.s} src={art(`pad-${d.k}`)} width="300" height="120" alt="" loading="lazy" decoding="async" style={`--t:${d.t}%;--o:${d.o}px;--w:${d.w}px;--r:${d.r}deg`} />
    ))}
  </div>
  <section class="sec">
    <div class="sec-head" data-fig>
      <h2 class="ribbon"><span>River Race</span></h2>
      <div>
        <p>
          River Race is a timed event in Sort Journey, a puzzle game by Bluetile Games. Racers start
          together on a dock and climb a river of lily pads, one pad for every level won on the first try.
          One loss and you fall in. The first three to reach the island win trophies.
        </p>
        <p>The work covered the race board and its art, the racers, the rewards, the popups and how the event lives on Home.</p>
        {p.link && (
          <p class="out">
            <a class="pill pill-light" href={p.link.href} target="_blank" rel="noopener">{p.link.label}</a>
          </p>
        )}
      </div>
    </div>
    <ol class="structure" role="list">
      {rules.map((s, i) => (
        <li>
          <span class="step" aria-hidden="true">{i + 1}</span>
          <h3>{s.name}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="sec">
    <div class="sec-head" data-fig>
      <h2 class="ribbon"><span>Play the race</span></h2>
      <div>
        <p>The board, rebuilt from the game’s own layers. It races by itself; press a button to take over.</p>
      </div>
    </div>

    <figure class="fig race" data-fig data-race data-pads={JSON.stringify(PADS)} data-racers={JSON.stringify(RACERS.map((r) => ({ id: r.id, dock: r.dock })))}>
      <div class="board" data-board>
        <img class="b-water" src={art('water')} width="1290" height="1723" alt="" loading="lazy" decoding="async" />
        <img class="b-shore" src={art('shore')} width="1320" height="1191" alt="" loading="lazy" decoding="async" />
        <img class="b-pod" src={art('pod')} width="1000" height="451" alt="" loading="lazy" decoding="async" />
        <div class="b-sign l"><img src={art('sign')} width="406" height="420" alt="" loading="lazy" decoding="async" /><span>Level<b data-level>0/10</b></span></div>
        <div class="b-sign r"><img src={art('sign')} width="406" height="420" alt="" loading="lazy" decoding="async" /><span>Players<b data-done>0/5</b></span></div>
        {PADS.map((pd, i) => (
          <img class="b-pad" data-pad={i} src={art(`pad-${pd.k}`)} width="300" height="120" alt="" loading="lazy" decoding="async" style={`--x:${pd.x}%;--y:${pd.y}%;--w:${pd.w}%;--i:${i}`} />
        ))}
        <img class="b-dock" src={art('dock')} width="720" height="526" alt="" loading="lazy" decoding="async" />
        {RACERS.map((r) => (
          <div class:list={['racer', r.id === 'you' && 'me']} data-racer={r.id} style={`--x:${r.dock.x}%;--y:${r.dock.y}%;--s:1`}>
            <img src={art(r.img)} width="216" height="260" alt="" loading="lazy" decoding="async" style={r.tint ? `filter:${r.tint}` : undefined} />
            {r.id === 'you' && <span class="you">You <b data-rank>1st</b></span>}
          </div>
        ))}
        <div class="result" data-result hidden>
          <div class="result-card">
            <img data-result-img src={art('trophy-gold')} width="328" height="480" alt="" />
            <p class="r-title" data-result-title>Congratulations!</p>
            <p class="r-sub" data-result-sub>You’re 1st!</p>
          </div>
        </div>
      </div>

      <div class="race-side">
        <ol class="race-steps" role="list">
          <li><span class="step" aria-hidden="true">1</span>Every first-try win: one pad up.</li>
          <li><span class="step" aria-hidden="true">2</span>One loss: into the water.</li>
          <li><span class="step" aria-hidden="true">3</span>Top three take the trophies.</li>
        </ol>
        <div class="race-ctl">
          <button class="g-btn" type="button" data-win>Level <span data-next>1</span></button>
          <button class="g-btn fail" type="button" data-fail>Fail this level</button>
          <button class="g-btn again" type="button" data-again hidden>Race again</button>
        </div>
        <p class="race-status" aria-live="polite" data-status>Five racers on the dock. You wear the crown.</p>
      </div>
    </figure>
  </section>

  <section class="sec">
    <div class="sec-head" data-fig>
      <h2 class="ribbon"><span>Art kit</span></h2>
      <div><p>The board is six layers. Taken apart, each one has a single job.</p></div>
    </div>

    <figure class="fig stack-fig" data-fig data-stack>
      <div class="stack" aria-hidden="true">
        <div class="stack-in">
          <div class="layer" style="--i:0" data-layer="0"><img class="b-water" src={art('water')} width="1290" height="1723" alt="" loading="lazy" decoding="async" /></div>
          <div class="layer" style="--i:1" data-layer="1"><img class="b-shore" src={art('shore')} width="1320" height="1191" alt="" loading="lazy" decoding="async" /></div>
          <div class="layer" style="--i:2" data-layer="2">
            {PADS.map((pd) => (
              <img class="b-pad" src={art(`pad-${pd.k}`)} width="300" height="120" alt="" loading="lazy" decoding="async" style={`--x:${pd.x}%;--y:${pd.y}%;--w:${pd.w}%`} />
            ))}
          </div>
          <div class="layer" style="--i:3" data-layer="3">
            <img class="b-dock" src={art('dock')} width="720" height="526" alt="" loading="lazy" decoding="async" />
            <div class="b-sign l"><img src={art('sign')} width="406" height="420" alt="" loading="lazy" decoding="async" /></div>
            <div class="b-sign r"><img src={art('sign')} width="406" height="420" alt="" loading="lazy" decoding="async" /></div>
          </div>
          <div class="layer" style="--i:4" data-layer="4"><img class="b-pod" src={art('pod')} width="1000" height="451" alt="" loading="lazy" decoding="async" /></div>
          <div class="layer" style="--i:5" data-layer="5">
            {[
              { img: 'corgi-crown', x: 56, y: 64.5, s: 0.82 },
              { img: 'pet-pink', x: 35, y: 70, s: 0.86 },
              { img: 'pet-purple', x: 40, y: 41, s: 0.56 },
              { img: 'pet-pink', x: 70, y: 95, s: 1, tint: 'hue-rotate(52deg) saturate(1.2)' },
              { img: 'pet-purple', x: 84, y: 90, s: 1, tint: 'hue-rotate(-62deg) saturate(1.15)' },
            ].map((r) => (
              <div class="racer still" style={`--x:${r.x}%;--y:${r.y}%;--s:${r.s}`}>
                <img src={art(r.img)} width="216" height="260" alt="" loading="lazy" decoding="async" style={r.tint ? `filter:${r.tint}` : undefined} />
              </div>
            ))}
          </div>
        </div>
      </div>
      <div class="stack-side">
        <ol class="legend" role="list">
          {layers.map((l, i) => (
            <li data-legend={i}>
              <button type="button" data-pick={i}>
                <span class="step" aria-hidden="true">{i + 1}</span>
                <span class="lg-text"><strong>{l.n}</strong><span>{l.t}</span></span>
              </button>
            </li>
          ))}
        </ol>
        <button class="pill pill-light stack-toggle" type="button" data-toggle aria-pressed="true">Put it together</button>
      </div>
    </figure>

    <div class="cast" data-fig>
      <div class="cast-row">
        <h3>The racers</h3>
        <p>One model, one bright colour each. From behind on the dock, facing you on the pads.</p>
        <ul class="backs" role="list">
          {backs.map((b, i) => (
            <li class="rise" style={`--k:${i}`}><img src={art(`back-${b}`)} width="192" height="240" alt={`A ${b} pet seen from behind`} loading="lazy" decoding="async" /></li>
          ))}
        </ul>
        <ul class="fronts" role="list">
          <li class="rise" style="--k:2"><img src={art('corgi-crown')} width="201" height="300" alt="The player: a corgi wearing a gold crown" loading="lazy" decoding="async" /><span>You</span></li>
          <li class="rise" style="--k:3"><img src={art('pet-pink')} width="210" height="260" alt="A pink pet facing forward" loading="lazy" decoding="async" /><span>Rival</span></li>
          <li class="rise" style="--k:4"><img src={art('pet-purple')} width="214" height="260" alt="A purple pet facing forward" loading="lazy" decoding="async" /><span>Rival</span></li>
        </ul>
      </div>
      <div class="cast-row">
        <h3>Prizes</h3>
        <p>Each trophy pops up out of its leaves; the gift is for everyone who finishes.</p>
        <ul class="trophies" role="list">
          {trophies.map((t, i) => (
            <li class="trophy" style={`--i:${i};--h:${t.h}%`} data-trophy>
              <img class="leaf" src={art('leaves')} width="700" height="545" alt="" loading="lazy" decoding="async" />
              <img class="cup" src={art(t.img)} width="328" height="480" alt={t.alt} loading="lazy" decoding="async" />
              <span class="place">{t.label}</span>
            </li>
          ))}
        </ul>
      </div>
      <img class="pins rise" src={art('pins')} width="1400" height="158" alt="Seven map pins in the racers’ colours" loading="lazy" decoding="async" />
    </div>

    <ul class="notes cols" role="list">
      <li><h3>Painted with AI, finished by edit</h3><p>The racers, pads, signs and prizes were generated with AI image tools, then refined with follow-up edits: leaves and water taken out, backgrounds removed, edges cleaned for the river.</p></li>
      <li><h3>Built to be assembled</h3><p>Every piece is a separate layer, so the game places pads, racers and trophies in code, and numbers sit on the trophies as live text.</p></li>
    </ul>
  </section>

  <section class="sec">
    <div class="sec-head" data-fig>
      <h2>The board</h2>
      <div><p>Four moments of one race, as they were drawn.</p></div>
    </div>
    <ol class="phones four" role="list" data-fig>
      {boardScreens.map((sc, i) => (
        <li class="rise" style={`--k:${i}`}>
          <img src={art(sc.img)} width="640" height="1387" alt={sc.alt} loading="lazy" decoding="async" />
          <h3>{sc.h}</h3>
          <p>{sc.t}</p>
        </li>
      ))}
    </ol>
    <div class="fill" data-fig>
      <div class="fill-text">
        <h3>The podium fills up</h3>
        <p>Whoever reaches the island first takes the gold spot; the next two take silver and bronze. A racer who failed bobs in the water near the start.</p>
      </div>
      <ol class="fill-phones" role="list">
        {fillScreens.map((sc, i) => (
          <li class="rise" style={`--k:${i}`}><img src={art(sc.img)} width="640" height="1387" alt={sc.alt} loading="lazy" decoding="async" /></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="sec">
    <div class="sec-head" data-fig>
      <h2>Popups</h2>
      <div><p>The game’s own popup frame, with the river inside it. Leaving early always asks first.</p></div>
    </div>
    <ol class="popups" role="list" data-fig>
      {popups.map((pp, i) => (
        <li class="rise" style={`--k:${i}`}>
          <img src={art(pp.img)} width="640" height="1387" alt={pp.alt} loading="lazy" decoding="async" />
          <p>{pp.name}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="sec">
    <div class="sec-head" data-fig>
      <h2 class="ribbon"><span>Rewards</span></h2>
      <div>
        <p>A trophy in its leaves for the top three, a gift for everyone else who finishes, then the prize to claim.</p>
        <p class="aside">Drawn while the event was still called Jungle Race.</p>
      </div>
    </div>
    <ol class="popups" role="list" data-fig>
      {rewards.map((rw, i) => (
        <li class="rise" style={`--k:${i}`}>
          <img src={art(rw.img)} width="640" height="1387" alt={rw.alt} loading="lazy" decoding="async" />
          <p>{rw.name}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="sec">
    <div class="sec-head" data-fig>
      <h2>On Home</h2>
      <div><p>Between races the result stays on Home as a badge in the corner: your trophy in leaves, with the time to the next race.</p></div>
    </div>
    <ol class="phones homes" role="list" data-fig>
      {homes.map((h, i) => (
        <li class="rise" style={`--k:${i}`}>
          <div class="shot">
            <img src={art(h.img)} width="640" height="1387" alt={h.alt} loading="lazy" decoding="async" />
            <span class="lens" aria-hidden="true" style={`background-image:url(${art(h.img)})`}></span>
          </div>
          <h3>{h.h}</h3>
          <p>{h.t}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="sec">
    <div class="sec-head" data-fig>
      <h2 class="ribbon"><span>Art direction</span></h2>
      <div><p>The rules the race was drawn to.</p></div>
    </div>
    <ol class="principles" role="list">
      {principles.map((n, i) => (
        <li>
          <span class="step" aria-hidden="true">{i + 1}</span>
          <h3>{n.h}</h3>
          <p>{n.t}</p>
        </li>
      ))}
    </ol>
  </section>
</article>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

  // Things rise in once, as they come into view; figures play only while on screen.
  const io = new IntersectionObserver((es) => es.forEach((e) => {
    e.target.toggleAttribute('data-live', e.isIntersecting);
    if (e.isIntersecting) e.target.classList.add('seen');
  }), { threshold: 0.2 });
  document.querySelectorAll('[data-fig]').forEach((f) => {
    if (reduce) f.classList.add('seen');
    else f.setAttribute('data-armed', '');
    io.observe(f);
  });

  // ---------- The race ----------
  const race = document.querySelector<HTMLElement>('[data-race]');
  if (race) {
    type Pad = { x: number; y: number; w: number };
    type Racer = { id: string; el: HTMLElement; dock: { x: number; y: number }; pos: number; out: boolean; place: number };
    const pads: Pad[] = JSON.parse(race.dataset.pads!);
    const LAST = pads.length; // pos === LAST: on the island
    const racers: Racer[] = JSON.parse(race.dataset.racers!).map((r: { id: string; dock: { x: number; y: number } }) => ({
      ...r, el: race.querySelector<HTMLElement>(`[data-racer="${r.id}"]`)!, pos: -1, out: false, place: 0,
    }));
    const me = racers[0];
    const $ = (s: string) => race.querySelector<HTMLElement>(s)!;
    const winBtn = $('[data-win]') as HTMLButtonElement;
    const failBtn = $('[data-fail]') as HTMLButtonElement;
    const againBtn = $('[data-again]') as HTMLButtonElement;
    const status = $('[data-status]');
    const result = $('[data-result]');
    const art = (n: string) => (result.querySelector('img') as HTMLImageElement).src.replace(/[^/]+\.webp$/, `${n}.webp`);
    const PODIUM = [{ x: 50, y: 26 }, { x: 68, y: 29 }, { x: 32, y: 29.5 }, { x: 13, y: 35 }, { x: 87, y: 35 }];
    const ord = (n: number) => n + (n % 10 === 1 && n !== 11 ? 'st' : n % 10 === 2 && n !== 12 ? 'nd' : n % 10 === 3 && n !== 13 ? 'rd' : 'th');
    let finished = 0;
    let over = false;

    const place = (r: Racer, hop = true) => {
      let x: number, y: number, s: number;
      if (r.place) ({ x, y } = PODIUM[r.place - 1]), (s = r.place === 1 ? 0.62 : 0.55);
      else if (r.pos < 0) ({ x, y } = r.dock), (s = 1);
      else {
        const pd = pads[r.pos];
        // racers sharing a pad stand side by side
        const mates = racers.filter((o) => !o.place && o.pos === r.pos && !o.out);
        const k = mates.indexOf(r);
        const spread = (k - (mates.length - 1) / 2) * pd.w * 0.3;
        x = pd.x + (r.out ? pd.w * 0.55 : spread);
        y = pd.y + (r.out ? 4 : -0.6);
        s = pd.w / 28;
      }
      r.el.style.setProperty('--x', `${x}%`);
      r.el.style.setProperty('--y', `${y}%`);
      r.el.style.setProperty('--s', String(s));
      if (hop && !reduce) {
        r.el.classList.remove('hop');
        void r.el.offsetWidth;
        r.el.classList.add('hop');
      }
    };
    const ripple = (i: number) => {
      const pad = race.querySelector<HTMLElement>(`[data-pad="${i}"]`);
      if (!pad || reduce) return;
      pad.classList.remove('land');
      void pad.offsetWidth;
      pad.classList.add('land');
    };
    const rank = () => {
      const order = [...racers].sort((a, b) => (a.out !== b.out ? (a.out ? 1 : -1) : a.place && b.place ? a.place - b.place : a.place ? -1 : b.place ? 1 : b.pos - a.pos));
      return order.indexOf(me) + 1;
    };
    const refresh = () => {
      $('[data-level]').textContent = `${Math.max(0, Math.min(me.pos + 1, LAST))}/${LAST}`;
      $('[data-done]').textContent = `${finished}/${racers.length}`;
      $('[data-rank]').textContent = ord(me.place || rank());
      $('[data-next]').textContent = String(Math.min(me.pos + 2, LAST));
    };
    const show = (kind: 'trophy' | 'gift' | 'out') => {
      over = true;
      const img = result.querySelector('img') as HTMLImageElement;
      const t = $('[data-result-title]');
      const sub = $('[data-result-sub]');
      if (kind === 'out') {
        img.src = art('pet-corgi');
        t.textContent = 'Oh no, you slipped!';
        sub.textContent = 'One lost level and you’re out.';
        status.textContent = 'You failed a level and fell in the river. Race again?';
      } else if (kind === 'trophy') {
        img.src = art(['trophy-gold', 'trophy-silver', 'trophy-bronze'][me.place - 1]);
        t.textContent = 'Congratulations!';
        sub.textContent = `You’re ${ord(me.place)}!`;
        status.textContent = `You reached the island ${ord(me.place)} and won a trophy.`;
      } else {
        img.src = art('gift');
        t.textContent = `You finished ${ord(me.place)}!`;
        sub.textContent = 'Not a trophy, but here’s a gift.';
        status.textContent = `You reached the island ${ord(me.place)}: a gift instead of a trophy.`;
      }
      result.dataset.kind = kind;
      result.hidden = false;
      winBtn.hidden = failBtn.hidden = true;
      againBtn.hidden = false;
    };
    const finish = (r: Racer) => {
      finished++;
      r.place = finished;
    };
    const turn = (won: boolean) => {
      if (over) return;
      if (!won) {
        me.out = true;
        me.el.classList.add('out');
        place(me);
        racers.forEach((r) => r !== me && place(r, false));
        refresh();
        setTimeout(() => show('out'), reduce ? 0 : 900);
        return;
      }
      me.pos++;
      if (me.pos >= LAST) finish(me);
      else ripple(me.pos);
      // the others play their own levels
      for (const r of racers) {
        if (r === me || r.out || r.place) continue;
        const roll = Math.random();
        if (r.pos >= 1 && roll < 0.09) {
          r.out = true;
          r.el.classList.add('out');
        } else if (roll < 0.74) {
          r.pos++;
          if (r.pos >= LAST) finish(r);
        }
      }
      racers.forEach((r) => place(r, r === me || Math.random() < 0.9));
      refresh();
      status.textContent = me.place ? '' : `Level won on the first try: you hop to pad ${me.pos + 1}, ${ord(rank())} in the race.`;
      if (me.place) setTimeout(() => show(me.place <= 3 ? 'trophy' : 'gift'), reduce ? 0 : 650);
    };
    const reset = () => {
      over = false;
      finished = 0;
      for (const r of racers) {
        r.pos = -1;
        r.out = false;
        r.place = 0;
        r.el.classList.remove('out', 'hop');
        place(r, false);
      }
      result.hidden = true;
      winBtn.hidden = failBtn.hidden = false;
      againBtn.hidden = true;
      refresh();
      status.textContent = 'Five racers on the dock. You wear the crown.';
    };

    // It races by itself while on screen; a press takes over, and it starts again after a quiet spell.
    let touched = 0;
    let loop = 0;
    const take = () => { touched = Date.now(); };
    winBtn.addEventListener('click', () => { take(); turn(true); });
    failBtn.addEventListener('click', () => { take(); turn(false); });
    againBtn.addEventListener('click', () => { take(); reset(); });
    reset();
    if (!reduce) {
      (async () => {
        for (;;) {
          await sleep(1250);
          if (!race.hasAttribute('data-live') || document.hidden || Date.now() - touched < 12000) continue;
          if (over) {
            await sleep(2600);
            if (Date.now() - touched < 12000) continue;
            reset();
            loop++;
            continue;
          }
          // every third race shows the other ending
          turn(!(loop % 3 === 2 && me.pos === 4));
        }
      })();
    }
  }

  // ---------- The layers: apart and together ----------
  const stack = document.querySelector<HTMLElement>('[data-stack]');
  if (stack) {
    const toggle = stack.querySelector<HTMLButtonElement>('[data-toggle]')!;
    let apart = true;
    let touched = 0;
    const set = (v: boolean) => {
      apart = v;
      stack.classList.toggle('apart', v);
      toggle.textContent = v ? 'Put it together' : 'Take it apart';
      toggle.setAttribute('aria-pressed', String(v));
    };
    const pick = (i: number | null) => {
      stack.querySelectorAll<HTMLElement>('[data-layer]').forEach((l) => l.classList.toggle('lift', l.dataset.layer === String(i)));
      stack.querySelectorAll<HTMLElement>('[data-legend]').forEach((l) => l.classList.toggle('on', l.dataset.legend === String(i)));
      stack.classList.toggle('picking', i !== null);
    };
    set(true);
    toggle.addEventListener('click', () => { touched = Date.now(); set(!apart); });
    stack.querySelectorAll<HTMLButtonElement>('[data-pick]').forEach((b) => {
      const i = Number(b.dataset.pick);
      b.addEventListener('pointerenter', () => { touched = Date.now(); if (!apart) set(true); pick(i); });
      b.addEventListener('focus', () => { touched = Date.now(); if (!apart) set(true); pick(i); });
      b.addEventListener('click', () => { touched = Date.now(); if (!apart) set(true); pick(i); });
    });
    stack.querySelector('.legend')!.addEventListener('pointerleave', () => pick(null));
    if (!reduce) {
      (async () => {
        let k = 0;
        for (;;) {
          await sleep(1700);
          if (!stack.hasAttribute('data-live') || document.hidden || Date.now() - touched < 9000) continue;
          // walk through the layers one by one, then put the board back together
          if (k < 6) { if (!apart) set(true); pick(k); }
          else if (k === 6) { pick(null); set(false); }
          k = (k + 1) % 8;
        }
      })();
    }
  }
</script>

