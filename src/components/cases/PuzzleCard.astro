---
/** One puzzle card as designed in the Next Games card system, in the prototype's iOS style. */
interface Props {
  title: string;
  sub: string;
  action: 'play' | 'progress' | 'done' | 'clock';
  tag?: string;
  timer?: string;
  progress?: number;
  compact?: boolean;
}
const { title, sub, action, tag, timer, progress = 0.3, compact = false } = Astro.props;
const C = 2 * Math.PI * 17;
---

<div class:list={['pc', compact && 'compact']}>
  {timer && (
    <span class="pc-timer">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
      {timer}
    </span>
  )}
  <span class="pc-thumb" aria-hidden="true">
    <svg width="30" height="30" viewBox="0 0 38 38"><rect x="1" y="1" width="36" height="36" rx="7" fill="#f1f7ff" stroke="#bcd8ff" /><path d="M13 1v36M25 1v36M1 13h36M1 25h36" stroke="#9cc6ff" stroke-width="1.4" /><circle cx="7" cy="7" r="2.4" fill="#3a8dff" /><circle cx="19" cy="19" r="2.4" fill="#0b1a30" /><circle cx="31" cy="31" r="2.4" fill="#3a8dff" /></svg>
  </span>
  <span class="pc-text">
    <span class="pc-title">{title}{tag && <span class="pc-tag">{tag}</span>}</span>
    <span class="pc-sub">{sub}</span>
  </span>
  <span class:list={['pc-action', action]} aria-label={{ play: 'Play', progress: 'Continue', done: 'Completed', clock: 'Not available yet' }[action]}>
    {action === 'progress' && (
      <svg class="ring" width="40" height="40" viewBox="0 0 40 40" aria-hidden="true">
        <circle cx="20" cy="20" r="17" fill="none" stroke="#d6e7ff" stroke-width="3" />
        <circle cx="20" cy="20" r="17" fill="none" stroke="#3a8dff" stroke-width="3" stroke-linecap="round" stroke-dasharray={C} stroke-dashoffset={C * (1 - progress)} transform="rotate(-90 20 20)" />
      </svg>
    )}
    {(action === 'play' || action === 'progress') && (
      <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.8v14.4c0 .8.9 1.3 1.6.8l11-7.2c.6-.4.6-1.2 0-1.6l-11-7.2C7.9 3.5 7 4 7 4.8z" /></svg>
    )}
    {action === 'done' && (
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
    )}
    {action === 'clock' && (
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3.2 2" /></svg>
    )}
  </span>
</div>

<style>
  .pc {
    position: relative;
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) 40px;
    align-items: center;
    gap: 12px;
    min-height: 76px;
    padding: 12px 12px 12px 12px;
    border-radius: 18px;
    background: linear-gradient(180deg, #ffffff, #f6faff);
    box-shadow: 0 0 0 1px rgb(11 26 48 / 0.07) inset, 0 8px 20px -14px rgb(31 60 110 / 0.35);
    color: #0b1a30;
    font-family: var(--font-ui);
  }
  .pc.compact {
    grid-template-columns: 36px minmax(0, 1fr) 36px;
    gap: 10px;
    height: 100%;
    padding: 12px 10px;
    border-radius: 16px;
  }
  .compact .pc-thumb {
    width: 36px;
    height: 36px;
    border-radius: 10px;
  }
  .compact .pc-thumb svg {
    width: 24px;
    height: 24px;
  }
  .compact .pc-title {
    font-size: 0.875rem;
  }
  .compact .pc-sub {
    font-size: 0.75rem;
  }
  .compact .pc-action {
    width: 36px;
    height: 36px;
  }
  .compact .pc-action .ring {
    width: 36px;
    height: 36px;
  }
  .pc-thumb {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    background: #fff;
    box-shadow: 0 0 0 1px rgb(11 26 48 / 0.07) inset;
  }
  .pc-text {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .pc-title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px 7px;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  .pc-tag {
    padding: 2px 7px;
    border-radius: 999px;
    background: #e6f1ff;
    color: #1a5fd0;
    font-family: var(--font-ui);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .pc-sub {
    color: #53627a;
    font-size: 0.8125rem;
    line-height: 1.3;
  }
  .pc-timer {
    position: absolute;
    top: -9px;
    right: 12px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 8px;
    border-radius: 999px;
    background: #0b1a30;
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 600;
  }
  .pc-action {
    position: relative;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: grid;
    place-items: center;
  }
  .pc-action.play {
    background: #3a8dff;
    color: #fff;
  }
  .pc-action.progress {
    color: #1a5fd0;
  }
  .pc-action .ring {
    position: absolute;
    inset: 0;
  }
  .pc-action.done {
    background: #34c759;
    color: #fff;
  }
  .pc-action.clock {
    color: #53627a;
  }
</style>
