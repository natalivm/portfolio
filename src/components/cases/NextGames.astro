---
/**
 * Next Games: the design case. Every statement here comes from the project's design file
 * (feature overview, UX drivers, player stories, navigation flow, card states, open questions).
 * The live event is called "Royale" throughout, as in the prototype.
 */
import PuzzleCard, { type CardState } from './PuzzleCard.astro';

const parts = [
  { k: 1, name: 'Game name', eg: 'Sudoku' },
  { k: 2, name: 'Game mode', eg: 'Classic, Daily or a live event' },
  { k: 3, name: 'Difficulty level', eg: 'Hard' },
  { k: 4, name: 'Progression', eg: 'Puzzle 6 of 30' },
  { k: 5, name: 'Timer', eg: 'Time-limited events only' },
];

const stories = [
  { text: 'Easily identify the specific game, mode and difficulty level depicted on a puzzle card.', status: 'review' },
  { text: 'Easily identify if the puzzle card represents a content path that I am already progressing on, or a new path for me to start (chapter, event, etc.).', status: 'review' },
  { text: 'Easily identify if the card represents a puzzle that I am already progressing on, or a new puzzle for me to start (continue or start next).', status: 'review' },
  { text: 'Understand that the puzzles I engage with will always get docked on the Home view (and Frequently Played list) for easy access.', status: 'review' },
  { text: 'Understand related puzzle information presented in the same fashion elsewhere in the game (game selection, home, puzzle header).', status: 'notyet' },
];
const inReview = stories.filter((s) => s.status === 'review').length;

// Card states, as labelled in the design file. null: that state was not drawn.
const stages = ['First time', 'No progress', 'In progress', 'Complete', 'Countdown'];
type Named = CardState & { label: string };
const families: { key: string; name: string; states: (Named | null)[] }[] = [
  {
    key: 'classic',
    name: 'Classic',
    states: [
      { label: 'First-time game engagement', sub: 'Tap to start your journey', action: 'play' },
      { label: 'Without puzzle progress', mode: 'Classic', sub: 'Chapter 1 · Puzzle 15/30', tag: 'Hard', action: 'play' },
      { label: 'Classic with puzzle progress', mode: 'Classic', sub: 'Chapter 1 · Puzzle 15/30', tag: 'Hard', action: 'progress', progress: 0.4 },
      { label: 'Classic complete (exception state)', mode: 'Classic', sub: 'Content completed', action: 'done' },
      null,
    ],
  },
  {
    key: 'daily',
    name: 'Daily',
    states: [
      null,
      { label: 'Daily puzzle', mode: 'Daily', sub: 'November 24, 2023', action: 'play' },
      { label: 'Daily with puzzle progress', mode: 'Daily', sub: 'November 24, 2023', action: 'progress', progress: 0.4 },
      { label: 'Daily puzzle complete', mode: 'Daily', sub: 'November 24, 2023', action: 'done' },
      { label: 'Daily countdown card', mode: 'Daily', sub: 'Next in 23h 30m', action: 'clock' },
    ],
  },
  {
    key: 'live',
    name: 'Live event',
    states: [
      { label: 'Live event, first-time engagement', mode: 'Royale', sub: 'Tap to start your event', timer: '7h 45m', action: 'play' },
      { label: 'Live event', mode: 'Royale', sub: 'Puzzle 6/30', timer: '7h 45m', action: 'play' },
      { label: 'Live event with puzzle progress', mode: 'Royale', sub: 'Puzzle 6/30', timer: '7h 45m', action: 'progress', progress: 0.4 },
      { label: 'Live event card complete', mode: 'Royale', sub: 'Event completed', timer: '7h 45m', action: 'done' },
      { label: 'Live event card countdown', mode: 'Royale', sub: 'Starts in 9h 36m', timer: '7h 45m', action: 'clock' },
    ],
  },
];
const drawn = families.flatMap((f) => f.states).filter(Boolean).length;
const first = families[0].states[0]!;

// UX drivers. `cycle` states animate the small card beside the text.
const homeCard: CardState = { mode: 'Classic', sub: 'Chapter 1 · Puzzle 6/30', tag: 'Hard', action: 'play', bar: true, progress: 0.2 };
const contexts = [
  { ...homeCard, label: 'On Home' },
  { mode: 'Daily', sub: 'November 24, 2023', action: 'progress', progress: 0.4, label: 'In game selection' },
  { mode: 'Daily', sub: 'November 24, 2023', action: 'done', label: 'On the puzzle end screen' },
];
const loads = [
  { sub: 'Tap to start your journey', action: 'play', label: 'First time: the name and one prompt', meter: 1 },
  { ...homeCard, label: 'In progress: name, mode, difficulty, progression', meter: 4 },
];

// The Home sheet, to scale from the 393 x 852 frame.
const K = 300 / 852;
const px = (v: number) => `${(v * K).toFixed(1)}px`;
const sheets = [
  { n: 1, top: 589, title: '1 game', note: 'Stays a single card. No handle, nothing to open.' },
  { n: 2, top: 524, title: '2 games', note: 'Opens just tall enough for both.' },
  { n: 4, top: 336, title: '4 games', note: 'One more row for each game.' },
  { n: 5, top: 242, title: '5 games', note: 'The height drawn in the design file.' },
];

const questions = [
  { q: 'How does the expanded list look when the player has only one game? Do we show the expand at all?', a: 'One game stays a single card, with no handle.', done: true },
  { q: 'With only two games? Four? All of them?', a: 'The sheet opens just tall enough for its rows.', done: true },
  { q: 'Can players delete a puzzle themselves?', a: 'Yes: swipe a game left to remove it.', done: true },
  { q: 'If you have tried a game but did not complete a puzzle, do we add it to the list?', a: 'The flow docks a game on finishing a level; a game left mid-puzzle is undecided.', done: false },
  { q: 'If you played a game actively but have not started a session for the past X days, do we still suggest it?', a: '', done: false },
  { q: 'Will a game expire from the list?', a: '', done: false },
  { q: 'Will there be a maximum of five games at a time?', a: 'The prototype shows five.', done: false },
];
---

<article class="wrap case">
  <!-- 1. Overview -->
  <section class="sec">
    <div class="sec-head">
      <h2>What a puzzle card is</h2>
      <div>
        <p>
          A puzzle card is the UI element that tells the player about one puzzle: which game it is, its mode
          and difficulty, how far along they are and, for time-limited events, how long is left.
        </p>
        <p>
          To keep cognitive load down, what the card shows depends on where it appears: only what the player
          needs at that point. Wherever it can, it keeps the same format, so the information is easy to
          recognise and to digest.
        </p>
      </div>
    </div>
    <figure class="fig" data-fig data-anatomy>
      <div class="tile">
        <div class="frame ana">
          <div class="ana-card">
            <PuzzleCard size="lg" marks mode="Royale" tag="Hard" sub="Puzzle 6/30" timer="7h 45m" action="play" bar progress={0.2} />
          </div>
          <ol class="ana-list">
            {parts.map((p) => (
              <li>
                <button type="button" data-k={p.k}>
                  <span class="num">{p.k}</span>
                  <span class="what"><b>{p.name}</b><span>{p.eg}</span></span>
                </button>
              </li>
            ))}
            <li class="tbd">
              <span class="num">?</span>
              <span class="what"><b>Pinning a game as a favourite</b><span>To be decided</span></span>
            </li>
          </ol>
        </div>
      </div>
      <figcaption>
        The five pieces of information a puzzle card can carry. This card is a composite: no single state
        shows all five at once.
      </figcaption>
    </figure>
  </section>

  <!-- 2. Player stories -->
  <section class="sec">
    <div class="sec-head">
      <h2>What the card has to do for a player</h2>
      <div>
        <p>Five player stories framed the work. Each is shown with its status as it stood in the design file.</p>
      </div>
    </div>
    <div class="tile stories-tile">
      <div class="stories-top">
        <p class="stories-lead">As a player, I want to…</p>
        <div class="tally" role="img" aria-label={`${inReview} of ${stories.length} stories in review, ${stories.length - inReview} not yet started`}>
          <span class="tally-bar" aria-hidden="true">{stories.map((s) => <i data-s={s.status} />)}</span>
          <span aria-hidden="true">{inReview} in review · {stories.length - inReview} not yet</span>
        </div>
      </div>
      <ol class="stories">
        {stories.map((s) => (
          <li>
            <p>{s.text}</p>
            <span class="status" data-s={s.status}><i aria-hidden="true" />{s.status === 'review' ? 'In review' : 'Not yet'}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 3. UX drivers -->
  <section class="sec">
    <div class="sec-head">
      <h2>Five UX drivers</h2>
      <div>
        <p>The principles the card was designed against, each shown on the card itself.</p>
      </div>
    </div>
    <ol class="drivers">
      <li data-fig>
        <h3>Clear information display</h3>
        <p>Present the essential puzzle details: name, mode, difficulty level, progression, and the timer for time-limited events.</p>
        <div class="mini d-all"><PuzzleCard size="sm" {...homeCard} /></div>
      </li>
      <li data-fig>
        <h3>Contextual relevance</h3>
        <p>Tailor what the card says to where the player meets it, so they get the most pertinent details at that point in the game.</p>
        <div class="mini" data-cycle={JSON.stringify(contexts)}>
          <span class="mini-label" data-cycle-label>{contexts[0].label}</span>
          <PuzzleCard size="sm" {...contexts[0]} />
        </div>
      </li>
      <li data-fig>
        <h3>Cognitive load management</h3>
        <p>Balance the amount and complexity of information so players are not overwhelmed and can take in the puzzle details easily.</p>
        <div class="mini" data-cycle={JSON.stringify(loads)}>
          <PuzzleCard size="sm" sub={loads[0].sub} />
          <span class="meter">
            <span class="meter-dots" data-cycle-meter data-on={loads[0].meter} aria-hidden="true"><i /><i /><i /><i /><i /></span>
            <span data-cycle-label>{loads[0].label}</span>
          </span>
        </div>
      </li>
      <li data-fig>
        <h3>Consistent information format</h3>
        <p>Keep one presentation of puzzle information across the game, to aid recognition and comprehension.</p>
        <div class="mini d-same">
          <PuzzleCard size="sm" mode="Classic" sub="Chapter 1 · Puzzle 15/30" action="progress" progress={0.4} />
          <PuzzleCard size="sm" mode="Daily" sub="November 24, 2023" action="done" />
        </div>
      </li>
      <li data-fig>
        <h3>Customisation options</h3>
        <p>Give players more control over their games, such as pinning one as a favourite.</p>
        <div class="mini d-pin">
          <span class="mini-label">To be decided</span>
          <div class="pin-wrap">
            <PuzzleCard size="sm" mode="Classic" sub="Chapter 1 · Puzzle 15/30" />
            <span class="pin" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4l-5.9 3.1 1.2-6.5L2.5 9.4l6.6-.9z" /></svg>
            </span>
          </div>
        </div>
      </li>
    </ol>
  </section>

  <!-- 4. Navigation flow -->
  <section class="sec">
    <div class="sec-head">
      <h2>Where the card travels</h2>
      <div>
        <p>
          A player picks a game, then a mode and difficulty, and plays. On finishing a level, the game they
          played docks to Home, where its card waits for next time.
        </p>
      </div>
    </div>
    <figure class="fig" data-fig>
      <div class="tile">
        <div class="flow-scroll" tabindex="0" role="group" aria-label="Navigation flow: Home page, game selection, game preselection, game screen, puzzle end screen, then the card docks to Home">
          <div class="flow" data-flow>
            <div class="node" data-n="0">
              <span aria-hidden="true" class="ph ph-home"><i /><i /><i /><b /><u /></span>
              <span class="node-name">Home page</span>
            </div>
            <div class="link both" data-l="0"><span class="line"><i /></span></div>
            <div class="node" data-n="1">
              <span aria-hidden="true" class="ph ph-select"><i /><i /><i /><i /><u /></span>
              <span class="node-name">Game selection</span>
            </div>
            <div class="link" data-l="1"><span class="go">Select game</span><span class="line" /><span class="back">Back</span></div>
            <div class="node" data-n="2">
              <span aria-hidden="true" class="ph ph-pre"><i /><b /><b /><b /></span>
              <span class="node-name">Game preselection</span>
            </div>
            <div class="link" data-l="2"><span class="go">Select mode and difficulty</span><span class="line" /><span class="back">Back</span></div>
            <div class="node" data-n="3">
              <span aria-hidden="true" class="ph ph-game"><i /><em /></span>
              <span class="node-name">Game screen</span>
            </div>
            <div class="link" data-l="3"><span class="go">Solve</span><span class="line" /></div>
            <div class="node" data-n="4">
              <span aria-hidden="true" class="ph ph-end"><i /><i /><b /><i /><i /></span>
              <span class="node-name">Puzzle end screen</span>
            </div>
            <div class="loop"><span class="loop-line" /><span class="loop-fill" /><span class="loop-name">Dock the card to Home</span></div>
          </div>
        </div>
      </div>
      <figcaption>The blue block is the puzzle card. It appears on three screens and returns to Home.</figcaption>
    </figure>
  </section>

  <!-- 5. Card states -->
  <section class="sec">
    <div class="sec-head">
      <h2>{drawn} states of one card</h2>
      <div>
        <p>
          The same card serves three kinds of content: classic chapters, the daily puzzle and live events.
          Each moves through up to five states, and the action on the right changes with it: play, play with
          puzzle progress, complete, or a countdown to what comes next.
        </p>
        <p>
          The whole card works as a play button, something to be validated in testing. Its design follows the
          card on the pre-game selection screen.
        </p>
      </div>
    </div>

    <figure class="fig" data-fig>
      <div class="tile">
        <div class="frame player" data-player={JSON.stringify(families)}>
          <div class="player-stage">
            <PuzzleCard size="lg" {...first} />
            <p class="player-name" data-player-name aria-live="polite">{first.label}</p>
          </div>
          <div class="player-ctl">
            <div class="fam" role="group" aria-label="Kind of content">
              {families.map((f, n) => <button type="button" data-fam={n} aria-pressed={n === 0 ? 'true' : 'false'}>{f.name}</button>)}
            </div>
            <ol class="steps">
              {stages.map((s, n) => (
                <li>
                  <button type="button" data-stage={n} aria-pressed={n === 0 ? 'true' : 'false'} disabled={!families[0].states[n]}>
                    <i aria-hidden="true" />{s}
                  </button>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
      <figcaption>The card plays through its states on its own. Choose a kind of content or a state to step through by hand.</figcaption>
    </figure>

    <figure class="fig" data-fig>
      <div class="tile">
        <div class="matrix-scroll" tabindex="0" role="group" aria-label="All card states, scrolls sideways on small screens">
          <table class="matrix">
            <thead>
              <tr>{stages.map((s) => <th scope="col">{s}</th>)}</tr>
            </thead>
            {families.map((f) => (
              <tbody>
                <tr><th class="fam-name" colspan={stages.length} scope="rowgroup">{f.name}</th></tr>
                <tr>
                  {f.states.map((s) => (
                    <td>
                      {s ? (
                        <PuzzleCard size="sm" class="pc-bare" {...s} />
                      ) : (
                        <span class="none"><span class="visually-hidden">Not drawn</span></span>
                      )}
                    </td>
                  ))}
                </tr>
              </tbody>
            ))}
          </table>
        </div>
      </div>
      <figcaption>
        Every state in the file. Classic has no countdown and the daily puzzle has no first-time card; a
        completed classic chapter is an exception state.
      </figcaption>
    </figure>

    <div class="notes">
      <div>
        <h3>Keep consistent</h3>
        <ul>
          <li>The hierarchy of information on the cards</li>
          <li>The visuals through the game</li>
          <li>How game-mode icons are presented across screens</li>
        </ul>
      </div>
      <div>
        <h3>Left open</h3>
        <ul>
          <li>The card’s size can change slightly with artistic needs</li>
          <li>The size of the game-mode icon is up for exploration</li>
          <li>Whether the whole card as a play button holds up in testing</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 6. The card on Home -->
  <section class="sec">
    <div class="sec-head">
      <h2>The card on Home</h2>
      <div>
        <p>
          On Home, the card for the last game waits above the tab bar. Pulling it up opens the recent games
          list, and the tab bar gives way to Find more games. The prototype at the top of this page is built
          to these measurements.
        </p>
      </div>
    </div>
    <figure class="fig" data-fig>
      <div class="tile">
        <div class="frame heights">
          {sheets.map((s, n) => (
            <div class="h-item">
              <div
                class:list={['h-phone', { still: s.n === 1 }]}
                style={`--rest:${px(589)}; --open:${px(s.top)}; --lift:${px(88 + 28)}; --bar:${px(88)}; --delay:${n * 90}ms`}
              >
                <span class="h-sheet">
                  {Array.from({ length: s.n }).map((_, i) => (
                    <i style={`top:${px(49 + i * 94)}; height:${px(86)}; left:${px(22)}; right:${px(22)}`} />
                  ))}
                </span>
                <span class="h-bar" />
                {s.n > 1 && <span class="h-mark">y {s.top}</span>}
              </div>
              <p><b>{s.title}</b>{s.note}</p>
            </div>
          ))}
        </div>
      </div>
      <figcaption>
        Drawn to scale from a 393 × 852 screen. The file specifies the resting card (top edge at y 589) and
        the five-game list (y 242); two and four games use the same row size.
      </figcaption>
    </figure>
  </section>

  <!-- 7. Questions -->
  <section class="sec">
    <div class="sec-head">
      <h2>Questions the design had to answer</h2>
      <div>
        <p>
          The file ends on a list of questions and rules. The prototype answers three of them; the rest are
          still open.
        </p>
      </div>
    </div>
    <ul class="ledger" role="list">
      {questions.map((x) => (
        <li data-done={x.done ? '' : undefined}>
          <p class="q">{x.q}</p>
          <p class="a">
            <span class="chip">{x.done ? 'Prototyped' : 'Open'}</span>
            {x.a}
          </p>
        </li>
      ))}
    </ul>
  </section>
</article>

<script>
  type St = { mode?: string; game?: string; sub?: string; tag?: string; action?: string; timer?: string; progress?: number; bar?: boolean; label?: string; meter?: number };
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const EASE = 'cubic-bezier(0.16, 1, 0.3, 1)';
  const $$ = <T extends HTMLElement>(sel: string, root: ParentNode = document) => [...root.querySelectorAll<T>(sel)];

  // Figures animate only while they are on screen.
  const io = new IntersectionObserver((es) => es.forEach((e) => e.target.toggleAttribute('data-live', e.isIntersecting)), { threshold: 0.15 });
  $$('[data-fig]').forEach((f) => io.observe(f));
  const live = (el: Element) => !reduce && !document.hidden && !!el.closest('[data-live]');

  function swap(el: HTMLElement | null, text = '') {
    if (!el || el.textContent === text) return;
    el.textContent = text;
    if (!reduce) el.animate([{ opacity: 0, transform: 'translateY(4px)' }, { opacity: 1, transform: 'none' }], { duration: 360, easing: EASE });
  }
  // Move a puzzle card to another state: text swaps, CSS morphs the action.
  function applyCard(card: HTMLElement, s: St) {
    swap(card.querySelector('.pc-mode'), s.mode ?? '');
    swap(card.querySelector('.pc-game'), s.game ?? 'Sudoku');
    swap(card.querySelector('.pc-sub'), s.sub ?? '');
    const tag = card.querySelector<HTMLElement>('.pc-tag')!;
    tag.textContent = s.tag ?? '';
    tag.hidden = !s.tag;
    const timer = card.querySelector<HTMLElement>('.pc-timer')!;
    if (s.timer) card.querySelector('.pc-timer-t')!.textContent = s.timer;
    timer.hidden = !s.timer;
    card.dataset.action = s.action ?? 'play';
    card.toggleAttribute('data-bar', !!s.bar);
    card.style.setProperty('--prog', String(s.progress ?? 0));
  }

  // Small cards beside the UX drivers: step through a few states.
  $$('[data-cycle]').forEach((box) => {
    const states: St[] = JSON.parse(box.dataset.cycle!);
    const card = box.querySelector<HTMLElement>('.pc')!;
    let i = 0;
    setInterval(() => {
      if (!live(box)) return;
      i = (i + 1) % states.length;
      applyCard(card, states[i]);
      swap(box.querySelector('[data-cycle-label]'), states[i].label);
      const meter = box.querySelector<HTMLElement>('[data-cycle-meter]');
      if (meter) meter.dataset.on = String(states[i].meter);
    }, 2600);
  });

  // Anatomy: one part lit at a time; choosing one holds it.
  $$('[data-anatomy]').forEach((fig) => {
    const buttons = $$<HTMLButtonElement>('.ana-list button', fig);
    let i = 0, hold = 0;
    const show = (k: number) => {
      i = k;
      $$('.pc [data-k]', fig).forEach((p) => p.classList.toggle('on', p.dataset.k === String(k)));
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.k === String(k))));
    };
    buttons.forEach((b) => {
      const pick = () => { hold = Date.now() + 9000; show(Number(b.dataset.k)); };
      b.addEventListener('click', pick);
      b.addEventListener('pointerenter', pick);
      b.addEventListener('focus', pick);
    });
    show(1);
    setInterval(() => { if (live(fig) && Date.now() > hold) show((i % buttons.length) + 1); }, 2200);
  });

  // Navigation flow: the journey lights up one screen at a time, then the card docks.
  $$('[data-flow]').forEach((flow) => {
    const nodes = $$('.node', flow), links = $$('.link', flow), loop = flow.querySelector<HTMLElement>('.loop')!;
    let step = 0, wait = 0;
    const paint = () => {
      nodes.forEach((n, k) => n.classList.toggle('on', step < 5 ? k === step : k === 0));
      links.forEach((l, k) => l.classList.toggle('on', k < step));
      loop.classList.toggle('on', step >= 5);
      nodes[0].classList.toggle('docked', step >= 6);
    };
    if (reduce) { step = 6; paint(); return; }
    paint();
    setInterval(() => {
      if (!live(flow)) return;
      if (wait > 0) { wait--; return; }
      step = step >= 6 ? 0 : step + 1;
      if (step === 5) wait = 1;   // the dock line takes two beats to draw
      if (step === 6) wait = 2;   // rest on Home with the card docked
      paint();
    }, 1100);
  });

  // Card states: plays each kind of content through its states.
  $$('[data-player]').forEach((box) => {
    const fams: { states: (St | null)[] }[] = JSON.parse(box.dataset.player!);
    const card = box.querySelector<HTMLElement>('.pc')!;
    const famBtns = $$<HTMLButtonElement>('[data-fam]', box), stageBtns = $$<HTMLButtonElement>('[data-stage]', box);
    let f = 0, s = 0, hold = 0;
    const show = (nf: number, ns: number) => {
      f = nf; s = ns;
      const st = fams[f].states[s]!;
      applyCard(card, st);
      swap(box.querySelector('[data-player-name]'), st.label);
      famBtns.forEach((b, k) => b.setAttribute('aria-pressed', String(k === f)));
      stageBtns.forEach((b, k) => { b.disabled = !fams[f].states[k]; b.setAttribute('aria-pressed', String(k === s)); });
    };
    const firstOf = (nf: number) => fams[nf].states.findIndex(Boolean);
    const next = () => {
      const later = fams[f].states.findIndex((x, k) => k > s && x);
      if (later > -1) show(f, later);
      else { const nf = (f + 1) % fams.length; show(nf, firstOf(nf)); }
    };
    famBtns.forEach((b, k) => b.addEventListener('click', () => { hold = Date.now() + 10000; show(k, fams[k].states[s] ? s : firstOf(k)); }));
    stageBtns.forEach((b, k) => b.addEventListener('click', () => { hold = Date.now() + 10000; show(f, k); }));
    setInterval(() => { if (live(box) && Date.now() > hold) next(); }, 2400);
  });
</script>

