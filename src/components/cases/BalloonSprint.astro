---
/**
 * Balloon Sprint, a timed event in Sort Journey (Bluetile Games). The game's own art, exported from
 * the feature's Figma file. Kept lean: the sprint itself, playable; the screens that carry the story;
 * the event on Home; and the rules it was drawn to.
 */
import type { Project } from '../../data/projects';

interface Props {
  project: Project;
}
const { project: p } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const art = (name: string) => `${base}/cases/balloon-sprint/${name}.webp`;

const rules = [
  { name: 'Get matched', text: 'Five players, one hot-air balloon each, on a timer.' },
  { name: 'Beat levels to rise', text: 'Every level you beat lifts your balloon one step up its lane.' },
  { name: 'First three over the line', text: 'Gold, silver and purple chests for the first three to reach the finish.' },
];

// five lanes: you first, in the striped balloon
const RACERS = [
  { id: 'you', balloon: 'striped', name: 'You' },
  { id: 'p1', balloon: 'green', avatar: 'player-1', name: 'Player 1' },
  { id: 'p2', balloon: 'pink', avatar: 'player-2', name: 'Player 2' },
  { id: 'p3', balloon: 'yellow', avatar: 'player-3', name: 'Player 3' },
  { id: 'p4', balloon: 'purple', avatar: 'player-4', name: 'Player 4' },
];
const LEVELS = 10;

const screens = [
  { img: 'popup-started', h: 'It starts', t: 'One popup: the timer, the goal and a balloon.', alt: 'Popup: Balloon Sprint started, beat levels before others to win amazing rewards, with two hot-air balloons' },
  { img: 'info', h: 'How it works', t: 'Matched against opponents, a balloon that rises with every level, three chests at the finish.', alt: 'Balloon Sprint rules: get matched against opponents, beat levels to make your balloon progress, reach the finish line first' },
  { img: 'event-3', h: 'The race', t: 'Five lanes, a count over every balloon. Player 1 has already taken gold.', alt: 'Balloon Sprint board mid-race: Player 1 has finished first, the player has beaten one level' },
  { img: 'event-4', h: 'You came second', t: 'Your balloon over the line with its medal, and a claim button in the medal’s colour.', alt: 'Balloon Sprint result: congratulations, you arrived 2nd in the Sprint, with a claim button' },
];

const homeStates = [
  { img: 'icon-1', label: 'Racing, 1st' },
  { img: 'icon-2', label: 'Won: gold' },
  { img: 'icon-3', label: '2nd: silver' },
  { img: 'icon-4', label: '3rd: purple' },
  { img: 'icon-5', label: 'Finished 4th' },
];

const principles = [
  { h: 'Read the race in one look', t: 'Five lanes side by side, a number over every balloon, the finish line across the top. Who is winning needs no explaining.' },
  { h: 'The prize is the horizon', t: 'The three chests sit on the meadow at the top of the screen, right where the balloons are heading.' },
  { h: 'Colour is identity', t: 'Each player owns a balloon colour; yours is the striped one, in the lane on the left, with a green card.' },
  { h: 'Always visible, never in the way', t: 'On Home the race is one icon with your place on it; at every level start, a strip of everyone’s progress.' },
];

const clouds = [
  { s: 'l', t: 8, o: 24, w: 110, f: true }, { s: 'r', t: 20, o: 14, w: 160, f: false },
  { s: 'l', t: 33, o: 8, w: 140, f: false }, { s: 'r', t: 46, o: 22, w: 115, f: true },
  { s: 'l', t: 58, o: 18, w: 125, f: true }, { s: 'r', t: 70, o: 8, w: 150, f: false },
  { s: 'l', t: 83, o: 12, w: 145, f: false }, { s: 'r', t: 94, o: 20, w: 110, f: true },
];
---

<article class="wrap case">
  <div class="bs-clouds" aria-hidden="true">
    {clouds.map((c) => (
      <img class={c.s} src={art('cloud')} width="760" height="409" alt="" loading="lazy" decoding="async" style={`--t:${c.t}%;--o:${c.o}px;--w:${c.w}px${c.f ? ';scale:-1 1' : ''}`} />
    ))}
  </div>

  <section class="sec">
    <div class="sec-head" data-fig>
      <h2 class="ribbon"><span>Balloon Sprint</span></h2>
      <div>
        <p>
          Balloon Sprint is a timed event in Sort Journey, a puzzle game by Bluetile Games. Five players race
          hot-air balloons up the sky: every level beaten lifts yours a step, and the first three over the
          finish line win a chest.
        </p>
        <p>The work covered the event’s art, its screens and popups, and how it shows on Home and at every level start.</p>
        {p.link && (
          <p class="out">
            <a class="pill pill-light" href={p.link.href} target="_blank" rel="noopener">{p.link.label}</a>
          </p>
        )}
      </div>
    </div>
    <ol class="structure" role="list">
      {rules.map((s, i) => (
        <li>
          <span class="step" aria-hidden="true">{i + 1}</span>
          <h3>{s.name}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="sec">
    <div class="sec-head" data-fig>
      <h2 class="ribbon"><span>Play the sprint</span></h2>
      <div><p>The race board, rebuilt from the game’s art. It races by itself; press the button to take over.</p></div>
    </div>

    <figure class="fig race" data-fig data-sprint data-levels={LEVELS}>
      <div class="board">
        <img class="b-sky" src={art('sky')} width="720" height="792" alt="" loading="lazy" decoding="async" />
        <img class="b-chest silver" src={art('chest-silver')} width="300" height="246" alt="" loading="lazy" decoding="async" />
        <img class="b-chest purple" src={art('chest-purple')} width="300" height="255" alt="" loading="lazy" decoding="async" />
        <img class="b-chest gold" src={art('chest-gold')} width="360" height="292" alt="" loading="lazy" decoding="async" />
        <div class="lanes" aria-hidden="true">{RACERS.map(() => <i />)}</div>
        <img class="b-line" src={art('checker')} width="720" height="33" alt="" loading="lazy" decoding="async" />
        {RACERS.map((r, i) => (
          <div class="balloon" data-racer={r.id} style={`--lane:${i};--p:0`}>
            <span class="count" data-count>0</span>
            <img src={art(`balloon-${r.balloon}`)} width="172" height="240" alt="" loading="lazy" decoding="async" />
            <span class="medal" data-medal hidden></span>
          </div>
        ))}
        {RACERS.map((r, i) => (
          <div class:list={['card', r.id === 'you' && 'me']} style={`--lane:${i}`}>
            <img src={art(r.avatar ?? 'corgi')} width="170" height="209" alt="" loading="lazy" decoding="async" />
            <span>{r.name}</span>
          </div>
        ))}
        <img class="b-cloud" src={art('cloud')} width="760" height="409" alt="" loading="lazy" decoding="async" />
        <canvas class="wave" aria-hidden="true" data-wave hidden></canvas>
        <div class="result" data-result hidden>
          <div class="result-card">
            <img data-result-img src={art('chest-gold')} width="360" height="292" alt="" />
            <p class="r-title" data-result-title>Congratulations!</p>
            <p class="r-sub" data-result-sub>You arrived 1st in the Sprint!</p>
          </div>
        </div>
      </div>

      <div class="race-side">
        <ol class="race-steps" role="list">
          <li><span class="step" aria-hidden="true">1</span>Beat a level: your balloon rises a step.</li>
          <li><span class="step" aria-hidden="true">2</span>The others play too, at their own pace.</li>
          <li><span class="step" aria-hidden="true">3</span>Ten levels to the line. Three chests to win.</li>
        </ol>
        <div class="race-ctl">
          <button class="g-btn" type="button" data-win>Level <span data-next>1</span></button>
          <button class="g-btn" type="button" data-again hidden>Race again</button>
        </div>
        <p class="race-status" aria-live="polite" data-status>Five balloons at the start. Yours is the striped one.</p>
      </div>
    </figure>
  </section>

  <section class="sec">
    <div class="sec-head" data-fig>
      <h2>The event</h2>
      <div><p>Four screens carry it from the first popup to the prize.</p></div>
    </div>
    <ol class="phones" role="list" data-fig>
      {screens.map((sc, i) => (
        <li class="rise" style={`--k:${i}`}>
          <img src={art(sc.img)} width="560" height="1197" alt={sc.alt} loading="lazy" decoding="async" />
          <h3>{sc.h}</h3>
          <p>{sc.t}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="sec">
    <div class="sec-head" data-fig>
      <h2 class="ribbon"><span>Around the game</span></h2>
      <div><p>Between levels the sprint stays one tap away: an icon on Home that carries your place, then your chest.</p></div>
    </div>
    <div class="around" data-fig>
      <ol class="icons" role="list">
        {homeStates.map((h, i) => (
          <li class="rise" style={`--k:${i}`}>
            <img src={art(h.img)} width="200" height="188" alt={`Home icon: ${h.label}`} loading="lazy" decoding="async" />
            <span>{h.label}</span>
          </li>
        ))}
      </ol>
      <div class="level">
        <img class="rise" style="--k:3" src={art('level-start')} width="560" height="1214" alt="Level start popup with a Balloon Sprint strip at the bottom showing every player’s progress, 6 of 10 for you" loading="lazy" decoding="async" />
        <div>
          <h3>At every level start</h3>
          <p>A strip under the level popup shows every player’s count, so you know what this level is worth before you press Play.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="sec-head" data-fig>
      <h2 class="ribbon"><span>Art direction</span></h2>
      <div><p>The rules the sprint was drawn to.</p></div>
    </div>
    <ol class="principles" role="list">
      {principles.map((n, i) => (
        <li>
          <span class="step" aria-hidden="true">{i + 1}</span>
          <h3>{n.h}</h3>
          <p>{n.t}</p>
        </li>
      ))}
    </ol>
  </section>
</article>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

  const io = new IntersectionObserver((es) => es.forEach((e) => {
    e.target.toggleAttribute('data-live', e.isIntersecting);
    if (e.isIntersecting) e.target.classList.add('seen');
  }), { threshold: 0.2 });
  document.querySelectorAll('[data-fig]').forEach((f) => {
    if (reduce) f.classList.add('seen');
    else f.setAttribute('data-armed', '');
    io.observe(f);
  });

  // ---------- The sprint ----------
  const race = document.querySelector<HTMLElement>('[data-sprint]');
  if (race) {
    const LEVELS = Number(race.dataset.levels);
    const $ = (s: string) => race.querySelector<HTMLElement>(s)!;
    type R = { el: HTMLElement; p: number; place: number; pace: number };
    const racers: R[] = [...race.querySelectorAll<HTMLElement>('.balloon')].map((el) => ({ el, p: 0, place: 0, pace: 0.6 }));
    const me = racers[0];
    const win = $('[data-win]') as HTMLButtonElement;
    const again = $('[data-again]') as HTMLButtonElement;
    const status = $('[data-status]');
    const result = $('[data-result]');
    const resultImg = $('[data-result-img]') as HTMLImageElement;
    const art = (n: string) => resultImg.src.replace(/[^/]+\.webp$/, `${n}.webp`);
    const ord = (n: number) => n + (n === 1 ? 'st' : n === 2 ? 'nd' : n === 3 ? 'rd' : 'th');
    let finished = 0;
    let over = false;

    // ---------- The distortion wave ----------
    // A screen transition: the board is drawn into a picture before and after the change, and a
    // WebGL shader carries one into the other. A wave leaves from the bottom of the board, bends
    // the old picture like a lens as it passes, splits its colours at the front, rings it with a
    // rainbow rim and a white hairline, throws off a few sparks, and leaves colour on the edges.
    // 'out' sends it from the source; 'in' collapses it back into the source.
    const board = race.querySelector<HTMLElement>('.board')!;
    const waveCv = race.querySelector<HTMLCanvasElement>('[data-wave]')!;
    const makeWave = () => {
      const gl = waveCv.getContext('webgl', { premultipliedAlpha: false, alpha: false, preserveDrawingBuffer: false });
      if (!gl || reduce) return null;
      const FRAG = `
        precision highp float;
        uniform sampler2D uIn;   // behind the front (near the source)
        uniform sampler2D uOut;  // ahead of it
        uniform vec2 uRes;
        uniform vec2 uS;         // source, in uv (y down)
        uniform float uR;        // front radius, in board heights
        uniform float uA;        // anticipation: the picture drawn toward the source, a glow gathering
        uniform float uRim;      // colour on the front and edges, 0..1
        uniform float uT;
        const float L = 0.16;    // lens width
        vec3 pal(float t) { return 0.58 + 0.42 * cos(6.28318 * (t + vec3(0.0, 0.33, 0.67))); }
        float hash(float n) { return fract(sin(n * 91.3458) * 47453.5453); }
        void main() {
          vec2 uv = vec2(gl_FragCoord.x / uRes.x, 1.0 - gl_FragCoord.y / uRes.y);
          float asp = uRes.x / uRes.y;
          vec2 k = vec2(asp, 1.0);
          vec2 p = (uv - uS) * k;
          float d = length(p);
          vec2 dir = p / max(d, 1e-4);
          vec2 dirUV = dir / k;

          // anticipation: the old picture is drawn in toward the source
          vec2 uvA = uv - (uv - uS) * uA * 0.07 * exp(-d * 1.4);

          // the lens: content near the front bends along the wave, colours split
          float sgn = d - uR;
          float s = sgn / L;
          float bend = 0.05 * s * exp(-s * s * 1.5);
          float ab = 0.012 * exp(-s * s * 2.0) * uRim;
          vec2 q = uvA - dirUV * bend;
          float inside = smoothstep(0.006, -0.006, sgn);
          vec3 cIn = vec3(texture2D(uIn, q + dirUV * ab).r, texture2D(uIn, q).g, texture2D(uIn, q - dirUV * ab).b);
          vec3 cOut = vec3(texture2D(uOut, q + dirUV * ab).r, texture2D(uOut, q).g, texture2D(uOut, q - dirUV * ab).b);
          vec3 col = mix(cOut, cIn, inside);

          // rainbow rim just behind the front, a white hairline on it
          float ang = atan(p.x, -p.y);
          vec3 rc = pal(ang * 0.35 + d * 1.2 - uT * 0.6);
          float back = max(-sgn, 0.0);
          float rim = exp(-pow(back / 0.06, 2.0)) * inside + exp(-pow(max(sgn, 0.0) / 0.014, 2.0)) * 0.5 * (1.0 - inside);
          col = mix(col, rc, rim * 0.7 * uRim) + rc * rim * 0.18 * uRim;
          col += vec3(1.0) * exp(-pow(sgn / 0.0035, 2.0)) * 0.85 * uRim;

          // colour left on the frame's edges, behind the front, fading as the wave goes on
          float e = min(min(uv.x, 1.0 - uv.x) * asp, min(uv.y, 1.0 - uv.y));
          col += pal(ang * 0.35 + uv.y - uT * 0.4) * exp(-e / 0.016) * inside * exp(-back / 0.55) * smoothstep(0.06, 0.3, d) * 0.6 * uRim;

          // a glow gathering at the source before it leaves
          col += (vec3(1.0, 0.96, 0.9) * 0.7 + rc * 0.3) * uA * exp(-d / 0.09);

          // sparks thrown off the front
          for (int i = 0; i < 34; i++) {
            float fi = float(i);
            float a = (hash(fi) - 0.5) * 3.0;
            float r = uR * (0.9 + 0.18 * hash(fi + 7.1)) + 0.03 * sin(uT * 2.0 + fi);
            vec2 sp = vec2(sin(a), -cos(a)) * r;
            float sz = 0.0025 + 0.004 * hash(fi + 3.3);
            float g = exp(-dot(p - sp, p - sp) / (sz * sz));
            col += mix(vec3(1.0), pal(hash(fi + 1.7)), 0.45) * g * uRim * step(0.02, uR);
          }
          gl_FragColor = vec4(clamp(col, 0.0, 1.0), 1.0);
        }`;
      const sh = (type: number, src: string) => {
        const o = gl.createShader(type)!;
        gl.shaderSource(o, src);
        gl.compileShader(o);
        return o;
      };
      const prog = gl.createProgram()!;
      gl.attachShader(prog, sh(gl.VERTEX_SHADER, 'attribute vec2 a; void main() { gl_Position = vec4(a, 0.0, 1.0); }'));
      gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, FRAG));
      gl.linkProgram(prog);
      if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return null;
      gl.useProgram(prog);
      gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
      const loc = gl.getAttribLocation(prog, 'a');
      gl.enableVertexAttribArray(loc);
      gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
      const U = (n: string) => gl.getUniformLocation(prog, n);
      const tex = (unit: number) => {
        const t = gl.createTexture()!;
        gl.activeTexture(gl.TEXTURE0 + unit);
        gl.bindTexture(gl.TEXTURE_2D, t);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
        return t;
      };
      const tIn = tex(0);
      const tOut = tex(1);
      gl.uniform1i(U('uIn'), 0);
      gl.uniform1i(U('uOut'), 1);
      const upload = (unit: number, t: WebGLTexture, c: HTMLCanvasElement) => {
        gl.activeTexture(gl.TEXTURE0 + unit);
        gl.bindTexture(gl.TEXTURE_2D, t);
        gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, c);
      };

      // the board as a picture: its images, label chips and text, drawn where they sit now
      const snap = () => {
        const B = board.getBoundingClientRect();
        const dpr = Math.min(devicePixelRatio || 1, 2);
        const c = document.createElement('canvas');
        c.width = Math.round(B.width * dpr);
        c.height = Math.round(B.height * dpr);
        const g = c.getContext('2d')!;
        g.scale(dpr, dpr);
        g.fillStyle = '#7fd4f2';
        g.fillRect(0, 0, B.width, B.height);
        const R = (el: Element) => { const r = el.getBoundingClientRect(); return { x: r.left - B.left, y: r.top - B.top, w: r.width, h: r.height }; };
        const rad = (cs: CSSStyleDeclaration, w: number) => { const v = cs.borderTopLeftRadius; return v.endsWith('%') ? (parseFloat(v) / 100) * w : parseFloat(v) || 0; };
        const shown = (el: Element) => !el.closest('[hidden]') && getComputedStyle(el).display !== 'none' && el !== waveCv;
        for (const el of board.querySelectorAll<HTMLElement>('*')) {
          if (!shown(el)) continue;
          const cs = getComputedStyle(el);
          const r = R(el);
          if (!r.w || !r.h) continue;
          if (el.matches('.lanes i')) {
            const even = [...el.parentElement!.children].indexOf(el) % 2 === 1;
            const lg = g.createLinearGradient(0, r.y, 0, r.y + r.h);
            lg.addColorStop(0, even ? '#4dbbe6' : '#5cc7ee');
            lg.addColorStop(0.7, even ? '#8fd9f3' : '#9be1f6');
            lg.addColorStop(1, even ? '#8fd9f3' : '#9be1f6');
            g.fillStyle = lg;
            g.fillRect(r.x, r.y, r.w, r.h);
            g.fillStyle = 'rgb(255 255 255 / 0.7)';
            g.fillRect(r.x + r.w - 2, r.y, 2, r.h);
            continue;
          }
          if (el.matches('.result')) {
            const rg = g.createRadialGradient(r.x + r.w / 2, r.y + r.h * 0.45, 0, r.x + r.w / 2, r.y + r.h * 0.45, Math.max(r.w, r.h) * 0.75);
            rg.addColorStop(0, 'rgb(6 38 63 / 0.35)');
            rg.addColorStop(1, 'rgb(6 38 63 / 0.75)');
            g.fillStyle = rg;
            g.fillRect(r.x, r.y, r.w, r.h);
            continue;
          }
          if (el instanceof HTMLImageElement) {
            if (!el.complete || !el.naturalWidth) continue;
            g.save();
            const rr = rad(cs, r.w);
            if (rr) { g.beginPath(); g.roundRect(r.x, r.y, r.w, r.h, rr); g.clip(); }
            if (el.closest('.card.me')) {
              const lg = g.createLinearGradient(0, r.y, 0, r.y + r.h);
              lg.addColorStop(0, '#7fdc5a');
              lg.addColorStop(1, '#3fae2f');
              g.fillStyle = lg;
              g.fillRect(r.x, r.y, r.w, r.h);
              const pad = parseFloat(cs.paddingLeft) || 0;
              const bw = r.w - pad * 2, bh = r.h - pad;
              const k = Math.min(bw / el.naturalWidth, bh / el.naturalHeight);
              g.drawImage(el, r.x + (r.w - el.naturalWidth * k) / 2, r.y + pad + (bh - el.naturalHeight * k) / 2, el.naturalWidth * k, el.naturalHeight * k);
            } else {
              g.drawImage(el, r.x, r.y, r.w, r.h);
            }
            g.restore();
            continue;
          }
          const text = [...el.childNodes].filter((n) => n.nodeType === 3).map((n) => n.textContent).join('').trim();
          if (!text) continue;
          if (el.matches('.medal')) {
            g.fillStyle = { '1': '#f6b62a', '2': '#c6d0da', '3': '#e07b39' }[el.dataset.place || '1'] || '#f6b62a';
            g.beginPath(); g.arc(r.x + r.w / 2, r.y + r.h / 2, r.w / 2, 0, Math.PI * 2); g.fill();
          } else if (!/rgba?\(0, 0, 0, 0\)|transparent/.test(cs.backgroundColor)) {
            g.fillStyle = cs.backgroundColor;
            g.beginPath(); g.roundRect(r.x, r.y, r.w, r.h, rad(cs, r.w)); g.fill();
          }
          g.fillStyle = cs.color;
          g.font = `${cs.fontStyle} ${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
          g.textAlign = 'center';
          g.textBaseline = 'middle';
          g.fillText(text, r.x + r.w / 2, r.y + r.h / 2, r.w);
        }
        return c;
      };

      const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2);
      const clamp01 = (t: number) => Math.min(1, Math.max(0, t));
      return async (dirn: 'out' | 'in', change: () => Promise<void> | void) => {
        board.classList.add('snapping');
        const before = snap();
        const B = board.getBoundingClientRect();
        const dpr = Math.min(devicePixelRatio || 1, 2);
        waveCv.width = before.width;
        waveCv.height = before.height;
        gl.viewport(0, 0, waveCv.width, waveCv.height);
        gl.uniform2f(U('uRes'), waveCv.width, waveCv.height);
        const S = [0.5, 0.985]; // the bottom of the board, where the game's own Level button sits
        gl.uniform2f(U('uS'), S[0], S[1]);
        const far = Math.max(...[[0, 0], [1, 0], [0, 1], [1, 1]].map(([x, y]) => Math.hypot((x - S[0]) * (B.width / B.height), y - S[1])));
        // hold the old picture on screen while the board changes underneath
        upload(0, tIn, before);
        upload(1, tOut, before);
        const frame = (r: number, a: number, rim: number, t: number) => {
          gl.uniform1f(U('uR'), r);
          gl.uniform1f(U('uA'), a);
          gl.uniform1f(U('uRim'), rim);
          gl.uniform1f(U('uT'), t);
          gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
        };
        frame(0, 0, 0, 0);
        waveCv.hidden = false;
        await change();
        void board.offsetWidth;
        const after = snap();
        board.classList.remove('snapping');
        if (dirn === 'out') { upload(0, tIn, after); upload(1, tOut, before); }
        else { upload(0, tIn, before); upload(1, tOut, after); }
        const ANT = dirn === 'out' ? 300 : 120, TRAVEL = dirn === 'out' ? 1050 : 850, END = ANT + TRAVEL + 260;
        const max = far + 0.2;
        await new Promise<void>((done) => {
          let t0 = 0;
          const tick = (now: number) => {
            if (!t0) t0 = now;
            const t = now - t0;
            const pr = ease(clamp01((t - ANT) / TRAVEL));
            const r = dirn === 'out' ? pr * max : (1 - pr) * max;
            const a = dirn === 'out' ? clamp01(t / ANT) * (1 - clamp01((t - ANT) / 300)) : 0;
            const rim = clamp01((t - ANT * 0.5) / 120) * (1 - clamp01((t - ANT - TRAVEL) / 260));
            frame(r, a, rim, t / 1000);
            if (t < END) requestAnimationFrame(tick);
            else done();
          };
          requestAnimationFrame(tick);
        });
        waveCv.hidden = true;
      };
    };
    const wave = makeWave();
    let busy = false;

    const draw = (r: R) => {
      r.el.style.setProperty('--p', String(r.p));
      r.el.querySelector('[data-count]')!.textContent = String(r.p);
      const medal = r.el.querySelector<HTMLElement>('[data-medal]')!;
      medal.hidden = !r.place || r.place > 3;
      medal.textContent = String(r.place);
      medal.dataset.place = String(r.place);
      r.el.classList.toggle('done', r.place > 0);
      if (!reduce) {
        r.el.classList.remove('lift');
        void r.el.offsetWidth;
        r.el.classList.add('lift');
      }
    };
    const fillResult = async (place: number) => {
      if (place && place <= 3) {
        resultImg.src = art(['chest-gold', 'chest-silver', 'chest-purple'][place - 1]);
        $('[data-result-title]').textContent = 'Congratulations!';
        $('[data-result-sub]').textContent = `You arrived ${ord(place)} in the Sprint!`;
        status.textContent = `You crossed the line ${ord(place)} and won the ${['gold', 'silver', 'purple'][place - 1]} chest.`;
      } else {
        resultImg.src = art('balloon-striped');
        $('[data-result-title]').textContent = 'The race is over…';
        $('[data-result-sub]').textContent = 'Better luck next time!';
        status.textContent = 'Three balloons crossed the line before yours. Race again?';
      }
      result.dataset.kind = place && place <= 3 ? 'win' : 'lose';
      await resultImg.decode().catch(() => {});
      result.hidden = false;
    };
    const show = async (place: number) => {
      over = true;
      win.hidden = true;
      if (wave) {
        busy = true;
        result.classList.add('still'); // the wave brings it in; no pop of its own
        await wave('out', () => fillResult(place));
        busy = false;
      } else {
        result.classList.remove('still');
        await fillResult(place);
      }
      again.hidden = false;
    };
    let ending = false; // the race is decided and its result is on the way
    const step = () => {
      if (over || ending) return;
      const movers = [me, ...racers.slice(1).filter((r) => Math.random() < r.pace)];
      for (const r of movers) {
        if (r.place) continue;
        r.p++;
        if (r.p >= LEVELS) r.place = ++finished;
      }
      racers.forEach((r) => movers.includes(r) && draw(r));
      $('[data-next]').textContent = String(Math.min(me.p + 1, LEVELS));
      if (me.place || finished >= 3) {
        ending = true;
        const place = me.place;
        setTimeout(() => show(place), reduce ? 0 : 700);
      }
      else status.textContent = `Level beaten: your balloon is at ${me.p} of ${LEVELS}.`;
    };
    const restart = () => {
      over = false;
      ending = false;
      finished = 0;
      racers.forEach((r, i) => {
        r.p = 0;
        r.place = 0;
        r.pace = i === 0 ? 1 : 0.42 + Math.random() * 0.5; // some opponents are quick
        draw(r);
      });
      result.hidden = true;
      win.hidden = false;
      again.hidden = true;
      $('[data-next]').textContent = '1';
      status.textContent = 'Five balloons at the start. Yours is the striped one.';
    };
    const reset = async () => {
      if (busy) return;
      if (wave && !result.hidden) {
        busy = true;
        again.hidden = true;
        await wave('in', restart);
        busy = false;
      } else {
        restart();
      }
    };

    let touched = 0;
    win.addEventListener('click', () => { touched = Date.now(); if (!busy) step(); });
    again.addEventListener('click', () => { touched = Date.now(); reset(); });
    restart();
    if (!reduce) {
      (async () => {
        for (;;) {
          await sleep(1000);
          if (!race.hasAttribute('data-live') || document.hidden || Date.now() - touched < 12000) continue;
          if (over) {
            await sleep(2600);
            if (Date.now() - touched >= 12000 && !busy) await reset();
            continue;
          }
          if (busy) continue;
          step();
        }
      })();
    }
  }
</script>

